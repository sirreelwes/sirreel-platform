/// What the client chose on the Limited Collision Damage Waiver. Absent
/// means they have not answered — NOT that they declined.
enum LcdwDecision {
  ACCEPTED
  DECLINED
}

model PaperworkRequest {
  id          String    @id @default(uuid())
  bookingId   String    @map("booking_id")
  token       String    @unique @default(uuid()) // unique link token
  sentTo      String    @map("sent_to") // client email
  sentAt      DateTime  @default(now()) @map("sent_at")
  completedAt DateTime? @map("completed_at")

  // Contract type
  contractType String @default("vehicles") @map("contract_type") // vehicles | stage | both

  // Stage details (JSON)
  stageDetails String? @map("stage_details") @db.Text

  // Completion tracking
  coiReceived     Boolean @default(false) @map("coi_received")
  wcReceived      Boolean @default(false) @map("wc_received")
  rentalAgreement Boolean @default(false) @map("rental_agreement")
  /// LEGACY mirror of lcdwDecision — true only when ACCEPTED. Kept because
  /// older read paths still select it; `lcdwDecision` is the source of truth.
  lcdwAccepted    Boolean @default(false) @map("lcdw_accepted")

  // LCDW is a per-vehicle, per-day charge ($24/day) AND a liability waiver,
  // so "declined" and "never asked" are different facts with different money
  // attached. A single Boolean could not tell them apart: both read false,
  // the reservation context reported a firm decline as "pending" forever,
  // and the job page badge said "LCDW not accepted" for a client who was
  // never asked. Worse, /api/portal/[token]/sign wrote `lcdw_accepted=true`
  // unconditionally, discarding the radio button the client actually picked
  // — so a decline was recorded as an acceptance.
  //
  // The decision, when it was made, and the written confirmation the LCDW
  // addendum requires ("Acceptance/decline of LCDW must be confirmed in
  // writing per fleet vehicle rental") — the signature was posted by both
  // portals and thrown away.
  lcdwDecision         LcdwDecision? @map("lcdw_decision")
  lcdwDecidedAt        DateTime?     @map("lcdw_decided_at")
  lcdwSignatureData    String?       @map("lcdw_signature_data") @db.Text
  lcdwFuelAcknowledged Boolean?      @map("lcdw_fuel_acknowledged")
  studioContractSigned Boolean       @default(false) @map("studio_contract_signed")
  creditCardAuth       Boolean       @default(false) @map("credit_card_auth")

  // Workers' Comp certificate — the client's separate WC proof when it
  // isn't carried on the main COI (payroll companies like EP / Cast &
  // Crew issue their own). Stored in the PRIVATE blob store exactly like
  // CoiCheck (never inline base64), viewed by staff through the authed
  // proxy at /api/wc/download/[id].
  //
  // 2026-08-22: these columns did not exist in the live DB. The upload
  // route had been creating them with `ALTER TABLE ... IF NOT EXISTS`
  // inside a swallowed try/catch, which never succeeded — so every
  // client WC upload 500'd after paying for the AI review and nothing
  // was ever stored. Declared here so the column is real and typed.
  wcFileKey          String?   @map("wc_file_key")
  wcFileUrl          String?   @map("wc_file_url")
  wcOriginalFilename String?   @map("wc_original_filename")
  wcMimeType         String?   @map("wc_mime_type")
  wcFileSize         Int?      @map("wc_file_size")
  wcUploadedAt       DateTime? @map("wc_uploaded_at")
  wcAiReview         Json?     @map("wc_ai_review")
  wcReviewAt         DateTime? @map("wc_review_at")

  // CC Auth details
  ccCardholderFirst     String?   @map("cc_cardholder_first")
  ccCardholderLast      String?   @map("cc_cardholder_last")
  ccCardType            String?   @map("cc_card_type")
  ccCardLast4           String?   @map("cc_card_last4")
  ccCardNumberEncrypted String?   @map("cc_card_number_encrypted") @db.Text
  ccChargeEstimate      Decimal?  @map("cc_charge_estimate") @db.Decimal(10, 2)
  ccAuthSignedAt        DateTime? @map("cc_auth_signed_at")
  // Client's stated payment intent captured alongside the card auth.
  // 'CARD' (default) = charge the card on file; 'CHECK_WIRE' = client
  // will pay by check/bank transfer and the card is on file as SECURITY
  // ONLY. The card is authorized/stored either way — this is an intent
  // signal for staff, not a gate. Null = legacy/unspecified (treat as CARD).
  ccPaymentPreference   String?   @map("cc_payment_preference")

  // Result of the $0 stored-credential authorization run when the card is
  // saved. Previously the gateway response was thrown away and only logged
  // on failure, which left two holes: nobody could tell whether a card on
  // file had actually validated, and the Visa/Mastercard stored-credential
  // framework wants later merchant-initiated charges to reference the
  // retref of the transaction that established the credential.
  // MMYY. Not sensitive authentication data (unlike PAN/CVV/track), and
  // required on every auth against the token — without it a merchant-
  // initiated charge on a card on file has no expiry to send and declines.
  ccCardExpiry      String?   @map("cc_card_expiry")
  // Cardholder billing postal code. Once surcharging is enabled on the MID,
  // the CardPointe gateway REQUIRES this on every card-not-present auth: it
  // decides surcharge eligibility from the cardholder's region and waives
  // the fee where state law prohibits it (CT, MA, ...). The portal already
  // collected it and threw it away.
  ccBillingPostal   String?   @map("cc_billing_postal")
  ccAuthRetref      String?   @map("cc_auth_retref")
  ccAuthRespCode    String?   @map("cc_auth_respcode")
  ccAuthRespStat    String?   @map("cc_auth_respstat")
  ccAuthRespText    String?   @map("cc_auth_resptext")
  ccAuthValidatedAt DateTime? @map("cc_auth_validated_at")

  // Signer info
  signerName String? @map("signer_name")

  booking                      Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  coi_ai_review                Json?
  coi_review_at                DateTime? @db.Timestamp(6)
  coi_admin_approved           Boolean?  @default(false)
  coi_admin_approved_by        String?
  coi_admin_approval_note      String?
  coi_admin_approved_at        DateTime? @db.Timestamp(6)
  contract_redline_status      String?
  contract_redline_review      String?
  contract_redline_uploaded_at DateTime? @db.Timestamp(6)
  updated_at                   DateTime  @default(now()) @db.Timestamp(6)

  @@map("paperwork_requests")
}

