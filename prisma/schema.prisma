// =============================================
// BILLING MODULE
// =============================================

// Full lifecycle status — canonical state machine per order-lifecycle-spec
// (Phase 1: Book-it spine). Old CONFIRMED/ACTIVE renamed in-place to
// APPROVED/ON_JOB via `ALTER TYPE … RENAME VALUE` (preserves rows). New
// states added additively. Forward flow:
//   DRAFT → QUOTE_SENT → APPROVED → BOOKED → LOADED_READY → ON_JOB
//        → RETURNED → LD_CHECK → INVOICED → CLOSED
// CANCELLED is the off-ramp; LOADED_READY is rolled up from parallel
// fleet + warehouse lanes (Phase 3, not yet wired).
enum OrderStatus {
  DRAFT
  QUOTE_SENT
  APPROVED
  BOOKED
  LOADED_READY
  ON_JOB
  RETURNED
  LD_CHECK
  INVOICED
  CLOSED
  CANCELLED
}

// Parallel sales-stage status — added in Phase 1 of the sales pipeline rework.
// `OrderStatus` (above) remains the authoritative full-lifecycle field used by
// /orders, /dispatch, and downstream operations. `OrderQuoteStatus` is the
// sales-pipeline view of the same Order, kept in sync via deriveQuoteStatus()
// in src/lib/orders/quoteStatus.ts whenever Order.status mutates.
enum OrderQuoteStatus {
  DRAFT
  SENT
  WON
  LOST
  EXPIRED
}

enum LineItemType {
  VEHICLE
  EQUIPMENT
  EXPENDABLE
  LABOR
  FEE
  DISCOUNT
}

// Shoot-days claim lifecycle (Wes ruling B, 2026-07-17). The client
// may CLAIM fewer working days than the rental period on gear/vehicle
// lines; the claim never prices anything by itself — an agent approves
// (billableDays = claimedDays), adjusts (any value, above OR below —
// SirReel has final say), or it stays PENDING and blocks the order
// from reaching APPROVED.
enum DayClaimStatus {
  NONE
  PENDING
  APPROVED
  ADJUSTED
}

enum LineItemDepartment {
  VEHICLES
  COMMUNICATIONS
  STAGES
  PRO_SUPPLIES
  EXPENDABLES
  GE
  ART
  // Wardrobe & Makeup. One department, not two — SirReel has never had
  // enough standalone makeup gear to carry its own section, and the
  // public site has marketed the pair as one service ("Wardrobe &
  // Makeup" tile) since launch. Added 2026-08-29 (Wes): the gear was
  // scattered across PRO_SUPPLIES (the WAR-* cluster), EXPENDABLES
  // (hangers) and COMMUNICATIONS (a wardrobe Z-rack, plainly misfiled).
  WARDROBE_MAKEUP
}

// First-class order discounts (additive Phase). Coexists with legacy
// type='DISCOUNT' OrderLineItem rows — those stay as-is for existing
// orders, but all NEW discount entry funnels through this model so the
// two surfaces can't ship divergent rendering / clamping rules. The
// shared discount-aware totals util treats legacy DISCOUNT lines as
// part of the line subtotal (their negative lineTotal already reduces
// it) and applies these structured discounts ON TOP.
//
// Booked invoices are NOT retro-modified by new discounts — the
// existing bookedSubtotal/bookedTotal snapshot stays canonical for
// already-issued RENTAL invoices; the discount surfaces as an
// ADJUSTMENT line on next regen instead.
enum DiscountScope {
  ORDER
  DEPARTMENT
}

enum DiscountType {
  PERCENT
  FIXED
  // FLAT_TOTAL — ORDER-scope only. `value` stores the TARGET GRAND
  // TOTAL the user entered (e.g. 2500.00), not a derived discount
  // dollar amount. The applied discount is computed live in
  // computeOrderTotals as (discountedSubtotal − target/(1+taxRate)),
  // clamped at 0 — so the order total stays pinned to the target as
  // line items/dates shift. See src/lib/orders/discountedTotals.ts.
  FLAT_TOTAL
}

// Phase 1 lifecycle / book-time line routing. Set on each OrderLineItem
// atomically inside POST /api/orders/[id]/book based on the line's
// department:
//   VEHICLES                → FLEET     (no pickStatus; fleet team
//                                         assigns specific assets via
//                                         the existing /scheduling/
//                                         booking-items/[id]/assign path)
//   STAGES                  → STAGE     (no pickStatus; stage logistics
//                                         live on StageBookingTerms)
//   COMMUNICATIONS,
//   PRO_SUPPLIES,
//   EXPENDABLES, GE, ART    → WAREHOUSE (pickStatus = PENDING_PICK;
//                                         consumed by Phase 2 PickList
//                                         and picking workflow)
enum FulfillmentLane {
  FLEET
  WAREHOUSE
  STAGE
}

// Warehouse-lane progression for a single OrderLineItem. Nullable on
// non-warehouse lines. The PickList model + picking UX (Phase 2) reads
// this to drive the pick floor; LOADED feeds the rollup that fires
// LOADED_READY on the order (Phase 3).
enum LineItemPickStatus {
  PENDING_PICK
  PICKED
  STAGED
  LOADED
  // ── Inbound pass (2026-08-29). LOADED used to be terminal, which is
  // why nothing counted a kit back: 12 radios could go out with 6 spare
  // batteries and come back with 2 and no surface showed it. RETURNED
  // means the counted quantity matched; SHORT means it didn't, and the
  // shortfall sits on the order for a human to bill. Neither state is
  // reached automatically — a checker enters a count.
  RETURNED
  SHORT
}

enum RateType {
  DAILY
  WEEKLY
  MONTHLY
  FLAT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  VOID
}

model InventoryCategory {
  id         String             @id @default(uuid())
  name       String             @unique
  slug       String             @unique
  sortOrder  Int                @default(0) @map("sort_order")
  isActive   Boolean            @default(true) @map("is_active")
  // 2026-08-28 (Wes: "why do I have a category and a department?").
  // The two axes are NOT redundant — department is the billing/
  // fulfillment spine (rate rules, lane routing at book time,
  // department-scoped discounts) while category is the browse +
  // public-catalog-sectioning axis. They were redundant to TYPE IN,
  // though: the add-item modal asked for both. Category now OWNS the
  // department, so operators pick one thing and InventoryItem
  // .department is derived on create. Per-item overrides still exist
  // in the column (RW imports + the supply seed wrote their own) —
  // this is the default, not a constraint.
  department LineItemDepartment @default(PRO_SUPPLIES)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  items InventoryItem[]

  @@map("inventory_categories")
}

// Editable replacement for the legacy `Location` enum on InventoryItem.
// `code` mirrors the old enum value (e.g. "LANKERSHIM") so the backfill
// can map old → new without ambiguity.
model InventoryLocation {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items InventoryItem[]

  @@map("inventory_locations")
}

// Per-rate-change audit row. One entry per InventoryItem mutation
// triggered by the RW rate gap-fill script (or future automated rate
// sources). Lets "where did this rate come from?" be a one-SELECT
// answer, and gives us a clean rollback target if a bad batch lands.
//
// Kept off the generic AuditLog model on purpose — money columns
// deserve a typed column shape, not Json blobs, so the query for
// "show me this item's rate history" is the trivial sorted scan a
// human triager will actually run.
enum RateChangeSource {
  RW_GAP_FILL // scripts/rw-rate-gap-fill.ts (the May/June 2026 first run)
  MANUAL // operator edit via admin UI (future)
  ROLLBACK // reverting a prior change (future)
  IMPORT_RW // one-time RW inventory reconcile (2026-06-23 backfill)
}

model RateChangeLog {
  id              String           @id @default(uuid())
  // One of inventoryItemId / assetCategoryId is set per row. Catalog rate
  // edits stamp inventoryItemId (the original use); fleet CATEGORY rate
  // edits (Cube Truck, PopVan, …) stamp assetCategoryId. Both nullable so
  // the same audit table serves both surfaces.
  inventoryItemId String?          @map("inventory_item_id")
  assetCategoryId String?          @map("asset_category_id")
  oldDailyRate    Decimal          @map("old_daily_rate") @db.Decimal(10, 2)
  newDailyRate    Decimal          @map("new_daily_rate") @db.Decimal(10, 2)
  oldWeeklyRate   Decimal          @map("old_weekly_rate") @db.Decimal(10, 2)
  newWeeklyRate   Decimal          @map("new_weekly_rate") @db.Decimal(10, 2)
  source          RateChangeSource
  // Snapshot of the RW InventoryId at apply time when source = RW_GAP_FILL.
  // Captured even when the matching method WASN'T rwId-exact — so a
  // name-match fill records which RW master the rate actually came from.
  rwIdSource      String?          @map("rw_id_source")
  // Match method recorded for human review of the audit trail.
  // Mirrors the gap-fill script's bucket labels: 'rwId', 'code',
  // 'name', 'tokens'. Null for non-RW sources.
  matchMethod     String?          @map("match_method")
  appliedAt       DateTime         @default(now()) @map("applied_at")
  appliedById     String?          @map("applied_by_id")

  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  assetCategory AssetCategory? @relation(fields: [assetCategoryId], references: [id], onDelete: Cascade)
  appliedBy     User?          @relation("RateChangeApplier", fields: [appliedById], references: [id])

  @@index([inventoryItemId, appliedAt(sort: Desc)])
  @@index([assetCategoryId, appliedAt(sort: Desc)])
  @@index([source, appliedAt(sort: Desc)])
  @@map("rate_change_log")
}

model InventoryItem {
  id                String             @id @default(uuid())
  // Nullable since the May 2026 RW import — auto-created rows from RW
  // start with no SirReel category until the admin reassigns. Existing
  // hand-curated rows always have one.
  categoryId        String?            @map("category_id")
  code              String             @unique
  // RentalWorks item number (I-Code), backfilled one-time from RW in the
  // 2026-06-23 reconcile. Distinct from `code` (HQ's descriptive unique
  // key) and `rwId` (RW InventoryId / master). Surfaces to the catalog
  // since the catalog reads InventoryItem. Nullable: only MATCHED rows
  // get one; never overwritten once set.
  rwICode           String?            @map("rw_icode")
  description       String?
  dailyRate         Decimal            @default(0) @map("daily_rate") @db.Decimal(10, 2)
  weeklyRate        Decimal            @default(0) @map("weekly_rate") @db.Decimal(10, 2)
  // Intentional no-charge inclusion (e.g. recycle bins that come with a
  // basecamp order). Disambiguates a $0 dailyRate: includedFree=true →
  // public form shows "Included" (not orderable); a $0 with includedFree=false
  // is a missing price and is HIDDEN from the public form (fail-safe — never
  // render "FREE"/orderable to a client). Internal/rep views ignore this flag.
  includedFree      Boolean            @default(false) @map("included_free")
  qtyOwned          Int                @default(0) @map("qty_owned")
  replacementCost   Decimal?           @map("replacement_cost") @db.Decimal(10, 2)
  imageUrl          String?            @map("image_url")
  // Preferred replacement vendor — relational so reorder routing is
  // consistent across items (same handful of vendors: Amazon, Home
  // Depot, etc., not free text). `vendorItemUrl` is an item-specific
  // product/reorder link that overrides Vendor.url for THIS item;
  // when null we fall back to the vendor's default url.
  preferredVendorId String?            @map("preferred_vendor_id")
  preferredVendor   Vendor?            @relation(fields: [preferredVendorId], references: [id])
  vendorItemUrl     String?            @map("vendor_item_url")
  // Phase 2 sales pipeline. `aliases` are colloquial synonyms ("walkies" →
  // CP200 Radio) handed to the AI extractor as catalog context and used
  // server-side for fallback alias-tokenized matching. `department` is the
  // catalog-side authority — when an OrderLineItem matches this product,
  // the line item's department is overridden from this field.
  aliases           String[]           @default([])
  department        LineItemDepartment
  // Default LineItemType for this catalog item — inherited by
  // OrderLineItem when the line is created from a catalog match
  // (overridable per-line). EQUIPMENT for unit=day rentals,
  // EXPENDABLE for unit=ea consumables. The new-quote createQuote
  // path may still re-derive at create time for legacy callers.
  type              LineItemType       @default(EQUIPMENT)
  // RentalWorks enrichment (May 2026 spike). The first four columns are
  // populated from RW Items grouped by InventoryId. needsReview flags
  // auto-created rows where Wes hasn't yet picked an InventoryCategory /
  // confirmed the dept guess. rwLastSyncedAt + rwId track the last RW
  // pull so re-syncs can pick up where they left off.
  manufacturer      String?
  model             String?
  specs             String?            @db.Text
  dimensions        String?
  // Color-variant grouping (2026-07, tents first): items sharing a
  // variantGroupKey render as ONE public-catalog card with color swatches;
  // color labels each swatch. Only COLOR is a variant — sizes stay separate
  // groups/cards. Null = standalone item (renders exactly as before).
  color             String?
  variantGroupKey   String?            @map("variant_group_key")
  needsReview       Boolean            @default(false) @map("needs_review")
  rwLastSyncedAt    DateTime?          @map("rw_last_synced_at")
  rwId              String?            @map("rw_id")
  // Whether the item appears in the client-facing supply ordering
  // catalog. Defaults false so RW-imported rows stay out of the public
  // surface until an operator (or the seed script) opts them in. The
  // seed flips this for items reconciled against the Production
  // Supplies PDF; everything else stays hidden.
  publicVisible     Boolean            @default(false) @map("public_visible")
  // Soft-delete: `isActive=false` is the archive state (already the
  // universal exclude filter on list / catalog / search / pickers).
  // `archivedAt` records WHEN it was archived for the Archived view +
  // restore audit; restore flips isActive=true and clears archivedAt.
  isActive          Boolean            @default(true) @map("is_active")
  archivedAt        DateTime?          @map("archived_at")
  // Client-facing note seeded onto OrderLineItem.notes whenever this
  // InventoryItem is added as a line. Lets the catalog carry policy text
  // (e.g. "LED wall use requires a qualified A/V Tech on the client's
  // payroll.") so the same wording prints on every quote/invoice
  // without per-line config. Editable per-line after the fact.
  clientNote        String?            @map("client_note")
  // Admin-only flags that the order detail UI consults to surface
  // operational reminders (e.g. ["REQUIRES_AV_TECH"] for the LED Wall
  // Usage item triggers a sticky amber banner). Never printed on
  // client-facing PDFs.
  internalFlags     String[]           @default([]) @map("internal_flags")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  category     InventoryCategory?  @relation(fields: [categoryId], references: [id])
  lineItems    OrderLineItem[]
  packageItems PackageItem[]
  // Included accessories (see InventoryKitPiece). `kitPieces` = what goes
  // out WITH this item; `kitPieceOf` = the parents this item rides along
  // with. Both directions are needed: the same battery hangs off three
  // different radios.
  kitPieces    InventoryKitPiece[] @relation("KitParent")
  kitPieceOf   InventoryKitPiece[] @relation("KitPiece")
  subRentals   SubRental[]
  rateChanges  RateChangeLog[]
  location     Location            @default(LANKERSHIM)

  // New editable-location FK. Coexists with the legacy enum during transition;
  // app reads/writes prefer this when present.
  locationId  String?            @map("location_id")
  locationRef InventoryLocation? @relation(fields: [locationId], references: [id])

  // ── Unified catalog (Aug 2026) ────────────────────────────────────
  // InventoryItem is becoming the single catalog model; AssetCategory
  // folds in here. The two tables only ever differed in HOW availability
  // is tracked, which belongs in a column, not a table split:
  //
  //   UNIT_TRACKED — individually-identified Assets, a Planyo resource,
  //                  gantt-reservable. Vehicles and stages.
  //   QUANTITY     — a count on hand (qtyOwned). Warehouse gear.
  //
  // The split forced reps to pick a table before they could quote, which
  // is how "Hospital Set" ended up as warehouse stock at $3,500/day while
  // the "Studios" rate card said $3,000.
  //
  // AssetCategory.totalUnits maps onto qtyOwned and .isPublished onto
  // publicVisible — same meaning, no new columns. The rest land here.
  // All nullable / defaulted: existing rows stay QUANTITY and untouched.
  trackingMode          CatalogTrackingMode @default(QUANTITY) @map("tracking_mode")
  slug                  String?             @unique
  region                Region?
  minRentalHours        Int?                @map("min_rental_hours")
  maxRentalDays         Int?                @map("max_rental_days")
  reservableOnGantt     Boolean             @default(false) @map("reservable_on_gantt")
  sortOrder             Int                 @default(0) @map("sort_order")
  planyoResourceId      Int?                @unique @map("planyo_resource_id")
  rentalworksCategId    String?             @map("rentalworks_categ_id")
  // Provenance for the merged rows: which AssetCategory this row came
  // from. Lets any caller holding a legacy assetCategoryId resolve the
  // merged catalog row in one indexed hit — see lib/catalog/resolve.ts.
  // Null on the 1,831 rows that were always InventoryItems.
  legacyAssetCategoryId String?             @unique @map("legacy_asset_category_id")
  // AssetCategory.description — a public-facing blurb. InventoryItem's
  // own `description` is the display NAME, so it can't be reused.
  catalogDescription    String?             @map("catalog_description") @db.Text

  // Children repointed off AssetCategory in Phase 3.
  assets            Asset[]
  bookingItems      BookingItem[]
  vehicleCategories VehicleCategory[]
  companyRates      CompanyRate[]

  @@index([rwId])
  @@index([needsReview])
  @@index([locationId])
  @@index([preferredVendorId])
  @@index([trackingMode])
  @@map("inventory_items")
}

// A negotiated per-client price on ONE catalog item — the client rate
// card (2026-08-29, Wes: "their rate on super cargo vans is $130, where
// our primary rate is $170. How can we make sure they see that in the
// line?").
//
// This is deliberately NOT a discount. An OrderDiscount is a totals-level
// row that renders under a section subtotal, so the line above it still
// prints the list rate; a CompanyRate replaces what the line itself bills
// at, so the client reads "$130.00/day" and no discount row appears.
//
// Resolution (src/lib/pricing/companyRate.ts + resolveRate.ts): a
// positive value here OVERLAYS the catalog rate per field — a negotiated
// daily with no negotiated weekly still falls back to the catalog weekly.
// Non-positive/null means "not negotiated for this unit", never "free",
// matching the catalog's own `rate <= 0 = unpriced` rule.
//
// Consequence worth stating: for a client with a rate here, the negotiated
// number becomes `resolvedRate` on the line — so billing at it is NOT a
// rate override, and a rep typing something ELSE still trips the override
// audit against the negotiated rate rather than against list.
//
// No effective-date window on purpose. A negotiated rate is current until
// it is changed, and "as of when" is genuinely ambiguous on a quote
// (booking date? pickup date? send date?) — better to leave the question
// unasked than to answer it wrong in a column nothing reads.
model CompanyRate {
  id              String @id @default(uuid())
  companyId       String @map("company_id")
  inventoryItemId String @map("inventory_item_id")

  // Both nullable: a deal is often struck on the daily only. Null (or
  // <= 0) on a field means "use the catalog value for that field".
  dailyRate  Decimal? @map("daily_rate") @db.Decimal(10, 2)
  weeklyRate Decimal? @map("weekly_rate") @db.Decimal(10, 2)

  /// Why this rate exists — "2026 season deal", "matched their Dallas
  /// vendor". Internal only; never rendered to the client.
  note String? @db.Text

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  createdBy     User?         @relation("CompanyRateCreator", fields: [createdById], references: [id])

  @@unique([companyId, inventoryItemId])
  @@index([companyId])
  @@index([inventoryItemId])
  @@map("sr_company_rates")
}

// How a catalog row's availability is tracked. See InventoryItem.
enum CatalogTrackingMode {
  UNIT_TRACKED
  QUANTITY
}

// Rounding direction for a kit piece's derived quantity. Both are
// load-bearing and neither is a safe global default: spare batteries
// round UP (15 radios → 8 spares, never 7 — a crew short a battery is
// a call to the warehouse), charging banks round DOWN with minQty=1
// (13 radios don't need a second bank, but 5 radios still need one).
enum KitPieceRounding {
  CEIL
  FLOOR
}

// Whether the piece rides along free or bills at its own catalog rate.
// FREE is the whole point of the feature — CHARGED exists so an item
// that must ALWAYS accompany another (and is billable when it does)
// can use the same auto-add machinery instead of being remembered.
enum KitPieceBilling {
  FREE
  CHARGED
}

// Included accessories — the pieces that leave the building with a
// rented item whether or not the client thought to ask for them: the
// 6-bank charger and spare batteries that go out with every walkie
// order.
//
// A kit piece is a LINK to a real catalog row, never a sub-item created
// under a parent. The charger is stock SirReel owns — it has a qty, a
// replacement cost, a photo, a scannable code, and it gets lost. Child
// rows invented under "CP200 (Analog)" would be a second, shadow
// inventory that the counts page, the pick-list scanner and any loss
// billing can't see. It's also many-to-many in practice: one battery
// serves the analog radio, the digital radio and the sub.
//
// Quantity is a RATIO off the parent line's quantity, not a fixed
// count — see resolveKitQuantity() in src/lib/inventory/kitPieces.ts,
// which is the only place the arithmetic lives.
//
// Ratios in production today are Wes's, 2026-08-17, carried over from
// the hardcoded walkie kit this replaces: spare batteries at 50% of the
// radio count, one charging bank per 12 radios (min 1).
model InventoryKitPiece {
  id           String @id @default(uuid())
  parentItemId String @map("parent_item_id")
  pieceItemId  String @map("piece_item_id")

  // qty = round(parentQty / perUnits * qtyPer), then floored at minQty.
  // 0.5-per-1 CEIL = spare batteries; 1-per-12 FLOOR min 1 = charge bank.
  qtyPer   Decimal          @default(1) @map("qty_per") @db.Decimal(10, 4)
  perUnits Int              @default(1) @map("per_units")
  rounding KitPieceRounding @default(CEIL)
  minQty   Int              @default(0) @map("min_qty")

  billing KitPieceBilling @default(FREE)

  // Prints on the client's quote/invoice as an included line. False =
  // warehouse-only; the pick list sees the piece either way, since pick
  // membership follows the line's department, not its visibility.
  clientVisible Boolean @default(true) @map("client_visible")

  // The client listed this accessory themselves — leave their line
  // alone rather than shipping (and quoting) it twice.
  suppressIfOrdered Boolean @default(true) @map("suppress_if_ordered")

  // Rep-facing explanation stamped onto the auto-added line. Null =
  // generated from the ratio ("Included with 12 radios — no charge").
  note String? @db.Text

  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Lines this kit row has generated. Read by the reconciler and by the
  // item DELETE route's reference count.
  orderLines OrderLineItem[]

  parent InventoryItem @relation("KitParent", fields: [parentItemId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting the charger should fail loudly while
  // three radios still promise it, not silently empty their kits. The
  // item DELETE route counts these as references and archives instead.
  piece  InventoryItem @relation("KitPiece", fields: [pieceItemId], references: [id], onDelete: Restrict)

  @@unique([parentItemId, pieceItemId])
  @@index([parentItemId, sortOrder])
  @@index([pieceItemId])
  @@map("inventory_kit_pieces")
}

model Order {
  id              String           @id @default(uuid())
  orderNumber     String           @unique @map("order_number")
  bookingId       String?          @map("booking_id")
  companyId       String           @map("company_id")
  agentId         String           @map("agent_id")
  status          OrderStatus      @default(DRAFT)
  quoteStatus     OrderQuoteStatus @default(DRAFT) @map("quote_status")
  description     String?          @db.Text
  startDate       DateTime?        @map("start_date") @db.Date
  endDate         DateTime?        @map("end_date") @db.Date
  subtotal        Decimal          @default(0) @db.Decimal(12, 2)
  taxRate         Decimal          @default(0) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount       Decimal          @default(0) @map("tax_amount") @db.Decimal(12, 2)
  total           Decimal          @default(0) @db.Decimal(12, 2)
  // Booked-value snapshot — captured atomically when the order is BOOKED
  // (Phase 1 / commit 3). These are the second of the three canonical
  // money numbers per order-lifecycle-spec (quote estimate → booked
  // value → final invoice). They are write-once: never overwritten by
  // post-booking edits to subtotal/total, and never collapsed into the
  // Invoice columns. Null until the order has been booked.
  bookedSubtotal  Decimal?         @map("booked_subtotal") @db.Decimal(12, 2)
  bookedTaxAmount Decimal?         @map("booked_tax_amount") @db.Decimal(12, 2)
  bookedTotal     Decimal?         @map("booked_total") @db.Decimal(12, 2)
  bookedAt        DateTime?        @map("booked_at")
  // Phase 3 lifecycle: stamped when the fleet lane is physically
  // ready (manually via /api/orders/[id]/fleet-ready for now; will be
  // stamped automatically when the digital fleet checkout flow lands).
  // The LOADED_READY rollup treats fleetReadyAt non-null as fleet-side
  // terminal. Null = fleet side still pending OR no fleet lines.
  fleetReadyAt    DateTime?        @map("fleet_ready_at")
  quoteSentAt     DateTime?        @map("quote_sent_at")
  quoteAcceptedAt DateTime?        @map("quote_accepted_at")
  quoteExpDays    Int              @default(7) @map("quote_exp_days")
  // Sales-stage timestamps. Stamped by the sync helper when quoteStatus
  // transitions; sentAt/wonAt/lostAt are write-once (only set if currently
  // null). expiresAt is reserved for a future auto-expiry mechanism.
  sentAt          DateTime?        @map("sent_at")
  expiresAt       DateTime?        @map("expires_at")
  wonAt           DateTime?        @map("won_at")
  lostAt          DateTime?        @map("lost_at")
  notes           String?          @db.Text
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Locked enum reason populated when an Order transitions to LOST. The column
  // was previously free-text but had zero rows in production at the time of
  // the CRH cutover, so it was switched to a typed enum to drive lost-quote
  // reporting and re-engagement cadence eligibility.
  lostReason LostReason? @map("lost_reason")

  // Client Relationship Hub (CRH) cadence state. `cadenceState` mirrors
  // Order.status but at a finer grain — it tracks where the order sits in
  // the email cadence ladder (quote silence, acknowledged, discussing,
  // booked, in-progress, ...). The cron-driven CadenceEventRunner advances
  // it and emits emails based on the state machine in the CRH brief.
  cadenceState          CadenceState @default(QUOTE_DRAFT) @map("cadence_state")
  cadencePausedUntil    DateTime?    @map("cadence_paused_until")
  cadenceManualOverride Boolean      @default(false) @map("cadence_manual_override")

  // Captures the pickup date as it stood when the order was marked LOST.
  // Useful for re-engagement reporting (how close to pickup did we lose them).
  pickupDateAtLoss DateTime? @map("pickup_date_at_loss")

  // Soft-archive marker (staff "Archive order" action on /orders).
  // Visibility-only, mirroring Job.archivedAt: the /orders list filters
  // archivedAt IS NULL by default, `archived=1` goes looking for them,
  // and the detail page stays reachable either way. Additive; NULL =
  // active. Cleared on unarchive. This is the answer for a dead row that
  // ISN'T a lost quote or a cancellation — a duplicate, a test order, a
  // parse nobody finished — where CANCELLED would state something untrue.
  archivedAt   DateTime? @map("archived_at")
  archivedById String?   @map("archived_by_id")

  // Re-engagement (post-LOST) touchpoint tracking. Set by the
  // LOST_REENGAGEMENT_2W cadence event when it fires; flipped to true when
  // the client responds (any inbound reply detected by Gmail integration).
  reengagementSentAt    DateTime? @map("reengagement_sent_at")
  reengagementResponded Boolean   @default(false) @map("reengagement_responded")

  // Client-facing portal URL slug. Declared nullable because `prisma db push`
  // cannot add a non-null TEXT column to existing rows without a SQL default
  // (Prisma's @default(uuid()) runs client-side). New rows always get a slug
  // via the @default(uuid()); a one-time backfill populates pre-existing rows.
  // Once every row has a value, the application layer can treat this as
  // effectively non-null.
  portalSlug      String?   @unique @default(uuid()) @map("portal_slug")
  portalCreatedAt DateTime  @default(now()) @map("portal_created_at")
  portalSunsetAt  DateTime? @map("portal_sunset_at")

  // Client-facing Quote PDF (mirrors the contract review counter-PDF
  // pattern: blob key + url + timestamp, replace-on-regenerate). PDF is
  // generated when the agent clicks "Create Quote" on /orders/new-quote
  // and lands in Vercel Blob behind auth.
  quotePdfKey         String?   @map("quote_pdf_key")
  quotePdfUrl         String?   @map("quote_pdf_url")
  quotePdfGeneratedAt DateTime? @map("quote_pdf_generated_at")
  // DOT paperwork Phase 2 — the generated per-vehicle DOT info packet (one
  // page per assigned VEHICLE unit, sourced from Asset DOT fields + the
  // latest BitInspection). Mirrors the quote-PDF storage pattern; the URL is
  // a PRIVATE blob, served only through the gated proxy (rep + portal),
  // never a public CDN URL. Replace-on-regenerate.
  dotSheetPdfKey      String?   @map("dot_sheet_pdf_key")
  dotSheetPdfUrl      String?   @map("dot_sheet_pdf_url")
  dotSheetGeneratedAt DateTime? @map("dot_sheet_generated_at")

  // Blind handoff flags — set on the order when the client picks up
  // their own unit (blindPickup) or returns it themselves (blindReturn)
  // without a SirReel rep present. When either flag is on, the matching
  // *Instructions text is what the agent typed for the client to see in
  // the portal (location, gate code, lockbox combination, where to
  // park, etc.). The Dispatch board surfaces blindReturn loudly on the
  // inbound lane so the unit doesn't sit unprocessed.
  blindPickup             Boolean @default(false) @map("blind_pickup")
  blindReturn             Boolean @default(false) @map("blind_return")
  blindPickupInstructions String? @map("blind_pickup_instructions") @db.Text
  blindReturnInstructions String? @map("blind_return_instructions") @db.Text

  // Delivery/pickup task origination (STEP 1 — additive fields only, no logic
  // yet). Sales marks the order for delivery and/or pickup; a DispatchTask is
  // created from that marking in a later step.
  deliveryRequested Boolean        @default(false) @map("delivery_requested")
  pickupRequested   Boolean        @default(false) @map("pickup_requested")
  dispatchTasks     DispatchTask[]

  // Phase 1b client-intake — set when this Order was added as an
  // "add-on" to an existing Job via the inquiry triage path (rather
  // than created alongside a new Job at quote time). Null on every
  // Order that was the FIRST order on its job. Drives the "Add-on"
  // chip on the order list + detail and the convertedOrder relation
  // back-link from the Inquiry it satisfied.
  addedToJobAt DateTime? @map("added_to_job_at")

  booking            Booking? @relation(fields: [bookingId], references: [id])
  company            Company  @relation(fields: [companyId], references: [id])
  /// Show this order's agent to the CLIENT as "Your SirReel rep".
  ///
  /// Opt-IN, default false. The agent field is always populated — self-serve
  /// jobs get one assigned automatically — but an automatic assignment is not
  /// a relationship, and presenting one as the client's rep put the wrong
  /// name, phone and email in front of clients. Set this only when someone
  /// has actually taken the account.
  repVisibleToClient Boolean  @default(false) @map("rep_visible_to_client")

  agent        User            @relation("OrderAgent", fields: [agentId], references: [id])
  lineItems    OrderLineItem[]
  invoices     Invoice[]
  subRentals   SubRental[]
  followUps    QuoteFollowUp[]
  discounts    OrderDiscount[]
  incidents    Incident[]
  jobId        String          @map("job_id")
  jobContactId String?         @map("job_contact_id")

  job        Job     @relation(fields: [jobId], references: [id])
  jobContact Person? @relation("OrderJobContact", fields: [jobContactId], references: [id])

  // Was 1:1 before May 2026; now 1:many because an Order may need both a
  // RENTAL_AGREEMENT and a STAGE_CONTRACT. Callers that historically read
  // `order.signedAgreement` should switch to filtering on contractType, e.g.
  // `signedAgreements.find(a => a.contractType === 'RENTAL_AGREEMENT')`.
  signedAgreements   SignedAgreement[]
  agreementReissues  AgreementReissue[]
  stageBookingTerms  StageBookingTerms?
  cadenceEvents      CadenceEvent[]
  portalAccesses     PortalAccess[]
  emailDeliveries    EmailDelivery[]
  // 1-1 back-relation to the Inquiry that became this Order via the
  // add-on triage path. Mirrors Job.fromInquiry — Inquiry.convertedOrderId
  // is @unique so at most one Inquiry points here.
  fromInquiry        Inquiry?            @relation("ConvertedFromInquiryToOrder")
  // Phase 2 warehouse lane: zero-or-one PickList per Order, created at
  // book time iff the order has ≥1 WAREHOUSE-lane line item.
  pickList           PickList?
  // Typed document attachments — JOB_PHOTO candids from the warehouse
  // team currently; expand the OrderDocType enum when new use cases
  // surface. Cascade-deletes with the order.
  documents          OrderDocument[]
  // 0-or-1 thank-you suggestion (created on RETURNED transition).
  // @unique on the FK so a RETURNED → not-RETURNED → RETURNED bounce
  // doesn't mint duplicates; the upsert is idempotent.
  thankYouSuggestion ThankYouSuggestion?

  @@index([jobId])
  @@index([quoteStatus, sentAt])
  @@index([cadenceState])
  @@map("sr_orders")
}

// OrderDocument — typed file attachments on an order. Mirrors the
// ClaimDocument / HrAttachment pattern (Vercel Blob storage, type
// enum, optional uploader audit). Today the only consumer is the
// post-job thank-you flow's JOB_PHOTO candid; the OTHER bucket lets
// us absorb miscellaneous order-attached files without churning the
// enum.
//
// fileUrl is the hosted HTTPS Blob URL. Per the shared upload helper
// at src/lib/orders/uploadOrderDocument.ts, the URL is public by
// knowledge (Vercel Blob's effective access for `put()` calls) —
// safe to embed as an <img src> in client-facing emails (Gmail
// blocks base64 data: URIs, hosted URLs are the only reliable path).
enum OrderDocType {
  JOB_PHOTO
  OTHER
}

model OrderDocument {
  id           String       @id @default(uuid())
  orderId      String       @map("order_id")
  type         OrderDocType
  title        String
  fileUrl      String       @map("file_url")
  blobKey      String?      @map("blob_key")
  mimeType     String?      @map("mime_type")
  sizeBytes    Int?         @map("size_bytes")
  uploadedById String?      @map("uploaded_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  order           Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy      User?                @relation("OrderDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  thankYouAsPhoto ThankYouSuggestion[] @relation("ThankYouPhoto")

  @@index([orderId, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("sr_order_documents")
}

// ThankYouSuggestion — created on Order.status transition to RETURNED.
// One per Order (FK is @unique). Status is SUGGESTED until the rep
// sends or dismisses; on send we stamp sentAt + sentToEmail for the
// audit. Visual expiry (>14 days old → grayed in the queue widget)
// is computed off createdAt at render time; no cron required.
//
// photoDocumentId is optional — the spec is photo-encouraged-not-
// required because the warehouse team is who shoots candids on
// phones, and dispatch can't always wait. personalNote is the rep's
// optional single-line addition above the templated body.
enum ThankYouStatus {
  SUGGESTED
  SENT
  DISMISSED
}

model ThankYouSuggestion {
  id              String         @id @default(uuid())
  orderId         String         @unique @map("order_id")
  status          ThankYouStatus @default(SUGGESTED)
  photoDocumentId String?        @map("photo_document_id")
  personalNote    String?        @map("personal_note") @db.Text
  sentAt          DateTime?      @map("sent_at")
  sentToEmail     String?        @map("sent_to_email")
  // The agent who hit Send. Nullable — auto-dismiss flows could set
  // status without a user (none today, but the column doesn't fight
  // future-Wes for it).
  sentById        String?        @map("sent_by_id")
  // Free-text reason captured when status = DISMISSED. Drives the
  // "why we didn't thank this client" audit when reviewing the queue.
  dismissedReason String?        @map("dismissed_reason") @db.Text
  dismissedAt     DateTime?      @map("dismissed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  photoDocument OrderDocument? @relation("ThankYouPhoto", fields: [photoDocumentId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@map("sr_thank_you_suggestions")
}

// AgentWeeklyCandid — the rep's "candid of the week" photo for the
// thank-you flow. Intent: a fresh, in-the-moment shot from the
// warehouse / fleet bay / a guy holding a piece of gear, with the
// SirReel sign in the frame when possible. Replaces the polished
// stock-photo feel with something that says "we did this for you
// THIS week". A new row is created each time the rep uploads; the
// current candid is the most recent row, but history is preserved
// for audit (and so a rep can re-pick last week's candid if they
// forgot to upload this week).
//
// fileUrl is the hosted Blob URL — must be publicly fetchable for
// email <img> embedding to work (see uploadOrderDocument's note on
// the private-blob-store gap).
model AgentWeeklyCandid {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  fileUrl       String   @map("file_url")
  blobKey       String?  @map("blob_key")
  mimeType      String?  @map("mime_type")
  sizeBytes     Int?     @map("size_bytes")
  // Monday of the calendar week this candid covers (Pacific time at
  // upload). Drives the "show me this week's candid" lookup.
  weekStartDate DateTime @map("week_start_date") @db.Date
  capturedAt    DateTime @default(now()) @map("captured_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStartDate(sort: Desc)])
  @@index([userId, capturedAt(sort: Desc)])
  @@map("sr_agent_weekly_candids")
}

enum FollowUpStage {
  DAY_0 // legacy: EOD same day quote was sent (cron-generated, pipeline panel)
  DAY_1 // legacy: ~24h after send
  DAY_3 // legacy: ~72h after send

  // Mode A cadence values (May 2026). Anchored to quoteSentAt + expiresAt,
  // not a flat hour offset. See src/lib/sales/quoteCadence.ts for the
  // STAGE_N due-time math and gating. Agent-driven send from the order
  // detail panel — no cron auto-creation; rows are logged at send time.
  STAGE_1 // ~2 days after sent — "did the quote land?"
  STAGE_2 // ~halfway between sent and valid-until — "still planning these dates?"
  STAGE_3 // ~1–2 days before valid-until — "want to lock it in?"
}

enum FollowUpStatus {
  PENDING // due, awaiting agent action
  SENT // agent sent the follow-up
  SKIPPED // agent dismissed without sending
  EXPIRED // quote moved out of SENT before agent acted (won/lost/draft)
}

// Cadence row generated by the hourly cron whenever a SENT quote crosses a
// threshold. Drafts are pre-composed; the agent reviews + sends from the
// pipeline. Unique on (orderId, stage) so cron runs are idempotent.
model QuoteFollowUp {
  id           String         @id @default(uuid())
  orderId      String         @map("order_id")
  stage        FollowUpStage
  dueAt        DateTime       @map("due_at")
  status       FollowUpStatus @default(PENDING)
  draftSubject String         @map("draft_subject")
  draftBody    String         @map("draft_body") @db.Text
  sentAt       DateTime?      @map("sent_at")
  sentById     String?        @map("sent_by_id")
  skippedAt    DateTime?      @map("skipped_at")
  skippedById  String?        @map("skipped_by_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sentBy          User?           @relation("FollowUpSentBy", fields: [sentById], references: [id])
  skippedBy       User?           @relation("FollowUpSkippedBy", fields: [skippedById], references: [id])
  emailDeliveries EmailDelivery[]

  @@unique([orderId, stage])
  @@index([status, dueAt])
  @@map("quote_followups")
}

model OrderLineItem {
  id              String              @id @default(uuid())
  orderId         String              @map("order_id")
  sortOrder       Int                 @default(0) @map("sort_order")
  type            LineItemType
  // Phase 1 sales pipeline: every line item carries a department for
  // departmental quote breakdown. Backfilled to PRO_SUPPLIES on existing
  // rows — note the historical-reporting caveat in the commit message.
  department      LineItemDepartment  @default(PRO_SUPPLIES)
  // Phase 1 lifecycle spine: set at book time from `department`. Null
  // until the order transitions APPROVED → BOOKED.
  fulfillmentLane FulfillmentLane?    @map("fulfillment_lane")
  // Warehouse-lane only: PENDING_PICK at book time, advanced by the
  // Phase 2 picking workflow. Null on FLEET and STAGE lanes.
  pickStatus      LineItemPickStatus? @map("pick_status")
  description     String
  inventoryItemId String?             @map("inventory_item_id")
  assetCategoryId String?             @map("asset_category_id")
  // Fee-catalog source (type=FEE lines). Mutually exclusive with the
  // two catalog FKs above in practice; the server prices the line from
  // FeeItem.amount + unit — same trust model as resolveLineRate.
  feeItemId       String?             @map("fee_item_id")
  startDate       DateTime?           @map("start_date") @db.Date
  endDate         DateTime?           @map("end_date") @db.Date
  rateType        RateType            @default(DAILY)
  rate            Decimal             @db.Decimal(10, 2)
  // Sprint 1 money integrity: server-resolved Fleet Pricing/catalog rate
  // at write time (null = nothing to resolve — custom/FLAT/discount lines),
  // snapshotted at QUOTE_SENT if still null. `rate` above is what the line
  // bills at; when it differs from resolvedRate the write was a staff
  // override and rateOverridden flips (AuditLog: order.line_item_rate_override).
  resolvedRate    Decimal?            @map("resolved_rate") @db.Decimal(10, 2)
  rateOverridden  Boolean             @default(false) @map("rate_overridden")
  quantity        Int                 @default(1)
  // Per-line pickup / return dates. Default to the parent Order's range,
  // but rep can override per line during quote review.
  pickupDate      DateTime            @map("pickup_date") @db.Date
  returnDate      DateTime            @map("return_date") @db.Date
  // Billable days — what the client is charged for. For cap-per-week
  // departments this typically differs from (returnDate - pickupDate)
  // because of the weekly cap; the rep can edit it freely. Stored in
  // the `days` column for backward compat.
  //
  // **Nullable (STEP 1C)**: a quote may legitimately have dates TBD —
  // a "rate-card" quote where the line shows "$X/day · total on dates"
  // instead of a computed total. NULL means "explicitly undated; do
  // NOT compute a firm total." All existing rows are non-null (the
  // schema kept the @default(1) which lands on legacy writes and the
  // RW import). computeLineTotal() returns 0 on NULL and the UI
  // surfaces the per-day rate. Sending a firm-total quote is blocked
  // when any non-EXPENDABLE line has NULL billableDays — see the
  // Send Quote validator.
  billableDays    Int?                @default(1) @map("days")
  // ── Shoot-days claim (Wes ruling B) ────────────────────────────
  // computedDays: server-derived max(1, returnDate − pickupDate) —
  //   never client-writable; the reference number. Nullable only for
  //   legacy rows pending backfill.
  // claimedDays: the client's shoot-days REQUEST from the public
  //   form. NEVER prices anything on its own.
  // Price resolution: billableDays ?? computedDays. billableDays is
  //   AUTHORITATIVE when set (agent-approved; may exceed claimedDays
  //   or computedDays — no clamping, SirReel has final say). The
  //   pre-existing NULL-billableDays "rate-card / dates-TBD" semantic
  //   in computeLineTotal is unchanged.
  computedDays    Int?                @map("computed_days")
  claimedDays     Int?                @map("claimed_days")
  claimStatus     DayClaimStatus      @default(NONE) @map("claim_status")
  claimNote       String?             @map("claim_note") @db.Text
  lineTotal       Decimal             @db.Decimal(12, 2)
  // Phase 2: AI-extracted client modifier preserved verbatim (e.g.
  // "no surveillance kits"). Displayed in italics in the builder; never
  // used to invent extra line items.
  qualifier       String?             @db.Text
  notes           String?             @db.Text

  /// This line was quoted from a REP'S ESTIMATE of usage, not a known
  /// quantity — partner mileage and generator hours, where nobody knows the
  /// number until the job runs (Wes 2026-08-28). The client-facing wording
  /// lives in `notes` and prints under the description on the quote; this
  /// flag is the machine-readable half, so invoicing can find every line
  /// that still needs an actual instead of grepping small print.
  ///
  /// Day-rate ancillaries (driver, supplies) are NOT estimated — the day
  /// count is known at quote time — so they stay false.
  usageEstimated Boolean @default(false) @map("usage_estimated")

  /// The line this one hangs UNDER — partner ancillaries beneath the vehicle
  /// they belong to (Wes 2026-08-28: "positioned as subitems to the EcoFlux
  /// ... each vehicle may have different usage totals and it should be
  /// vehicle specific").
  ///
  /// Keyed to the LINE, not the vehicle: two coaches on one order are two
  /// lines, and the whole point is that each carries its own mileage and
  /// generator hours. Keying to the vehicle would have let a job hold only
  /// one set of usage numbers per unit type.
  ///
  /// Distinct from packageInstanceId, which is package PRICING — there the
  /// header carries the price and members come through at rate 0. Here every
  /// child is separately priced; only the position is inherited.
  parentLineItemId String?         @map("parent_line_item_id")
  parentLineItem   OrderLineItem?  @relation("LineItemChildren", fields: [parentLineItemId], references: [id], onDelete: Cascade)
  childLineItems   OrderLineItem[] @relation("LineItemChildren")

  /// The InventoryKitPiece that generated this line — an included accessory
  /// the client never asked for (spare batteries with walkies, bulbs with a
  /// makeup mirror). Provenance, not inference: the reconciler in
  /// src/lib/orders/kitSync.ts resizes and removes ONLY lines carrying this
  /// id, so a battery the client ordered themselves is never touched by a
  /// radio quantity edit.
  ///
  /// The earlier parse-quote path re-derived "is this a kit piece?" by
  /// checking the line's inventoryItemId against the kit table. That answers
  /// "could this have been a kit piece", which is a different question — and
  /// it silently swallowed the rate-override audit for a battery a rep
  /// deliberately zeroed out.
  ///
  /// SetNull, not Cascade: unconfiguring a kit must leave the already-quoted
  /// line on the order (it may already be picked and on a truck) and merely
  /// stop the reconciler from managing it.
  autoKitPieceId String?            @map("auto_kit_piece_id")
  autoKitPiece   InventoryKitPiece? @relation(fields: [autoKitPieceId], references: [id], onDelete: SetNull)

  /// Provenance for lines created from a partner's ancillary fee schedule
  /// (src/lib/sub-rentals/orderFees.ts). Deliberately its own column rather
  /// than a marker in `qualifier` — qualifier prints on the quote in italics,
  /// so a provenance tag parked there would show a client an internal id.
  /// Also the idempotency key: adding the same unit's fees twice is refused,
  /// because a duplicated $550 driver fee on a sent quote is invisible.
  partnerVehicleId String? @map("partner_vehicle_id")

  // Package grouping. When a package is selected on a line, one
  // header line + N member lines share a single `packageInstanceId`
  // (cuid minted at add-time). The header carries the package price;
  // member lines render with $0 and "included" in the invoice PDF.
  // `isPackageHeader` distinguishes the two; `isPackageModified`
  // surfaces an amber "contents modified — verify pricing" dot when
  // a member has been added / removed / qty-edited relative to the
  // template. Date cascades from header to members happen at edit
  // time in the UI.
  packageInstanceId String?  @map("package_instance_id")
  isPackageHeader   Boolean  @default(false) @map("is_package_header")
  isPackageModified Boolean  @default(false) @map("is_package_modified")
  packageId         String?  @map("package_id")
  package           Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  assetCategory AssetCategory? @relation(fields: [assetCategoryId], references: [id])
  feeItem       FeeItem?       @relation(fields: [feeItemId], references: [id])
  // Phase 2 warehouse lane: zero-or-one PickListItem per OrderLineItem.
  // Only WAREHOUSE-lane lines get a PickListItem at book time. FLEET
  // and STAGE lines stay null.
  pickListItem  PickListItem?
  // Sub-rentals: zero-or-many vendor-sourced fulfillments for this line.
  // Internal-only — read by /admin and /sub-rentals surfaces, never by
  // any client-facing serializer (portal, quote PDF, invoice PDF).
  subRentals    SubRental[]

  @@index([packageInstanceId])
  @@index([autoKitPieceId])
  @@index([parentLineItemId])
  @@map("sr_order_line_items")
}

// Package — a curated bundle of inventory items sold at a single
// per-day price. Built in /admin/packages, surfaced in the line-
// item description combobox with a PKG badge, and expanded to a
// header line + member lines on the order.
//
// Pricing is independent of the OrderDiscount system: the header
// carries the bundle price, members are $0; order- and department-
// level discounts apply on top exactly as they do for à-la-carte
// rows.
model Package {
  id             String             @id @default(cuid())
  name           String
  description    String?            @db.Text
  department     LineItemDepartment
  pricePerDay    Decimal            @default(0) @map("price_per_day") @db.Decimal(10, 2)
  active         Boolean            @default(true)
  items          PackageItem[]
  // Back-relation for line-items minted from this package. Helps
  // analytics ("how many times has the X package been quoted?")
  // without forcing the OrderLineItem write path to carry it as a
  // required FK.
  orderLineItems OrderLineItem[]
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  @@index([active, name])
  @@map("sr_packages")
}

model PackageItem {
  id              String        @id @default(cuid())
  packageId       String        @map("package_id")
  package         Package       @relation(fields: [packageId], references: [id], onDelete: Cascade)
  inventoryItemId String        @map("inventory_item_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  qty             Int           @default(1)

  @@index([packageId])
  @@map("sr_package_items")
}

// First-class discounts on an order. Two scopes:
//   ORDER       — single grand-level discount; clamped to the
//                 department-discounted subtotal.
//   DEPARTMENT  — per LineItemDepartment; clamped to that
//                 department's line subtotal.
//
// App-layer uniqueness contract enforced in the API layer (not via
// @@unique here because the constraint is partial — one ORDER-scope
// row, and one row per departmentKey — Postgres doesn't model
// partial-unique-with-enum cleanly without an extension).
//
// Flat-total mode (UI affordance) computes an implied FIXED-value
// ORDER discount against the post-department subtotal and stores
// the result here — it's not a third type.
model OrderDiscount {
  id      String @id @default(uuid())
  orderId String @map("order_id")

  scope         DiscountScope
  // Required when scope=DEPARTMENT, must be null when scope=ORDER.
  // Uses the LineItemDepartment enum directly so an invalid value
  // can't land via the API.
  departmentKey LineItemDepartment? @map("department_key")

  type  DiscountType
  // PERCENT: 0–100 (validated app-side). FIXED: dollar amount.
  // Stored at 2 decimals to match the rest of the money columns.
  value Decimal      @db.Decimal(10, 2)

  // Surfaces on the PDF + UI row. Defaults to "Discount" so the
  // creator can ship without picking a label, but reps usually
  // type a reason (e.g. "Repeat-client courtesy").
  label String @default("Discount")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation("OrderDiscountCreator", fields: [createdById], references: [id])

  @@index([orderId])
  @@index([orderId, scope, departmentKey])
  @@map("sr_order_discounts")
}

// How a FeeItem's `amount` is applied when the fee lands on an order:
//   FLAT       — amount × quantity (quantity = count of the fee, e.g. bags)
//   PER_DAY    — amount × the order's rental days (LCDW, smoking fee)
//   PER_HOUR   — amount × hours (rep enters hours as the line quantity)
//   PER_MILE   — amount × miles (rep enters miles as the line quantity)
//   PER_GALLON — amount × gallons (refuel)
//   PERCENT    — amount is a percentage (0–100) of a rep-entered base;
//                the server computes the dollar figure at add time
enum FeeUnit {
  FLAT
  PER_DAY
  PER_HOUR
  PER_MILE
  PER_GALLON
  PERCENT
}

// First-class fee catalog (2026-07-05). Fees live OUTSIDE the inventory
// typeahead — they are not gear. A fee on an order is a normal
// OrderLineItem (type=FEE) whose price source is `feeItemId` instead of
// inventoryItemId/assetCategoryId, so all existing line-item math,
// totals, discounts, and PDF paths apply unchanged. Seeded from the RW
// pick-list fee codes (docs/cleanup/2026-07-04-rw-import-plan.csv).
model FeeItem {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  amount      Decimal  @db.Decimal(10, 2)
  unit        FeeUnit
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lineItems OrderLineItem[]

  @@map("sr_fee_items")
}

// ════════════════════════════════════════════════════════════════
// PHASE 2 — WAREHOUSE PICKING
// One PickList per Order with at least one WAREHOUSE-lane line item.
// Auto-created at book time in src/lib/orders/bookOrder.ts.
//
// Authoritative line-level status lives on OrderLineItem.pickStatus —
// Phase 3's LOADED_READY rollup scans order line items directly.
// PickListItem is the join row + per-line capture metadata (who
// scanned what, when). Keep this separation when adding fields.
//
// PARKING LOT (Phase 2.x): post-book line-item edits during ON_JOB
// don't currently sync into the PickList. If a new line item gets
// added to an order after the PickList is created, it won't appear
// in the picking floor view. Tracked as a known follow-up — see the
// TODO in bookOrder.ts and the line-item PATCH endpoints.
// ════════════════════════════════════════════════════════════════

enum PickListStatus {
  DRAFT // created at book time; no picker assigned yet
  PICKING // a warehouse user has started the pick session
  READY_TO_STAGE // all items picked; awaiting move to staging area
  STAGED // physically staged for loadout
  LOADED // loaded onto outbound transport — end of the OUTBOUND pass
  CHECKING_IN // gear is back at the dock; a checker is counting it against this list
  CHECKED_IN // every line accounted for — returned in full or written up short
  CANCELLED // order cancelled or list voided
}

model PickList {
  id               String         @id @default(uuid())
  // One PickList per Order — enforced by @unique. Aggregating multiple
  // orders into a single "today's pulls" view is a Phase 2.1 parking-lot
  // item that would layer over this without changing the model.
  orderId          String         @unique @map("order_id")
  status           PickListStatus @default(DRAFT)
  // The picker who's actively working this list. Stamped on the
  // DRAFT → PICKING transition. Stays populated through subsequent
  // states for audit even after the session ends.
  assignedToId     String?        @map("assigned_to_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  startedAt        DateTime?      @map("started_at")
  completedAt      DateTime?      @map("completed_at")
  // Inbound pass. `checkInStartedAt` stamps DRAFT-of-the-return (the
  // LOADED → CHECKING_IN transition); `checkedInAt` stamps the close.
  // Separate from startedAt/completedAt so the outbound pick timing
  // stays readable after a return has been counted over the top of it.
  checkInStartedAt DateTime?      @map("check_in_started_at")
  checkedInAt      DateTime?      @map("checked_in_at")
  checkedInById    String?        @map("checked_in_by_id")

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedTo  User?          @relation("PickListAssignedTo", fields: [assignedToId], references: [id])
  checkedInBy User?          @relation("PickListCheckedInBy", fields: [checkedInById], references: [id])
  items       PickListItem[]

  @@index([status])
  @@map("pick_lists")
}

model PickListItem {
  id              String    @id @default(uuid())
  pickListId      String    @map("pick_list_id")
  // Each OrderLineItem is in at most one PickList. The line's
  // authoritative pick state lives on OrderLineItem.pickStatus; this
  // row only carries the picker metadata.
  orderLineItemId String    @unique @map("order_line_item_id")
  // The code the picker scanned to mark this item PICKED. Typically
  // matches OrderLineItem.inventoryItem.code; null on manual-override
  // picks (items without a scannable SKU, or fallback path).
  scannedCode     String?   @map("scanned_code")
  pickedById      String?   @map("picked_by_id")
  pickedAt        DateTime? @map("picked_at")

  // ── Inbound pass ────────────────────────────────────────────────
  // How many came back. NULL = not yet counted (the only way to tell
  // "nobody has looked at this" apart from "all of it is missing",
  // which is why this is nullable rather than defaulted to 0).
  // Counted against OrderLineItem.quantity, not against a copy of it —
  // a post-book quantity edit must move the target, not orphan it.
  qtyReturned  Int?      @map("qty_returned")
  returnedById String?   @map("returned_by_id")
  returnedAt   DateTime? @map("returned_at")
  // Free text from the checker, required by the API when the count is
  // short. "3 batteries not in the case" is the whole value of the
  // feature to whoever bills the client a week later.
  returnNote   String?   @map("return_note") @db.Text

  pickList      PickList      @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  orderLineItem OrderLineItem @relation(fields: [orderLineItemId], references: [id], onDelete: Cascade)
  pickedBy      User?         @relation("PickListItemPickedBy", fields: [pickedById], references: [id])
  returnedBy    User?         @relation("PickListItemReturnedBy", fields: [returnedById], references: [id])

  @@index([pickListId])
  @@map("pick_list_items")
}

// Invoice — 1:many off Order (orderId NOT @unique). Phase 5 adds the
// `type` discriminator + PDF blob refs + line snapshot so a single
// order can carry both a primary RENTAL invoice (drives the order's
// close) and a satellite LD invoice (carries disputed high-dollar
// damage; non-blocking on the lifecycle). `Invoice.total` IS the third
// canonical money number (quote estimate → booked value → invoice
// total); never overwrite the Order.booked* snapshot from here.
model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique @map("invoice_number")
  orderId        String        @map("order_id")
  // Phase 5: RENTAL (primary) drives the close; LD (satellite, Phase 5
  // commit 4) is non-blocking. Default RENTAL for forward-compat with
  // existing zero-row table. Enum is extensible.
  type           InvoiceType   @default(RENTAL)
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  // The final number. Sum of the lineSnapshot is guaranteed to equal
  // this — when the live order's line items differ from the booked
  // snapshot, the generator emits an ADJUSTMENT line so the math
  // balances and `total` always equals the booked total at issue.
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue     Decimal       @default(0) @map("balance_due") @db.Decimal(12, 2)
  dueDate        DateTime?     @map("due_date") @db.Date
  sentAt         DateTime?     @map("sent_at")
  paidAt         DateTime?     @map("paid_at")
  notes          String?       @db.Text
  // PDF storage — mirrors the SignedAgreement / quote-pdf pattern.
  // pdfBlobKey is the Vercel Blob key (private bucket); pdfUrl is the
  // signed URL returned by put(); pdfGeneratedAt is the issuance
  // timestamp. Replace-on-regenerate: when an invoice's PDF is
  // re-rendered, the previous blob is deleted.
  pdfBlobKey     String?       @map("pdf_blob_key")
  pdfUrl         String?       @map("pdf_url")
  pdfGeneratedAt DateTime?     @map("pdf_generated_at")
  // Structured line-item snapshot at issue time. Array of
  //   { description, category, qty, unitPrice, amount,
  //     kind: 'RENTAL_LINE' | 'ADJUSTMENT' | 'DAMAGE' }
  // Stays queryable for departmental revenue reporting (PostgreSQL
  // jsonb_path), and the shape is promotable to a relational
  // InvoiceLineItem model later without breaking callers.
  lineSnapshot   Json?         @map("line_snapshot")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  order           Order            @relation(fields: [orderId], references: [id])
  payments        Payment[]
  // Phase 5 commit 4 — DamageItems and InsuranceClaims tagged with
  // this invoice. For RENTAL: BILL_NOW damages billed here. For LD:
  // the damages that drove the LD invoice + any claims opened
  // against it.
  damageItems     DamageItem[]
  insuranceClaims InsuranceClaim[]
  emailDeliveries EmailDelivery[]

  @@index([orderId, type])
  @@map("sr_invoices")
}

enum InvoiceType {
  RENTAL
  LD
}

// Phase 5 commit 3 — native payment recording. PaymentLog (free-text,
// RW-shaped) stays for legacy RW invoices; new SirReel invoices use
// this typed model. Recording a Payment auto-updates the parent
// Invoice's amountPaid / balanceDue / status and (for a fully-paid
// RENTAL invoice) advances Order INVOICED → CLOSED. Voiding a
// Payment regresses those same fields. The booked snapshot is never
// written here.
enum PaymentMethod {
  CHECK
  WIRE
  ACH
  CREDIT_CARD
  CARDPOINTE
  CASH
  OTHER
}

// Phase 6 commit 1 — payment lifecycle. Pre-Phase-6 operator payments
// (CHECK/WIRE/CASH/OTHER) write CLEARED directly; card captures write
// CLEARED on successful auth+capture; ACH originations write PENDING,
// advance to SETTLED when CardPointe confirms file submission, and
// CLEARED when funds settle. RETURNED handles NSF / bank rejection;
// FAILED is the gateway-level decline path.
//
// LINCHPIN: reconcileInvoiceTotals counts only CLEARED non-voided
// payments. PENDING / SETTLED ACH must NOT mark an invoice paid or
// advance the order to CLOSED.
enum PaymentStatus {
  PENDING
  SETTLED
  CLEARED
  RETURNED
  FAILED
}

model Payment {
  id                        String        @id @default(uuid())
  invoiceId                 String        @map("invoice_id")
  // The amount applied to this invoice. Always > 0 — voids are tracked
  // via voidedAt, never by negative amounts (keeps SUM() math correct
  // when filtered to non-voided rows).
  amount                    Decimal       @db.Decimal(12, 2)
  method                    PaymentMethod
  // Phase 6 lifecycle. CLEARED is the only state that counts toward
  // invoice paid/balance. Default CLEARED for backward-compat with
  // existing operator-recorded payments (CHECK/WIRE/CASH/OTHER) which
  // are always "received" by the time they're entered.
  status                    PaymentStatus @default(CLEARED)
  // Card processing surcharge (3%) added ON TOP of `amount` at the
  // gateway. `amount` is what credits the invoice; the gateway actually
  // charged `amount + surchargeAmount`. Null for non-surcharged payments
  // (cash/check/wire, or card charges taken before surcharging began).
  // Reversals must refund `amount + surchargeAmount`.
  surchargeAmount           Decimal?      @map("surcharge_amount") @db.Decimal(10, 2)
  // Operator-supplied reference: check #, wire confirmation, etc.
  // Free-text by design.
  reference                 String?
  // Phase 6 — CardPointe transaction id (retref). Distinct from
  // `reference` so gateway txn ids stay queryable without polluting
  // the free-text column.
  gatewayRefId              String?       @map("gateway_ref_id")
  receivedAt                DateTime      @map("received_at")
  // Phase 6 ACH timestamps. Card captures stamp settledAt + clearedAt
  // = now() on the same write since auth+capture is instant; ACH
  // walks them out across the polling lifecycle.
  settledAt                 DateTime?     @map("settled_at")
  clearedAt                 DateTime?     @map("cleared_at")
  returnedAt                DateTime?     @map("returned_at")
  returnReason              String?       @map("return_reason") @db.Text
  // Phase 6 NACHA authorization — ACH-only; captured via SigCanvas
  // alongside the consent text shown to the payer at the moment of
  // authorization. Stored on the row so the auth artifact is co-
  // located with the payment it authorized.
  nachaAuthSignatureData    String?       @map("nacha_auth_signature_data") @db.Text
  nachaAuthText             String?       @map("nacha_auth_text") @db.Text
  nachaAuthSignedAt         DateTime?     @map("nacha_auth_signed_at")
  notes                     String?       @db.Text
  // Phase 6 portal attribution. Operator-recorded payments set
  // recordedById; portal-initiated payments set
  // initiatedByPortalAccessId. Exactly one of the two must be set —
  // enforced at the application layer (Prisma can't express XOR via
  // schema alone; the recordPayment helper guards this).
  recordedById              String?       @map("recorded_by_id")
  initiatedByPortalAccessId String?       @map("initiated_by_portal_access_id")
  voidedAt                  DateTime?     @map("voided_at")
  voidedById                String?       @map("voided_by_id")
  voidReason                String?       @map("void_reason") @db.Text
  createdAt                 DateTime      @default(now()) @map("created_at")

  invoice                 Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy              User?         @relation("PaymentRecorder", fields: [recordedById], references: [id])
  voidedBy                User?         @relation("PaymentVoider", fields: [voidedById], references: [id])
  initiatedByPortalAccess PortalAccess? @relation("PortalInitiatedPayments", fields: [initiatedByPortalAccessId], references: [id])

  @@index([invoiceId])
  @@index([receivedAt])
  @@index([invoiceId, voidedAt])
  // Phase 6 — polling job pulls PENDING/SETTLED ACH rows; status index
  // keeps that scan tight as payment volume grows.
  @@index([status])
  @@index([initiatedByPortalAccessId])
  @@map("sr_payments")
}

model Vendor {
  id          String  @id @default(uuid())
  name        String  @unique
  contactName String? @map("contact_name")
  email       String?
  phone       String? @db.VarChar(30)
  website     String?
  notes       String? @db.Text

  // --- Sub-rental Phase A additions (roster fields for later PO /
  // shortfall-sourcing / margin phases; no PO or margin logic here) ---
  // Mailing / pickup address — free text (multi-line ok).
  address       String? @db.Text
  // Where purchase-orders / sub-rental requests get sent. Falls back to
  // `email` (primary contact) at read time when null — see the vendors
  // API serializer. Kept distinct because AP / ordering desks often
  // differ from the day-to-day contact.
  poEmail       String? @map("po_email")
  // What this vendor sources — free text for now (e.g. "grip, dolly,
  // lighting"). Phase B shortfall matching may promote this to tags;
  // starting simple on purpose.
  supplies      String? @db.Text
  // Standing delivery / pickup terms shown on a PO (lead time, cutoffs,
  // dock hours). Distinct from general `notes`.
  deliveryTerms String? @map("delivery_terms") @db.Text

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  subRentals            SubRental[]
  // Reverse relation: InventoryItems with this vendor as their
  // preferred reorder source. Same Vendor table feeds both
  // sub-rentals (Hugo's flow) and the inventory reorder picker.
  inventoryItems        InventoryItem[]
  // Partner-owned production vehicles this vendor sub-contracts to
  // SirReel (King Kong PV etc.) — see SubcontractedVehicle.
  subcontractedVehicles SubcontractedVehicle[]
  // This vendor's standing ancillary-fee schedule (driver, mileage,
  // generator, supplies) — rows with vehicleId NULL apply fleet-wide.
  subcontractedFees     SubcontractedFee[]

  @@map("vendors")
}

enum SubRentalStatus {
  /// "Potential" — we have quoted this unit to a client for these dates but
  /// nobody has committed. The vendor is TOLD (so they know their calendar is
  /// being pitched) without it holding anything. Becomes REQUESTED when the
  /// client accepts, which is what prompts the vendor for driver details.
  ESTIMATED
  REQUESTED
  CONFIRMED
  PICKED_UP
  ON_RENT
  RETURNED
  CANCELLED
}

/// How Hugo's team takes custody of a sub-rented item from the vendor.
/// PICKUP  = SirReel goes to the vendor to collect.
/// DELIVERY = vendor drops at SirReel's location.
/// Drives Phase 2 "receive from vendor" logistics (not built yet).
enum ReceiveMethod {
  PICKUP
  DELIVERY
}

model SubRental {
  id              String          @id @default(uuid())
  orderId         String?         @map("order_id")
  /// Optional direct link to the OrderLineItem this sub-rental fulfills.
  /// One line can have multiple sub-rentals (partial fulfillment by qty).
  /// Internal-only — never read by client-facing serializers.
  orderLineItemId String?         @map("order_line_item_id")
  inventoryItemId String?         @map("inventory_item_id")
  vendorId        String          @map("vendor_id")
  status          SubRentalStatus @default(REQUESTED)
  /// How Hugo's team takes custody from the vendor — surfaced on the
  /// returns board in Phase 3. Nullable until set at create time.
  receiveMethod   ReceiveMethod?  @map("receive_method")

  itemDescription String    @map("item_description")
  quantity        Int       @default(1)
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date

  vendorDailyRate  Decimal? @map("vendor_daily_rate") @db.Decimal(10, 2)
  vendorWeeklyRate Decimal? @map("vendor_weekly_rate") @db.Decimal(10, 2)
  vendorTotal      Decimal? @map("vendor_total") @db.Decimal(12, 2)

  clientDailyRate  Decimal? @map("client_daily_rate") @db.Decimal(10, 2)
  clientWeeklyRate Decimal? @map("client_weekly_rate") @db.Decimal(10, 2)
  clientTotal      Decimal? @map("client_total") @db.Decimal(12, 2)

  poNumber String? @map("po_number")
  notes    String? @db.Text

  /// The job this sub-rental belongs to. SubRental historically reached a job
  /// only THROUGH an order, but a quote exists before any order does — so an
  /// estimated sub-rental hangs off the job directly and picks up an order
  /// later, when there's something to invoice.
  jobId String? @map("job_id")

  /// The roster unit being sub-rented, when it is one of ours to quote from.
  /// `itemDescription` stays the human label (and the only thing set for
  /// ad-hoc gear sub-rentals, which have no roster row).
  subcontractedVehicleId String? @map("subcontracted_vehicle_id")

  /// Unlisted VENDOR page (/vendor/[token]) — the partner's own view of this
  /// booking: which unit, which dates, where it stands. It is the conduit:
  /// the vendor never sees who the client is, and the client never sees whose
  /// unit it is. Later this is where location, call time and driver details
  /// get exchanged, still without the two sides talking directly.
  vendorToken           String?   @unique @map("vendor_token")
  vendorTokenMintedAt   DateTime? @map("vendor_token_minted_at")
  /// When the vendor was told we had quoted these dates.
  vendorNotifiedAt      DateTime? @map("vendor_notified_at")
  /// When the vendor was asked to actually HOLD the dates — stamped on the
  /// client-approval hook, and only once that notice really left. Distinct
  /// from the status flip on purpose: approval moves the row to REQUESTED
  /// whether or not the mail sends, so `status = REQUESTED AND
  /// vendorHoldRequestedAt IS NULL` is exactly the set a human still has to
  /// phone. Without it a failed send is indistinguishable from a delivered
  /// one and the vendor silently never hears.
  vendorHoldRequestedAt DateTime? @map("vendor_hold_requested_at")

  // ── Driver relay ─────────────────────────────────────────────────────────
  // The vendor names a driver on their page; HQ then mints a relay address so
  // production and that driver can exchange directions, call sheets and call
  // times WITHOUT either learning the other's address. Mail to the relay lands
  // in jobs@ (a watched mailbox), is ingested like any other message — which is
  // what makes it visible to us — and is forwarded on to driverEmail.
  driverName       String?   @map("driver_name")
  driverEmail      String?   @map("driver_email")
  driverPhone      String?   @map("driver_phone") @db.VarChar(30)
  driverAssignedAt DateTime? @map("driver_assigned_at")

  /// The plus-tag half of the relay address: jobs+{relayTag}@sirreel.com.
  /// Gmail routes ONLY `+suffix` back to the base mailbox, so the tag lives
  /// after the plus rather than in a prettier dotted local part — a different
  /// local part would need its own Workspace alias (which breaks the DWD
  /// ingest path) or a catch-all routing rule.
  relayTag String? @unique @map("relay_tag")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order                Order?                @relation(fields: [orderId], references: [id])
  job                  Job?                  @relation(fields: [jobId], references: [id])
  subcontractedVehicle SubcontractedVehicle? @relation(fields: [subcontractedVehicleId], references: [id])
  orderLineItem        OrderLineItem?        @relation(fields: [orderLineItemId], references: [id])
  inventoryItem        InventoryItem?        @relation(fields: [inventoryItemId], references: [id])
  vendor               Vendor                @relation(fields: [vendorId], references: [id])

  /// Returns board sort + filter: status × end-date so the "due back
  /// soonest" view is a single index seek.
  @@index([status, endDate])
  /// Per-line lookup for the order-detail UI's "sub-rentals on this
  /// line" surface.
  @@index([orderLineItemId])
  @@index([jobId])
  @@index([subcontractedVehicleId])
  @@map("sub_rentals")
}

// ── Subcontracted vehicles ─────────────────────────────────────────
// Standing roster of production vehicles SirReel does NOT own — a
// partner vendor's unit (first: King Kong Production Vehicles) that
// sales can quote out on demand. Tracks the vendor's list-rate
// structure and SirReel's negotiated discount off it. Deliberately
// NOT part of the fleet: no Asset row, no maintenance, no dispatch —
// fleet roles never manage these. Sales/billing/admin surface only
// (subRentals + seePricing gate — see requireSubVehicleAccess).
// Distinct from SubRental, which is a per-order sourcing TRANSACTION;
// this is the persistent catalog a transaction may start from.
model SubcontractedVehicle {
  id       String @id @default(uuid())
  vendorId String @map("vendor_id")

  name        String // e.g. "2-Room Star Wagon"
  // Free-text category (e.g. "Star Trailer", "Honeywagon", "Fuel
  // Truck"). Deliberately NOT the AssetCategory/InventoryItem taxonomy
  // — these units live outside the owned-fleet catalogs.
  vehicleType String? @map("vehicle_type")
  description String? @db.Text
  // Free-form spec sheet, one spec per line (length, slide-outs,
  // generator, tow requirements...).
  specs       String? @db.Text

  // The vendor's LIST price structure — what they charge retail.
  listDailyRate   Decimal? @map("list_daily_rate") @db.Decimal(10, 2)
  listWeeklyRate  Decimal? @map("list_weekly_rate") @db.Decimal(10, 2)
  listMonthlyRate Decimal? @map("list_monthly_rate") @db.Decimal(10, 2)
  // Structure nuances three numbers can't hold: 3-day rental weeks,
  // delivery/driver fees, fuel, damage waiver, minimums.
  rateNotes       String?  @map("rate_notes") @db.Text

  // SirReel's negotiated discount off list, in percent (25.00 = 25%).
  // Net cost is DERIVED at read time (list × (1 − discount/100)) and
  // never stored, so a renegotiated discount can't strand stale
  // numbers.
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// UNLISTED client-facing page. NULL = no page exists. Non-null mints
  /// /unit/[token] — reachable by anyone holding the link, linked from
  /// nowhere on the public site, noindex, and absent from the sitemap.
  /// The token IS the credential (32 bytes hex), so clearing it revokes
  /// the page instantly. Deliberately NOT a readable slug: a guessable
  /// URL is a listed URL.
  ///
  /// The page it serves NEVER renders money. Rates on this model are the
  /// vendor's list price and OUR negotiated discount; the public loader
  /// (publicUnit.ts) selects an explicit non-rate field set so a future
  /// `include` can't quietly leak cost or margin to a client.
  publicToken         String?   @unique @map("public_token")
  publicTokenMintedAt DateTime? @map("public_token_minted_at")

  /// LISTED in the public catalog at /vehicles/{publicSlug} — the other half
  /// of the unlisted token above, and a separate decision from it. Unlisted =
  /// only people we send the link to; listed = anyone browsing the site.
  ///
  /// A listed subcontracted unit still never names its vendor: the catalog
  /// serializer selects no vendor field, exactly as the unlisted page doesn't.
  /// Clients are quoted LIST, so the catalog price is the list rate — showing
  /// it discloses nothing about what we pay.
  publiclyListed Boolean @default(false) @map("publicly_listed")
  publicSlug     String? @unique @map("public_slug")

  /// Client-facing blurb for the unlisted page. SEPARATE from `description`
  /// on purpose: that field is written for staff and carries operational
  /// caveats ("confirm the hold before committing dates to a client"), which
  /// is exactly the sentence a client must never read. Rendering description
  /// on the public page failed OPEN — every future unit would leak whatever
  /// note someone happened to type. NULL renders no blurb at all.
  publicDescription String? @map("public_description") @db.Text

  vendor     Vendor                      @relation(fields: [vendorId], references: [id])
  fees       SubcontractedFee[]
  photos     SubcontractedVehiclePhoto[]
  subRentals SubRental[]

  @@index([vendorId])
  @@map("sub_contracted_vehicles")
}

/// Which labor bracket a fee applies to. Most fees (mileage, fuel,
/// supplies) are ALL — the union question doesn't arise. Driver labor
/// splits, and as of 2026-08-28 only the NON_UNION side is known
/// (Wes: "I'll get you Union Rates later"), so a UNION job quoted off
/// this roster shows a deliberate gap rather than a wrong number.
enum SubFeeUnionScope {
  ALL
  NON_UNION
  UNION
}

// Ancillary fees on a subcontracted rental — what the partner charges
// ON TOP of the vehicle's day/week rate (driver, mileage, generator
// hours, supplies). Sales needs these at quote time; without them a
// King Kong quote is short by the majority of a real day's cost.
//
// SCOPE: vehicleId NULL = the vendor's standing schedule, applying to
// every one of their units (mileage and supplies work this way).
// vehicleId SET = an override/addition for that unit alone (a
// generator fee is meaningless on a unit with no generator). Readers
// union the two, vehicle-specific winning on a same-label collision.
//
// Reuses the FeeUnit enum from the order-side fee catalog rather than
// forking a near-identical one — PER_DAY/PER_HOUR/PER_MILE mean the
// same thing on both sides of the ledger. `coversHours` carries the
// qualifier a bare unit can't: the driver is $550 PER_DAY *covering
// 10 hours*, not $550 for an open-ended day.
model SubcontractedFee {
  id        String  @id @default(uuid())
  vendorId  String  @map("vendor_id")
  vehicleId String? @map("vehicle_id")

  label  String // "Driver", "Mileage", "Generator usage", "Supplies"
  amount Decimal @db.Decimal(10, 2)
  unit   FeeUnit

  /// Hours the amount covers, for shift-priced labor ($550 / 10 hrs).
  /// NULL for everything metered continuously (per-mile, per-hour).
  coversHours Decimal?         @map("covers_hours") @db.Decimal(5, 2)
  unionScope  SubFeeUnionScope @default(ALL) @map("union_scope")

  /// Whether our negotiated discount comes off this fee too. Defaults
  /// FALSE: ancillaries are normally pass-through and the discount is
  /// off the vehicle rate. Per-fee rather than global because that
  /// varies by vendor and is a term worth recording explicitly.
  discountApplies Boolean @default(false) @map("discount_applies")

  notes     String?  @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vendor  Vendor                @relation(fields: [vendorId], references: [id])
  vehicle SubcontractedVehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([vehicleId])
  @@map("sub_contracted_fees")
}

// Gallery photos for a subcontracted vehicle — the point is quoting:
// Wes sends clients a unit they can SEE without waiting on the
// partner to email pictures. Same storage contract as
// VehicleCategoryPhoto: `url` is a PRIVATE blob written by
// uploadPrivateImage and is served ONLY through the gated proxy at
// /api/sub-rentals/vehicles/[id]/photos/[photoId], never raw.
// Exactly one photo per vehicle is primary (enforced in the API).
model SubcontractedVehiclePhoto {
  id        String               @id @default(uuid())
  vehicleId String               @map("vehicle_id")
  vehicle   SubcontractedVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int                  @default(0) @map("sort_order")
  isPrimary Boolean              @default(false) @map("is_primary")
  createdAt DateTime             @default(now()) @map("created_at")

  @@index([vehicleId])
  @@map("sub_contracted_vehicle_photos")
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
  BOOKING_NOTE
}

// OutreachActivity — field-rep outreach log (Oliver's outside-sales
// flow). Separate from the legacy Activity model on purpose: this is
// "I had a touchpoint with this contact" with a typed channel and an
// optional follow-up, mobile-first. The FOLLOW-UPS DUE card on /crm
// aggregates open follow-ups from BOTH this model AND the existing
// Activity model so neither stream is lost. App-layer constraint:
// at least one of personId / companyId must be set on insert.
enum OutreachType {
  VISIT // in-person visit to set / studio / office
  CALL // phone call
  EMAIL // outbound email logged manually (NOT auto-synced Gmail)
  TEXT // SMS
  EVENT // mixer, wrap party, industry event
  DROP_IN // unscheduled drop-by (lobby / craft services / etc.)
}

model OutreachActivity {
  id         String       @id @default(uuid())
  type       OutreachType
  personId   String?      @map("person_id")
  companyId  String?      @map("company_id")
  notes      String       @db.Text
  occurredAt DateTime     @default(now()) @map("occurred_at")

  // Optional follow-up — when set, this row counts toward the
  // FOLLOW-UPS DUE card until followUpDone flips true. Indexed on
  // (followUpDone, followUpAt) so the count query is cheap.
  followUpAt   DateTime? @map("follow_up_at")
  followUpDone Boolean   @default(false) @map("follow_up_done")

  // The rep who logged this. Drives the "My outreach" filter (sales
  // reps see their own + their due follow-ups; admins see all).
  createdById String @map("created_by_id")
  createdBy   User   @relation("OutreachCreator", fields: [createdById], references: [id])

  person  Person?  @relation("PersonOutreach", fields: [personId], references: [id], onDelete: SetNull)
  company Company? @relation("CompanyOutreach", fields: [companyId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([followUpDone, followUpAt])
  @@index([createdById, occurredAt(sort: Desc)])
  @@index([personId, occurredAt(sort: Desc)])
  @@index([companyId, occurredAt(sort: Desc)])
  @@map("sr_outreach_activities")
}

/// ContactSegment — a NAMED, reusable targeting filter on /crm People.
///
/// "LA line producers we haven't quoted since January" should be a thing
/// you click, not a search you rebuild from memory every Monday. Phase 1
/// of the outreach build (see the plan artifact); Phase 3 composes a send
/// against one of these.
///
/// The filter is stored as typed COLUMNS rather than a JSON blob on
/// purpose: Phase 3 has to resolve a segment to a recipient list on the
/// server, and a blob would make that a parse-and-hope. Adding a filter
/// dimension is a migration, which is the correct amount of friction for
/// something that decides who gets emailed.
/// A named, reusable multi-step sequence.
///
/// Phase 4. A campaign is one send to a list; a touch plan is a
/// relationship over weeks — day 0 intro, day 4 case study, day 12
/// check-in — that stops the moment the person engages.
model TouchPlan {
  id          String  @id @default(uuid())
  name        String  @unique
  description String? @db.Text
  /// Off by default. A plan that can enrol people the moment it is saved
  /// is a plan that mails someone because a rep was still drafting it.
  isActive    Boolean @default(false) @map("is_active")

  createdById String @map("created_by_id")
  createdBy   User   @relation("TouchPlanCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  steps       TouchPlanStep[]
  enrollments TouchPlanEnrollment[]

  @@map("sr_touch_plans")
}

/// One step of a plan.
///
/// `dayOffset` is days from ENROLMENT, not from the previous step, so
/// reordering or editing one step cannot silently shift everything after
/// it into a different week.
model TouchPlanStep {
  id     String    @id @default(uuid())
  planId String    @map("plan_id")
  plan   TouchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  /// Days after enrolment this step becomes due. Step one is normally 0.
  dayOffset    Int    @map("day_offset")
  subject      String
  /// Same merge syntax as a campaign — see src/lib/outreach/mergeFields.ts.
  bodyTemplate String @map("body_template") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sends TouchPlanSend[]

  @@unique([planId, dayOffset])
  @@index([planId])
  @@map("sr_touch_plan_steps")
}

enum EnrollmentStatus {
  ACTIVE
  /// Every step sent, nobody engaged. The plan ran its course.
  COMPLETED
  /// Stopped early — see exitReason. This is the GOOD outcome for a
  /// sequence: it means the person responded.
  EXITED
}

/// Why an enrolment stopped.
///
/// Every one of these except PLAN_FINISHED means "stop mailing this
/// person NOW" — the whole point of a sequence is that it notices when
/// it has worked and gets out of the way.
enum EnrollmentExitReason {
  /// They wrote back. The sequence did its job.
  REPLIED
  /// An Inquiry was created for them after enrolment.
  INQUIRY
  /// An order was raised against their company after enrolment.
  ORDER
  /// They unsubscribed, bounced, or complained.
  SUPPRESSED
  /// A human stopped it.
  MANUAL
  /// Ran out of steps without engagement.
  PLAN_FINISHED
}

/// One person's run through one plan.
model TouchPlanEnrollment {
  id     String    @id @default(uuid())
  planId String    @map("plan_id")
  plan   TouchPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  personId String @map("person_id")
  person   Person @relation("TouchPlanEnrollee", fields: [personId], references: [id], onDelete: Cascade)

  status     EnrollmentStatus      @default(ACTIVE)
  exitReason EnrollmentExitReason? @map("exit_reason")
  exitDetail String?               @map("exit_detail")

  /// The rep the sequence sends AS, and whose daily cap it spends.
  ownerId String @map("owner_id")
  owner   User   @relation("TouchPlanOwner", fields: [ownerId], references: [id])

  enrolledAt DateTime  @default(now()) @map("enrolled_at")
  exitedAt   DateTime? @map("exited_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sends TouchPlanSend[]

  /// One live run per person per plan. A person may be re-enrolled after
  /// exiting, so this is NOT unique on (plan, person) — the runner and
  /// the enrol API both refuse a second ACTIVE row instead.
  @@index([status, planId])
  @@index([personId, status])
  @@map("sr_touch_plan_enrollments")
}

/// One step actually sent to one enrolee.
///
/// Exists so a step can never be sent twice: the unique key is the
/// idempotency guarantee, the same way campaign recipients work.
model TouchPlanSend {
  id           String              @id @default(uuid())
  enrollmentId String              @map("enrollment_id")
  enrollment   TouchPlanEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stepId       String              @map("step_id")
  step         TouchPlanStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)

  sentAt          DateTime @default(now()) @map("sent_at")
  resendMessageId String?  @map("resend_message_id")
  /// Null on success; the failure reason otherwise.
  error           String?

  @@unique([enrollmentId, stepId])
  @@index([sentAt])
  @@map("sr_touch_plan_sends")
}

enum OutreachCampaignStatus {
  /// Being written. Nothing has left the building.
  DRAFT
  /// Sampled and released; the runner is working through recipients.
  SENDING
  /// Every recipient reached a terminal state.
  SENT
  /// A human stopped it mid-flight. Recipients already sent stay sent.
  CANCELLED
}

enum OutreachRecipientStatus {
  PENDING
  SENT
  /// Held back before sending — suppressed, or trimmed by a daily cap.
  /// Distinct from FAILED: nothing went wrong, we chose not to send.
  SKIPPED
  /// The provider refused it. `error` carries why.
  FAILED
}

/// One outreach send to a segment.
///
/// Phase 3. The campaign row is a SNAPSHOT, not a live query: it stores
/// the resolved recipient list at release time rather than re-running the
/// segment when the runner gets there. A segment is a moving target —
/// contacts get captured every hour — and "who did we actually mail" must
/// be answerable months later, when the segment would return a different
/// set entirely.
model OutreachCampaign {
  id     String                 @id @default(uuid())
  name   String
  status OutreachCampaignStatus @default(DRAFT)

  /// What the rep picked, kept for provenance. The recipient rows are
  /// the truth about who was mailed; these say where they came from.
  segmentKey     String? @map("segment_key")
  roleKey        String? @map("role_key")
  search         String?
  savedSegmentId String? @map("saved_segment_id")

  subject      String
  /// Body with merge tokens still in it, exactly as written. Rendering
  /// happens per recipient at send time so a template edit before
  /// release changes every unsent copy and nothing already sent.
  bodyTemplate String @map("body_template") @db.Text

  /// Sender identity at release. Stored because the outreach subdomain
  /// may change and "what did this go out as" must stay answerable.
  fromName    String? @map("from_name")
  fromAddress String? @map("from_address")
  replyTo     String? @map("reply_to")

  createdById String @map("created_by_id")
  createdBy   User   @relation("OutreachCampaignCreator", fields: [createdById], references: [id])

  releasedAt  DateTime? @map("released_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  recipients OutreachCampaignRecipient[]

  @@index([status, createdAt(sort: Desc)])
  @@map("sr_outreach_campaigns")
}

/// One intended recipient of one campaign.
///
/// This table is what makes a send IDEMPOTENT. The unique key on
/// (campaignId, personId) means a retried or double-clicked release can
/// never mail the same person twice, and a runner that dies halfway can
/// resume by looking for PENDING rows rather than starting over.
///
/// `renderedSubject` / `renderedBody` are stored per recipient. That is
/// deliberate duplication: when a client asks "what exactly did you send
/// me", the answer has to be the bytes they received, not a template we
/// would re-render today against data that has since changed.
model OutreachCampaignRecipient {
  id         String           @id @default(uuid())
  campaignId String           @map("campaign_id")
  campaign   OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  personId String @map("person_id")
  person   Person @relation("OutreachCampaignRecipient", fields: [personId], references: [id], onDelete: Cascade)
  /// Address at send time. Kept separately from Person.email because a
  /// contact may change address later and the audit must not move.
  email    String

  status OutreachRecipientStatus @default(PENDING)
  /// Why a SKIPPED row was skipped, or why a FAILED row failed.
  reason String?

  renderedSubject String? @map("rendered_subject")
  renderedBody    String? @map("rendered_body") @db.Text

  /// Links to the delivery audit + the Resend message, so bounce and
  /// complaint webhooks can be traced back to the campaign that caused
  /// them. This is how a campaign's real deliverability becomes visible.
  resendMessageId String?   @map("resend_message_id")
  sentAt          DateTime? @map("sent_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([campaignId, personId])
  @@index([campaignId, status])
  @@index([resendMessageId])
  @@map("sr_outreach_campaign_recipients")
}

/// Why an address may no longer be sent marketing mail.
///
/// Ordered from "they told us" to "the mail system told us". All are
/// permanent by default — see EmailSuppression.
enum SuppressionReason {
  /// Clicked the unsubscribe link, or asked a rep and we recorded it.
  UNSUBSCRIBED
  /// Hard bounce: the address does not exist. Continuing to send to it
  /// is the single fastest way to wreck a sending domain's reputation.
  BOUNCED
  /// Marked us as spam. The most expensive signal a mailbox provider
  /// can give us, and the one we must never ignore.
  COMPLAINED
  /// A human added it deliberately (a competitor, a journalist, a
  /// client who asked verbally).
  MANUAL
}

/// The suppression list — the single gate every outreach send must pass.
///
/// Keyed on EMAIL, not on Person, for two reasons that both matter:
///
///   1. Bounces and complaints arrive from Resend for addresses that may
///      have no Person row at all. A person-keyed list would silently
///      drop exactly the signals that protect the domain.
///   2. Suppression must outlive the contact. Deleting or merging a
///      Person must never un-suppress an address someone unsubscribed.
///
/// Nothing here expires on its own. Releasing a suppression is a
/// deliberate, attributed human act (releasedAt + releasedById), and a
/// released row is KEPT rather than deleted so the history of "we
/// suppressed this, then let it back in, and who decided that" survives.
///
/// Phase 2 of the outreach build. Phase 3 cannot send without consulting
/// this — see src/lib/outreach/sendGuard.ts.
model EmailSuppression {
  id     String            @id @default(uuid())
  /// Lowercased + trimmed at every write. Postgres unique indexes are
  /// case-sensitive, so an un-normalized "Wes@" would slip past a
  /// suppression on "wes@" — the same bug that once produced duplicate
  /// Person rows (see src/lib/people/email.ts).
  email  String            @unique
  reason SuppressionReason
  /// Free text: the bounce string from the provider, or what the client
  /// said. Shown to staff, never to the client.
  detail String?           @db.Text
  /// Where it came from: 'resend-webhook', 'portal', 'staff:<email>',
  /// 'import'. Free-form so a new origin doesn't need a migration.
  source String?

  /// Set when the address maps to a known contact. Nullable and
  /// SetNull-on-delete: the suppression stands even if the Person goes.
  personId String? @map("person_id")
  person   Person? @relation("PersonSuppressions", fields: [personId], references: [id], onDelete: SetNull)

  suppressedAt DateTime  @default(now()) @map("suppressed_at")
  /// Non-null means a human deliberately let this address back in.
  releasedAt   DateTime? @map("released_at")
  releasedById String?   @map("released_by_id")
  releasedBy   User?     @relation("SuppressionReleaser", fields: [releasedById], references: [id])
  releaseNote  String?   @map("release_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([releasedAt])
  @@index([reason])
  @@map("sr_email_suppressions")
}

model ContactSegment {
  id   String @id @default(uuid())
  name String

  /// PeopleSegmentKey (src/lib/crm/peopleSegments.ts) or null.
  segmentKey String? @map("segment_key")
  /// PersonRole value or null.
  roleKey    String? @map("role_key")
  /// Free-text search term or null.
  search     String?

  /// Visible to the whole team. Private segments are a later concern;
  /// today the sales book is shared and hiding a list helps nobody.
  isShared Boolean @default(true) @map("is_shared")

  createdById String @map("created_by_id")
  createdBy   User   @relation("ContactSegmentCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// One segment per name per creator — re-saving the same name updates
  /// rather than quietly creating a second identical chip.
  @@unique([createdById, name])
  @@index([isShared, name])
  @@map("sr_contact_segments")
}

model Activity {
  id          String       @id @default(uuid())
  companyId   String?      @map("company_id")
  personId    String?      @map("person_id")
  bookingId   String?      @map("booking_id")
  agentId     String       @map("agent_id")
  type        ActivityType @default(NOTE)
  subject     String?
  body        String       @db.Text
  dueDate     DateTime?    @map("due_date") @db.Date
  completed   Boolean      @default(false)
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id])
  person  Person?  @relation(fields: [personId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  agent   User     @relation("ActivityAgent", fields: [agentId], references: [id])

  @@map("activities_crm")
