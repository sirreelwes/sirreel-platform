  BOOKING_INQUIRY
  RENTAL_REQUEST
  SUPPORT
  BILLING
  COMPLAINT
  FLEET_ISSUE
  GENERAL
  SPAM
}

enum EmailStatus {
  UNREAD
  TRIAGED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  ARCHIVED
