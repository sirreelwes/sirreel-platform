// 12. USERS & AUTH
// ═══════════════════════════════════════

enum UserRole {
  ADMIN
  MANAGER
  AGENT
  // Collections / accounts-receivable role (Ana, primary). Distinct from
  // AGENT so billing exceptions (payment-info follow-ups, future overdue
  // chases) scope to BILLING + admin, NOT to every sales agent. Any
  // number of users may hold it — a second holder is just User.role=BILLING.
  BILLING
  // DISPATCHER is retired/vestigial: no users hold it, the `dispatch` perm is
  // gone, and all its gates were repointed to canAssignAssets. The enum VALUE
  // is intentionally kept — dropping it requires a full Postgres enum-type
  // recreation that rewrites the users.role column (deferred; Wes to decide).
  DISPATCHER
  FLEET_TECH
  // Warehouse picking floor (Phase 2 of the 2026-08 reservations
  // rollout). Operates pick sessions + observes the board read-only
  // (company, job name, drivers — no client contacts, no pricing).
  // First intended holder: Chris Valencia (account deferred — on
  // leave as of 2026-08-21).
  WAREHOUSE
  DRIVER
  CLIENT
}

// Phase 6.5 — data-scope axis. TEAM (default) is "see the whole
// org's pipeline / orders / jobs / inquiries"; OWN is "see only
// rows where I'm the agent / assignee." Independent of role and
// of User.salesOnly — surface and data axes are separate.
enum DataScope {
  TEAM
  OWN
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  name               String
  role               UserRole  @default(AGENT)
  // Phase 6.5 — surface scoping. AGENTs split into accounting (Ana)
  // and sales-only (Jose, Oliver). When salesOnly is true, the
  // permissions layer overrides off the operational sections (fleet,
  // dispatch, maintenance, scheduling, inventory, sub-rentals, the
  // bookings-gated tools) AND billing. Ana stays salesOnly=false so
  // her billing access is preserved. Separate from `dataScope` —
  // surface vs data are independent axes.
  salesOnly          Boolean   @default(false) @map("sales_only")
  // Phase 6.5 — data scoping. TEAM sees the whole org's pipeline /
  // orders / jobs / inquiries; OWN is restricted to rows where the
  // requesting user is the agent (or, for inquiries, the assignee).
  // Server-side list endpoints honor this via the requireScope helper.
  // Default TEAM preserves today's behavior for every existing user.
  dataScope          DataScope @default(TEAM) @map("data_scope")
  // Client-facing title (e.g. "COO", "Owner", "Sales Lead"). Separate from
  // `role` which is access-control / permission scope. The portal Job Page
  // shows displayTitle on the "Your SirReel Team" card; if null, the card
  // falls back to a generic label.
  displayTitle       String?   @map("display_title") @db.VarChar(60)
  phone              String?   @db.VarChar(30)
  // After-hours emergency escalation: staff flagged here are surfaced BY
  // PHONE (emergencyPhone) to a caller who declares a genuine emergency to
  // the assistant. Numbers are released server-side only, never in the AI
  // prompt. Managed at /admin/assistant.
  isEmergencyContact Boolean   @default(false) @map("is_emergency_contact")
  emergencyPhone     String?   @map("emergency_phone") @db.VarChar(30)
  avatarUrl          String?   @map("avatar_url")
  location           Location? // Home base
  isActive           Boolean   @default(true) @map("is_active")

  // Agent-shareable public-intake handle. Lowercased first name by
  // convention (e.g. "jose", "oliver") — populated by the seed script
  // at scripts/seed-agent-slugs.ts. Used to attribute web-form
  // inquiries: /intake/<publicSlug> sets Inquiry.assignedToId to this
  // user on submit (validated server-side: isActive + role=AGENT).
  publicSlug String? @unique @map("public_slug")

  // Link to person if client portal user
  personId String? @unique @map("person_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")

  // Relations
  person                   Person?               @relation("ContactUser", fields: [personId], references: [id])
  assignedPeople           Person[]              @relation("PersonAgent")
  agentBookings            Booking[]             @relation("BookingAgent")
  defaultForCompanies      Company[]             @relation("DefaultAgent")
  emailAccounts            EmailAccount[]
  inspections              Inspection[]          @relation("InspectedBy")
  checkoutsProcessed       CheckoutRecord[]      @relation("CheckedOutBy")
  maintenanceCreated       MaintenanceRecord[]   @relation("MaintCreatedBy")
  assignedClaims           InsuranceClaim[]      @relation("ClaimAssignee")
  uploadedDocs             ClaimDocument[]       @relation("DocUploader")
  timelineActions          ClaimTimeline[]       @relation("TimelineActor")
  reviewedClaimMail        ClaimMail[]           @relation("ClaimMailReviewer")
  createdOrderDiscounts    OrderDiscount[]       @relation("OrderDiscountCreator")
  createdCompanyRates      CompanyRate[]         @relation("CompanyRateCreator")
  createdIncidents         Incident[]            @relation("IncidentCreator")
  assignedIncidents        Incident[]            @relation("IncidentAssignee")
  // HR back-relations. employee is the 0-or-1 Employee row for staff
  // who happen to also have an HQ login — most do. reviewedHrMail is
  // every HR triage decision this user stamped. Access to HR data
  // itself is gated by src/lib/hr/allowlist.ts, NOT by these
  // relations — having a login + an Employee row does NOT imply
  // permission to see other employees' HR mail.
  employee                 Employee?             @relation("EmployeeUserLink")
  reviewedHrMail           HrMail[]              @relation("HrMailReviewer")
  resolvedInquiryCaptures  InquiryCapture[]      @relation("CaptureResolver")
  outreachActivitiesLogged OutreachActivity[]    @relation("OutreachCreator")
  contactSegments          ContactSegment[]      @relation("ContactSegmentCreator")
  suppressionsReleased     EmailSuppression[]    @relation("SuppressionReleaser")
  outreachCampaigns        OutreachCampaign[]    @relation("OutreachCampaignCreator")
  touchPlansCreated        TouchPlan[]           @relation("TouchPlanCreator")
  touchPlanEnrollments     TouchPlanEnrollment[] @relation("TouchPlanOwner")
  orderDocumentsUploaded   OrderDocument[]       @relation("OrderDocumentUploader")
  weeklyCandids            AgentWeeklyCandid[]
  personMergesPerformed    PersonMerge[]         @relation("PersonMergeOperator")
  personMergesReversed     PersonMerge[]         @relation("PersonMergeReverser")
  rateChangesApplied       RateChangeLog[]       @relation("RateChangeApplier")
  aiOverrides              AiDecision[]          @relation("AiOverrider")
  auditActions             AuditLog[]
  accounts                 Account[]
  sessions                 Session[]

  agentOrders        Order[]    @relation("OrderAgent")
  agentActivities    Activity[] @relation("ActivityAgent")
  jobsAsAgent        Job[]      @relation("JobAgent")
  jobsMarkedReturned Job[]      @relation("JobReturnedBy")
  lotChecks          LotCheck[] @relation("LotCheckedBy")

  uploadedContractReviews   ContractReview[]       @relation("ContractReviewUploader")
  decidedContractReviews    ContractReview[]       @relation("ContractReviewDecider")
  counterPdfsGenerated      ContractReview[]       @relation("CounterPdfGenerator")
  changeDecisionsDecided    ReviewChangeDecision[] @relation("ChangeDecisionDecider")
  uploadedCoiChecks         CoiCheck[]             @relation("CoiCheckUploader")
  decidedCoiChecks          CoiCheck[]             @relation("CoiCheckDecider")
  uploadedCompanyAgreements CompanyAgreement[]     @relation("CompanyAgreementUploader")
  uploadedJobDocuments      JobDocument[]          @relation("JobDocumentUploader")
  addedJobAgreementAddenda  JobAgreementAddendum[] @relation("JobAgreementAddendumAddedBy")
  reviewClauseMessages      ReviewClauseMessage[]  @relation("ReviewClauseMessageAuthor")
  assignedInquiries         Inquiry[]              @relation("InquiryAssignedTo")

  followUpsSent    QuoteFollowUp[] @relation("FollowUpSentBy")
  followUpsSkipped QuoteFollowUp[] @relation("FollowUpSkippedBy")

  // Phase 2 warehouse lane.
  pickListsAssigned     PickList[]     @relation("PickListAssignedTo")
  pickListItemsPicked   PickListItem[] @relation("PickListItemPickedBy")
  pickListsCheckedIn    PickList[]     @relation("PickListCheckedInBy")
  pickListItemsReturned PickListItem[] @relation("PickListItemReturnedBy")

  // Phase 5 commit 3 — native payment recording.
  paymentsRecorded Payment[] @relation("PaymentRecorder")
  paymentsVoided   Payment[] @relation("PaymentVoider")

  driverAssignmentsInvited DriverAssignment[] @relation("DriverAssignmentInvitedBy")

  // Proprietary-data exports. Every export is a request Wes approves —
  // see src/lib/exports/approver.ts and the DataExportRequest model.
  dataExportsRequested  DataExportRequest[] @relation("DataExportRequester")
  dataExportsDecided    DataExportRequest[] @relation("DataExportApprover")
  detailRepliesResolved ClientDetailReply[] @relation("DetailReplyResolver")

  @@map("users")
}

// ═══════════════════════════════════════
// PROPRIETARY DATA EXPORTS
// ═══════════════════════════════════════

// Wes's standing rule (2026-08-26): exporting SirReel's proprietary
// information — the client book, job data — requires HIS approval
// specifically. Not a role check: ADMIN is held by Wes AND Dani, so the
// approver is identified by email in src/lib/exports/approver.ts.
//
// The request snapshots the FILTERS and the ROW COUNT at request time, so
// what Wes approves is a known scope rather than an open-ended "export the
// clients" that could widen between ask and download.
//
// There is deliberately no download token. The approved CSV is served only
// to an authenticated session belonging to the requester (or the approver);
// a bearer token in a URL is forwardable, which is the exact failure mode
// this whole flow exists to prevent.
enum DataExportKind {
  CLIENT_LIST
}

enum DataExportStatus {
  PENDING
  APPROVED
  DENIED
  // First successful download. Terminal for reporting purposes; re-download
  // stays legal until expiresAt so a failed transfer isn't a new approval.
  FULFILLED
  // Approved but the window closed before it was downloaded. Derived on read
  // (approvedAt + EXPORT_APPROVAL_TTL_HOURS), never a stored transition.
  EXPIRED
}

model DataExportRequest {
  id     String           @id @default(uuid())
  kind   DataExportKind   @default(CLIENT_LIST)
  status DataExportStatus @default(PENDING)

  // Why the requester needs the book of business as a file. Required —
  // an unexplained export request should be easy for Wes to deny.
  reason String @db.Text

  // Scope snapshot. `filters` is the literal query the CSV will re-run
  // (search / tier / segment); `rowCountAtRequest` is what it matched when
  // asked. If the delivered count drifts from this, the download records
  // both — see rowCountDelivered.
  filters           Json?
  rowCountAtRequest Int?  @map("row_count_at_request")

  requestedById String   @map("requested_by_id")
  requestedBy   User     @relation("DataExportRequester", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now()) @map("requested_at")

  // Null until decided. decidedById is ALWAYS the approver (Wes) — the API
  // refuses any other identity, so this column doubles as the audit record
  // of who released the data.
  decidedById  String?   @map("decided_by_id")
  decidedBy    User?     @relation("DataExportApprover", fields: [decidedById], references: [id])
  decidedAt    DateTime? @map("decided_at")
  decisionNote String?   @map("decision_note") @db.Text

  // Set on approval. After this instant the approval is spent.
  expiresAt DateTime? @map("expires_at")

  // Delivery audit. downloadCount increments on every served CSV.
  downloadCount     Int       @default(0) @map("download_count")
  firstDownloadedAt DateTime? @map("first_downloaded_at")
  lastDownloadedAt  DateTime? @map("last_downloaded_at")
  rowCountDelivered Int?      @map("row_count_delivered")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, requestedAt])
  @@index([requestedById, requestedAt])
  @@map("sr_data_export_requests")
}

