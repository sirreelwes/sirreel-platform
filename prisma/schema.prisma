// ============================================================
// JOB FEATURE — added by recover-and-add-jobs.js
// ============================================================

model Job {
  id                      String         @id @default(uuid())
  jobCode                 String         @unique @map("job_code")
  // Random, high-entropy after-hours authentication factor — surfaced to
  // the client on their Portal v2 job page and presented to the SirReel
  // Assistant to help release the gate/lockbox code. DELIBERATELY separate
  // from `jobCode` (which is the sequential, guessable SR-JOB-0001 business
  // ID — unfit as a secret). Nullable so existing rows are unaffected until
  // backfilled; unique because it's a lookup key.
  assistantAuthCode       String?        @unique @map("assistant_auth_code")
  name                    String
  companyId               String         @map("company_id")
  productionType          ProductionType @default(OTHER) @map("production_type")
  // FK to the new ProductionTypeProfile lookup table — the structured
  // tier + sales-mode + price-sensitivity metadata that will drive the
  // fleet-assignment optimizer. Nullable so existing rows are
  // unaffected (no backfill required at this commit). Lives alongside
  // the legacy productionType enum above; a future migration will cut
  // over writers and deprecate the enum.
  productionTypeProfileId String?        @map("production_type_profile_id")
  status                  JobStatus      @default(QUOTED)
  startDate               DateTime?      @map("start_date") @db.Date
  endDate                 DateTime?      @map("end_date") @db.Date
  agentId                 String         @map("agent_id")
  planyoCartId            String?        @unique @map("planyo_cart_id")
  estimatedValue          Decimal?       @map("estimated_value") @db.Decimal(12, 2)
  notes                   String?        @db.Text
  /// Free-form job tags. First citizen: 'ART_DEPT' — Planyo's yellow
  /// reservation color, carried into HQ as a TAG rather than a status
  /// (Wes 2026-08-21). Rendered as a yellow chip on the scheduling
  /// surfaces; toggled from the gantt's reservation detail.
  tags                    String[]       @default([])
  // Physical-return marker — "the gear is back at the warehouse."
  // Deliberately NOT a JobStatus value (WRAPPED = lifecycle close, not
  // physical return). Set/cleared by POST /api/jobs/[id]/mark-returned
  // and unmark-returned; the future warehouse check-in flow writes this
  // same field. The Jobs board's RETURNED column keys off it exclusively.
  returnedAt              DateTime?      @map("returned_at")
  returnedById            String?        @map("returned_by_id")
  // Soft-archive marker (staff "Archive job" action). Visibility-only —
  // the /jobs list filters archivedAt IS NULL by default; the detail page
  // stays reachable. Additive; NULL = active. Cleared on unarchive.
  archivedAt              DateTime?      @map("archived_at")
  /// Staff marked this job as having NO RentalWorks counterpart (HQ-native
  /// work, or a client that never existed in RW). Removes it from the
  /// reconcile queue so the queue can actually reach zero — without it,
  /// every new HQ-native job accumulates as permanent noise. Reversible.
  rwNotApplicable         DateTime?      @map("rw_not_applicable")

  // ── Report-to (client-supplied, portal "Deliveries") ────────────────
  // Where drivers bringing units to this production should report: the
  // gate/lot/cross-street a truck aims for, which is rarely the billing
  // address and often not the production office either. The CLIENT owns
  // these — they are written from /portal/job/[slug], never by staff — so
  // this is the client's own statement of the destination, not our guess.
  //
  // Job-level on purpose: one production, one place to report. A per-unit
  // override is a real case (a coach to base camp, a restroom trailer to
  // set) but not this cut; it would hang off SubRental/DispatchTask rather
  // than widening this.
  //
  // Distinct from Booking.deliveryAddress, which is Planyo-import data on a
  // single booking. When both exist the report-to is the newer, client-
  // asserted fact; nothing reconciles them automatically today.
  reportToAddress      String? @map("report_to_address") @db.Text
  reportToAccessNotes  String? @map("report_to_access_notes") @db.Text
  reportToContactName  String? @map("report_to_contact_name")
  reportToContactPhone String? @map("report_to_contact_phone") @db.VarChar(30)
  /// When the drivers should be there. Free text on purpose: productions
  /// answer "6-7a", "first light", "after wrap", and forcing a time picker
  /// would turn a real answer into a wrong one. Booking.deliveryTime is the
  /// same shape for the same reason.
  reportToTime         String? @map("report_to_time")

  // ── The pickup half ─────────────────────────────────────────────────
  // A trailer we drop has to be collected, and the collection is not always
  // where the drop was — a unit moves to a second location mid-shoot, or the
  // production strikes to a different lot. Default is "same as delivery"
  // because that IS the common case; the override exists because the
  // exception is what strands a truck.
  pickupSameAsDelivery Boolean @default(true) @map("pickup_same_as_delivery")
  pickupAddress        String? @map("pickup_address") @db.Text
  pickupAccessNotes    String? @map("pickup_access_notes") @db.Text
  pickupTime           String? @map("pickup_time")

  /// Last save, by anyone. Drives the "Saved <when>" line in the portal and
  /// tells dispatch whether the address they are looking at is fresh.
  reportToUpdatedAt DateTime? @map("report_to_updated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company               Company                @relation(fields: [companyId], references: [id])
  agent                 User                   @relation("JobAgent", fields: [agentId], references: [id])
  returnedBy            User?                  @relation("JobReturnedBy", fields: [returnedById], references: [id])
  productionTypeProfile ProductionTypeProfile? @relation("JobProductionTypeProfile", fields: [productionTypeProfileId], references: [id])
  orders                Order[]
  bookings              Booking[]
  dispatchTasks         DispatchTask[]
  jobContacts           JobContact[]
  contractReviews       ContractReview[]
  coiChecks             CoiCheck[]
  agreementAddenda      JobAgreementAddendum[]
  documents             JobDocument[]
  rwOrders              JobRwOrder[]
  fromInquiry           Inquiry?               @relation("ConvertedFromInquiry")
  finalInvoices         JobFinalInvoice[]
  /// Sub-rentals quoted or booked against this job (see SubRental.jobId).
  subRentals            SubRental[]

  @@index([companyId])
  @@index([status])
  @@index([agentId])
  @@index([productionTypeProfileId])
  @@map("sr_jobs")
}

// ============================================================
// SALES PIPELINE INQUIRIES
// Phase 1 manual entry; Gmail auto-parse populates the same model
// in Phase 3. `convertedJobId` tracks NEW → CONVERTED transitions
// where an Inquiry becomes a Job via /orders/new-quote.
// ============================================================

enum InquirySource {
  MANUAL
  GMAIL
  WEB_FORM
}

enum InquiryStatus {
  NEW
  CONVERTED
  DISMISSED
}

model Inquiry {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  source InquirySource @default(MANUAL)
  status InquiryStatus @default(NEW)

  title       String
  description String @db.Text

  companyId String?  @map("company_id")
  company   Company? @relation(fields: [companyId], references: [id])
  personId  String?  @map("person_id")
  person    Person?  @relation("InquiryContact", fields: [personId], references: [id])

  estimatedValue     Decimal?  @map("estimated_value") @db.Decimal(12, 2)
  preferredStartDate DateTime? @map("preferred_start_date") @db.Date
  preferredEndDate   DateTime? @map("preferred_end_date") @db.Date

  assignedToId String? @map("assigned_to_id")
  assignedTo   User?   @relation("InquiryAssignedTo", fields: [assignedToId], references: [id])

  convertedJobId String? @unique @map("converted_job_id")
  convertedJob   Job?    @relation("ConvertedFromInquiry", fields: [convertedJobId], references: [id])

  // Phase 1b add-on triage — set when the inquiry was converted by
  // attaching to an EXISTING Job (a new Order on that job, marked
  // with Order.addedToJobAt). Disjoint with convertedJobId in
  // practice: the new-Job path sets convertedJobId, the add-on path
  // sets convertedOrderId. @unique mirrors convertedJobId so each
  // Order can satisfy at most one inquiry.
  convertedOrderId String?             @unique @map("converted_order_id")
  convertedOrder   Order?              @relation("ConvertedFromInquiryToOrder", fields: [convertedOrderId], references: [id])
  // COIs dropped via the client upload link before a job exists.
  coiChecks        CoiCheck[]          @relation("InquiryCoiChecks")
  // Company / project name the client typed on the no-login details link.
  detailReplies    ClientDetailReply[] @relation("InquiryDetailReplies")

  sourceMetadata Json? @map("source_metadata")

  // RFC822 Message-Id of the originating email when source=GMAIL.
  // Used to dedupe cross-inbox copies of the same message (each Gmail
  // inbox has its own EmailMessage row with a distinct id, but they
  // share rfc822MessageId). The partial unique index `sr_inquiries_rfc822_gmail_uniq`
  // (added via raw SQL — Prisma can't express filtered uniques) makes
  // a concurrent double-capture impossible at the DB layer.
  rfc822MessageId String? @map("rfc822_message_id")

  // First staff reply on the inquiry's email thread. Deliberately NOT a
  // status value: a responded inquiry is still an open lead (status stays
  // NEW until converted/dismissed) — these drive the Pipeline's
  // "Responded" separation + "Replied by …" attribution. Set by the
  // Gmail ingest reply-detection hook and by the Quick Reply send route
  // (both via src/lib/sales/markInquiryResponded.ts), and stamped
  // directly by /api/sales/welcome/send (Quick Respond + welcome invite)
  // — that path had to write it itself because thread-matching can never
  // cover a WEB_FORM inquiry, which has no originating email thread.
  // First reply wins, later staff messages don't overwrite. respondedBy
  // is the staff mailbox address (e.g. jose@sirreel.com), not a User FK
  // — outbound mail can come from shared inboxes (hello@, info@) with
  // no User row.
  respondedAt DateTime? @map("responded_at")
  respondedBy String?   @map("responded_by")

  // Welcome / Job Begin invite (client click-to-create) — at most one per
  // inquiry (@unique on WelcomeInvite.inquiryId).
  welcomeInvite WelcomeInvite?

  @@index([status, createdAt])
  @@index([assignedToId])
  @@index([rfc822MessageId])
  @@map("sr_inquiries")
}

// ── Agreement entry tokens (public rental-agreement email gate) ─────
// Sibling of WelcomeInvite, NOT an extension: WelcomeInvite requires an
// inquiryId + personId at mint (agent-qualified inquiry) and is 1:1 with an
// inquiry, while these tokens are minted from a bare EMAIL on the public page
// — Branch A needs one CONFIRM_JOB token PER open job and Branch C's
// START_NEW exists before any Person/Inquiry does. Loose string ids (no FKs)
// keep it purely additive. Job creation itself still flows through the
// WelcomeInvite click-to-create path (createdInquiryId → WelcomeInvite →
// startWelcomeInvite) so idempotency lives in ONE place.
model AgreementEntry {
  id               String    @id @default(uuid())
  token            String    @unique // 256-bit hex
  email            String
  kind             String // 'CONFIRM_JOB' | 'START_NEW'
  personId         String?   @map("person_id")
  jobId            String?   @map("job_id") // CONFIRM_JOB: the job this link confirms
  createdInquiryId String?   @map("created_inquiry_id") // START_NEW: stamped on submit
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("sr_agreement_entries")
}

// ── Welcome / Job Begin invite ──────────────────────────────────────
// Minted when the agent SENDS the welcome email (explicit review + send).
// The Job/Order/portal are created ONLY when the client presses "Get
// Paperwork Started" on the landing page — never at send time. inquiryId
// is @unique so re-sends refresh the one invite and concurrent clicks
// can never mint two jobs for one inquiry; createdJobId/createdOrderId
// stamp the first successful click so every later click resolves to the
// SAME portal.
model WelcomeInvite {
  id             String    @id @default(uuid())
  token          String    @unique // 256-bit hex, minted at send
  inquiryId      String    @unique @map("inquiry_id")
  inquiry        Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  personId       String    @map("person_id")
  person         Person    @relation("WelcomeInvitePerson", fields: [personId], references: [id])
  expiresAt      DateTime  @map("expires_at")
  /// Agent-resolved Job (Job-as-root step 4) — set at SEND time via the
  /// resolver; the client's click mints only the Order inside this Job.
  jobId          String?   @map("job_id")
  createdJobId   String?   @map("created_job_id")
  createdOrderId String?   @map("created_order_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  usedAt         DateTime? @map("used_at")

  @@map("sr_welcome_invites")
}

// InquiryCapture — verdict-per-inbound-message audit trail for the
// aggressive CRM auto-capture pipeline. ONE row per evaluated
// EmailMessage on info@/jose@/oliver@. Verdict says what happened;
// parsed fields are the harvested signature data; person/company FKs
// link the row that was captured or enriched (null for SKIPPED and
// for NEEDS_REVIEW until the rep resolves).
//
// rfc822MessageId enables cross-inbox dedup the same way Inquiry does:
// a single human-sent message that lands in info@ + jose@ gets ONE
// capture, not two. The shared helper at
// src/lib/crm/captureFromEmail.ts is responsible for the lookup.
enum CaptureVerdict {
  AUTO_CAPTURED // contact added or enriched automatically
  NEEDS_REVIEW // production-related but uncertain — surface to rep
  SKIPPED // hard skip OR no production signal; stored, muted
}

enum CaptureResolution {
  PENDING // default for NEEDS_REVIEW awaiting human action
  AUTO_FILED // AUTO_CAPTURED created a new Person
  AUTO_ENRICHED // AUTO_CAPTURED filled empty fields on an existing Person
  AUTO_SKIPPED // SKIPPED set this immediately, no action needed
  ADDED // rep accepted the NEEDS_REVIEW row, person now linked
  DISMISSED // rep dismissed the NEEDS_REVIEW row
}

model InquiryCapture {
  id              String  @id @default(uuid())
  emailMessageId  String  @unique @map("email_message_id")
  rfc822MessageId String? @map("rfc822_message_id")
  inbox           String // info@, jose@, oliver@ — denormalized for filters

  verdict       CaptureVerdict
  verdictReason String         @map("verdict_reason") @db.Text
  // Production-legitimacy signals matched (role title, project name,
  // domain match, history language, freemail-rental-intent). Stored
  // as an array of short tags for the review widget; classifier
  // populates it.
  signals       Json?

  // Parsed signature payload — denormalized so the review widget can
  // render the row without joining EmailMessage.extractedData.
  parsedName          String? @map("parsed_name")
  parsedEmail         String? @map("parsed_email")
  parsedPhone         String? @map("parsed_phone")
  parsedTitle         String? @map("parsed_title")
  parsedCompanyString String? @map("parsed_company_string")
  parsedProject       String? @map("parsed_project")

  // Linked rows once captured/enriched. Company is set ONLY on a
  // confident match (domain or exact name); the classifier never
  // auto-creates companies — unmatched company strings stay in
  // parsedCompanyString for the review widget to surface.
  personId  String?  @map("person_id")
  person    Person?  @relation("CaptureContact", fields: [personId], references: [id], onDelete: SetNull)
  companyId String?  @map("company_id")
  company   Company? @relation("CaptureCompany", fields: [companyId], references: [id], onDelete: SetNull)

  resolution    CaptureResolution @default(PENDING)
  // Audit trail of fields filled on an existing Person during enrich.
  // Shape: { phone: { from: null, to: "..." }, rawTitle: {...}, ... }
  enrichmentLog Json?             @map("enrichment_log")
  resolvedById  String?           @map("resolved_by_id")
  resolvedBy    User?             @relation("CaptureResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt    DateTime?         @map("resolved_at")

  // Pending-review dedup. When a new NEEDS_REVIEW would mint and an
  // existing PENDING parent already exists for the same parsedEmail
  // (lowercased), the new row is created with attachedToCaptureId
  // pointing at the parent — keeping the backfill idempotency intact
  // (every EmailMessage still gets exactly one capture row) while
  // surfacing only the parent in the review widget. Resolving the
  // parent cascades the action to all attached children in one shot.
  attachedToCaptureId String?          @map("attached_to_capture_id")
  attachedTo          InquiryCapture?  @relation("CaptureAttached", fields: [attachedToCaptureId], references: [id], onDelete: SetNull)
  attachedChildren    InquiryCapture[] @relation("CaptureAttached")

  emailMessage EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([verdict, createdAt(sort: Desc)])
  @@index([resolution, createdAt(sort: Desc)])
  @@index([rfc822MessageId])
  @@index([attachedToCaptureId])
  @@map("sr_inquiry_captures")
}

/// Kanban board manual placement (Jobs page). PRESENTATION STATE ONLY —
/// deliberately a standalone side table with no relation into Job so the
/// Job/Booking domain models stay untouched. An agent dragging a card
/// overrides the date-derived column; a real checkout/check-in event
/// system later replaces this table entirely (drop it then).
model JobBoardOverride {
  id      String   @id @default(uuid())
  jobId   String   @unique @map("job_id")
  phase   String // 'PREJOB' | 'OUT' | 'RETURNED'
  movedBy String?  @map("moved_by")
  movedAt DateTime @default(now()) @map("moved_at")

  @@map("sr_job_board_overrides")
}

model JobContact {
  id        String   @id @default(uuid())
  jobId     String   @map("job_id")
  personId  String   @map("person_id")
  role      JobRole
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id])

  @@unique([jobId, personId, role])
  @@index([jobId])
  @@index([personId])
  @@map("sr_job_contacts")
}

enum JobStatus {
  NEW
  QUOTED
  ACTIVE
  WRAPPED
  HOLD
  LOST
}

enum JobRole {
  PRODUCER
  PM
  PC
  TRANSPO
  ACCOUNTING
  OTHER
}

// ============================================================
// LOT CHECK — Julian's yard audit
// Physical presence of an asset at the Lankershim lot,
// captured separately from AssetStatus since a truck can
// be "on rental" AND "parked in the lot overnight".
// ============================================================

model LotCheck {
  id        String   @id @default(uuid())
  assetId   String   @map("asset_id")
  present   Boolean
  checkedBy String   @map("checked_by")
  checkedAt DateTime @default(now()) @map("checked_at")
  notes     String?  @db.Text

  asset Asset @relation(fields: [assetId], references: [id])
  user  User  @relation("LotCheckedBy", fields: [checkedBy], references: [id])

  @@index([assetId, checkedAt])
  @@index([checkedAt])
