// ============================================================
// PAPERWORK PERSISTENCE — contract reviews + COI checks
// PDFs live in Vercel Blob; AI analysis JSON + audit metadata
// live here. Soft delete only (CCPA/audit safety); hard
// blob deletion happens via separate cron after 30-day buffer.
// ============================================================

enum ReviewDecision {
  PENDING
  APPROVED
  COUNTERED
  REJECTED
}

enum ReviewType {
  CONTRACT
  COI
}

enum ChangeDecision {
  PENDING
  ACCEPT
  COUNTER
  REJECT
}

model ContractReview {
  id               String @id @default(uuid())
  fileKey          String @map("file_key")
  fileUrl          String @map("file_url")
  originalFilename String @map("original_filename")
  fileSize         Int    @map("file_size")
  mimeType         String @map("mime_type")

  jobId     String? @map("job_id")
  companyId String? @map("company_id")

  uploadedById String @map("uploaded_by_id")

  aiResponse       Json    @map("ai_response")
  aiRiskLevel      String? @map("ai_risk_level")
  aiRecommendation String? @map("ai_recommendation")

  // Deterministic PDF markup extraction (MarkupManifest in
  // src/lib/contracts/annotationManifest.ts): verbatim text under each
  // strike annotation + client FreeText insertions. Ground truth the AI
  // and the review UI are both held to — origin: review ef015a5a, where
  // Preview /Line strikes never touch the text layer and the model's
  // `proposed` silently retained struck phrases.
  annotationManifest Json? @map("annotation_manifest")
  // Prior aiResponse snapshots, newest last. Appended by the rerun
  // route before overwriting aiResponse so a re-run never destroys the
  // audit trail of what the operator previously saw.
  aiResponseHistory  Json? @map("ai_response_history")

  humanDecision     ReviewDecision @default(PENDING) @map("human_decision")
  humanDecisionNote String?        @map("human_decision_note") @db.Text
  humanDecisionById String?        @map("human_decision_by_id")
  humanDecisionAt   DateTime?      @map("human_decision_at")

  counterPdfKey        String?   @map("counter_pdf_key")
  counterPdfUrl        String?   @map("counter_pdf_url")
  counterGeneratedAt   DateTime? @map("counter_generated_at")
  counterGeneratedById String?   @map("counter_generated_by_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  job                Job?                   @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company            Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  uploadedBy         User                   @relation("ContractReviewUploader", fields: [uploadedById], references: [id])
  humanDecisionBy    User?                  @relation("ContractReviewDecider", fields: [humanDecisionById], references: [id])
  counterGeneratedBy User?                  @relation("CounterPdfGenerator", fields: [counterGeneratedById], references: [id])
  changeDecisions    ReviewChangeDecision[]
  clauseMessages     ReviewClauseMessage[]
  signedAgreement    SignedAgreement?

  @@index([jobId])
  @@index([companyId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([humanDecision])
  @@map("sr_contract_reviews")
}

model ReviewChangeDecision {
  id       String         @id @default(uuid())
  reviewId String         @map("review_id")
  review   ContractReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  clauseRef   String @map("clause_ref")
  changeType  String @map("change_type")
  changeIndex Int    @map("change_index")

  decision        ChangeDecision @default(PENDING)
  counterLanguage String?        @map("counter_language") @db.Text
  note            String?        @db.Text

  decidedById String?   @map("decided_by_id")
  decidedBy   User?     @relation("ChangeDecisionDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime? @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([reviewId, changeIndex], name: "review_change_unique")
  @@index([reviewId])
  @@index([decision])
  @@map("sr_review_change_decisions")
}

// Per-clause Discuss thread on a contract review — the operator asks
// Claude questions about one flagged clause, tests positions, and
// requests draft counter language. Persisted for audit and shown on
// the review record. NOTHING here ever reaches the client: applying a
// drafted counter is an explicit UI action that only seeds the normal
// ReviewChangeDecision COUNTER flow. clauseKey is the AI change's
// `clause` ref (e.g. "7", "Fleet 4(b)"), falling back to "#<index>"
// when the ref is empty — refs can repeat in pathological outputs, in
// which case those changes share a thread (acceptable for discussion).
model ReviewClauseMessage {
  id          String         @id @default(uuid())
  reviewId    String         @map("review_id")
  review      ContractReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  clauseKey   String         @map("clause_key")
  role        String // 'user' | 'assistant'
  content     String         @db.Text
  createdById String?        @map("created_by_id") // null for assistant turns
  createdBy   User?          @relation("ReviewClauseMessageAuthor", fields: [createdById], references: [id])
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([reviewId, clauseKey, createdAt])
  @@map("sr_review_clause_messages")
}

enum AgreementDocumentType {
  BASELINE
  NEGOTIATED
}

enum AgreementStatus {
  PORTAL_GENERATED // PDF rendered + persisted, NOT yet released to the client portal
  PORTAL_RELEASED // agent explicitly released → client sees the in-portal Sign link (June 2026 native-sign flow)
  DOWNLOAD_SENT // legacy: download link emailed via the /portal/[token] paperwork-portal flow
  REDLINE_UPLOADED
  UNDER_REVIEW
  NEGOTIATED_READY
  SIGNED_BASELINE
  SIGNED_NEGOTIATED
  /// Signed on paper (or in Cognito) and FILED by staff on the job page,
  /// rather than signed through the portal. Counts as signed everywhere —
  /// the client has signed — but stays distinguishable, because there is no
  /// in-portal signature record behind it: no signer IP, no captured
  /// signature image, no acknowledgment text. Presenting that as a portal
  /// signature would overstate what we hold if the agreement is ever
  /// disputed.
  SIGNED_OFFLINE
}

model SignedAgreement {
  id      String @id @default(uuid())
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // RENTAL_AGREEMENT is the original (vehicles-and-gear) contract. STAGE_CONTRACT
  // is the SirReel stages booking contract added May 2026 — an Order that rents
  // BOTH vehicles and stages produces two SignedAgreement rows (one per type).
  // Compound unique replaces the old `orderId @unique` so this is possible.
  contractType     ContractType          @default(RENTAL_AGREEMENT) @map("contract_type")
  documentType     AgreementDocumentType @default(BASELINE) @map("document_type")
  baselineVersion  String?               @map("baseline_version")
  contractReviewId String?               @unique @map("contract_review_id")
  contractReview   ContractReview?       @relation(fields: [contractReviewId], references: [id])

  documentToSignUrl String? @map("document_to_sign_url")
  redlineUploadUrl  String? @map("redline_upload_url")
  signedDocumentUrl String? @map("signed_document_url")
  wordDocumentUrl   String? @map("word_document_url")

  signedAt           DateTime? @map("signed_at")
  signerName         String?   @map("signer_name")
  signerTitle        String?   @map("signer_title")
  signerEmail        String?   @map("signer_email")
  signatureImageData String?   @map("signature_image_data") @db.Text

  acknowledgmentText String? @map("acknowledgment_text") @db.Text
  signerIpAddress    String? @map("signer_ip_address")
  signerUserAgent    String? @map("signer_user_agent") @db.Text

  status AgreementStatus @default(PORTAL_GENERATED)

  /// This order is papered by ANOTHER order's signature on the same job.
  ///
  /// A client who books a second order onto a job we've already papered was
  /// being asked to sign again (Wes 2026-08-29). They shouldn't be: the
  /// rental agreement document renders Job #, never an order number, so a
  /// signature already covers the job — the per-order row is a storage
  /// artifact, not a legal boundary.
  ///
  /// Deliberately NOT a new AgreementStatus. 55 sites across the app test
  /// the SIGNED_* statuses inline with no shared predicate, so a new status
  /// would have to be threaded through every one of them, and a missed site
  /// would render an unsigned order as signed. This is additive instead:
  /// the row keeps its own honest status (it has no signature of its own,
  /// and the signed-copy surfaces must keep saying so), and only the
  /// surfaces that ASK consult this column.
  coveredByAgreementId String?           @map("covered_by_agreement_id")
  coveredBy            SignedAgreement?  @relation("AgreementCoverage", fields: [coveredByAgreementId], references: [id], onDelete: SetNull)
  covers               SignedAgreement[] @relation("AgreementCoverage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([orderId, contractType])
  @@index([orderId])
  @@index([contractType])
  @@index([status])
  @@map("sr_signed_agreements")
}

/// Audit of a re-issued agreement — the paper was signed under the WRONG
/// entity (usually a production-company mismatch caught against the COI's
/// named insured) and had to be re-sent under the correct company/account.
///
/// Exists because SignedAgreement is unique on (orderId, contractType):
/// re-releasing for signature necessarily overwrites the signature fields
/// on the live row. This table keeps the superseded signature — who signed,
/// when, and the signed PDF — so a re-send never silently erases the fact
/// that a client DID sign something. Append-only; never updated.
model AgreementReissue {
  id           String       @id @default(uuid())
  orderId      String       @map("order_id")
  contractType ContractType @default(RENTAL_AGREEMENT) @map("contract_type")

  /// Free-text why, shown on the order/job agreement history.
  reason String @db.Text

  priorStatus            String    @map("prior_status")
  priorSignedAt          DateTime? @map("prior_signed_at")
  priorSignerName        String?   @map("prior_signer_name")
  priorSignerEmail       String?   @map("prior_signer_email")
  priorSignedDocumentUrl String?   @map("prior_signed_document_url")
  /// Company the superseded paper was papered under, and the company the
  /// re-issue goes out under. Snapshotted as NAMES (not FKs) — the point of
  /// the record is what the document said at the time.
  priorCompanyName       String?   @map("prior_company_name")
  newCompanyName         String?   @map("new_company_name")

  /// Actor is stored as scalars rather than a User relation: this is an
  /// append-only snapshot, and a deactivated/deleted staff row must not be
  /// able to take the audit line with it.
  createdById   String?  @map("created_by_id")
  createdByName String?  @map("created_by_name")
  createdAt     DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("sr_agreement_reissues")
}

/// Contract type carried by SignedAgreement. RENTAL_AGREEMENT pre-dates this
/// enum — all existing rows default to it. STAGE_CONTRACT is the SirReel
/// stages booking contract (canonical baseline: public/contracts/
/// sirreel-stage-contract.docx). An Order with contractType='both' produces
/// one SignedAgreement of each enum value.
enum ContractType {
  RENTAL_AGREEMENT
  STAGE_CONTRACT
}

/// Sales-negotiated terms for a SirReel stages booking. One row per
/// orderId; created when a sales rep starts filling in stage terms,
/// updated as negotiation progresses, then consumed by the stage-contract
/// PDF generator. Per CRH brief (May 2026) the canonical fields are:
/// rental dates (possibly non-contiguous), daily rate, production-office
/// flag, the list of specific spaces being booked, security guard flag,
/// and free-form sales notes for the rep's own context.
model StageBookingTerms {
  id      String @id @default(uuid())
  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Array of ISO yyyy-MM-dd date strings. Stored as JSON so non-contiguous
  /// bookings ("Mon, Wed-Fri") fit in one column without a child table.
  rentalDates Json    @map("rental_dates")
  dailyRate   Decimal @map("daily_rate") @db.Decimal(10, 2)

  // Negotiated day length and the overtime rate beyond it. A "day" in
  // production is a contracted number of hours, not a calendar day, and
  // the number is negotiable per booking — so it is stored per-order and
  // editable by the rep BEFORE the contract is generated, not hardcoded
  // in the template. Nullable: rows written before Aug 2026 have no
  // agreed figure, and the contract must say so rather than invent one.
  dayLengthHours         Int?     @map("day_length_hours")
  overtimeHourlyRate     Decimal? @map("overtime_hourly_rate") @db.Decimal(10, 2)
  productionOfficeRental Boolean  @default(false) @map("production_office_rental")
  /// Free-text labels: "Standing Sets", "LED Volume Stage", "Cyc Wall", etc.
  /// Kept as a string array (not an enum) because the catalog of stage spaces
  /// shifts faster than schema migrations want to track.
  specificSpaces         String[] @default([]) @map("specific_spaces")
  securityGuardRequired  Boolean  @default(false) @map("security_guard_required")

  /// Internal-only context about the negotiation (not rendered in the
  /// generated PDF). Used by sales during follow-ups.
  salesNotes String? @map("sales_notes") @db.Text

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("sr_stage_booking_terms")
}

model CoiCheck {
  id               String @id @default(uuid())
  fileKey          String @map("file_key")
  fileUrl          String @map("file_url")
  originalFilename String @map("original_filename")
  fileSize         Int    @map("file_size")
  mimeType         String @map("mime_type")

  jobId     String? @map("job_id")
  companyId String? @map("company_id")
  // Client-facing COI upload (no-login tokenized drop): may carry a job,
  // a company, an inquiry, or none of them (lands UNATTACHED for the team
  // to assign later). All three nullable.
  inquiryId String? @map("inquiry_id")

  // Nullable: a no-login client upload has no HQ User behind it; internal
  // uploads still set this.
  uploadedById        String? @map("uploaded_by_id")
  // Provenance for client uploads (no User to attribute to).
  source              String? @map("source") // CLIENT_UPLOAD | INTERNAL
  clientUploaderName  String? @map("client_uploader_name")
  clientUploaderEmail String? @map("client_uploader_email")

  // Nullable: client uploads skip AI review; the team runs it later.
  aiResponse       Json?   @map("ai_response")
  aiRiskLevel      String? @map("ai_risk_level")
  aiRecommendation String? @map("ai_recommendation")

  policyExpiryDate  DateTime? @map("policy_expiry_date")
  coverageVerified  Boolean   @default(false) @map("coverage_verified")
  additionalInsured Boolean   @default(false) @map("additional_insured")

  /// The NAMED INSURED as printed on the certificate — the entity the
  /// policy actually covers, which is NOT necessarily the production
  /// company we papered the job under. Extracted by the AI review
  /// (`namedInsured` in the response JSON); null on rows whose AI review
  /// never ran (client no-login drops) or predates the field.
  ///
  /// Stored as the raw FACT off the document, never as a match verdict:
  /// the comparison against the job's production company is computed live
  /// (src/lib/coi/insuredMatch.ts) so that fixing a wrong production
  /// company clears the flag without re-reviewing the certificate.
  namedInsured String? @map("named_insured")

  humanDecision     ReviewDecision @default(PENDING) @map("human_decision")
  humanDecisionNote String?        @map("human_decision_note") @db.Text
  humanDecisionById String?        @map("human_decision_by_id")
  humanDecisionAt   DateTime?      @map("human_decision_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by_id")

  job             Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  inquiry         Inquiry?         @relation("InquiryCoiChecks", fields: [inquiryId], references: [id], onDelete: SetNull)
  uploadedBy      User?            @relation("CoiCheckUploader", fields: [uploadedById], references: [id])
  humanDecisionBy User?            @relation("CoiCheckDecider", fields: [humanDecisionById], references: [id])
  // Phase 5 commit 4 — claims that reference this COI as the policy
  // they were filed against.
  insuranceClaims InsuranceClaim[]

  @@index([jobId])
  @@index([companyId])
  @@index([inquiryId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([humanDecision])
  @@index([policyExpiryDate])
  @@map("sr_coi_checks")
}

// A rental/stage agreement ON FILE — the executed master document. Often
// ANNUAL and shared across many of a company's jobs (Wes, Jul 2026:
// "sometimes we have annual rental agreements"). Filed once at the company
// level; individual jobs are attached to it as addenda (see
// JobAgreementAddendum). The order-native SignedAgreement flow (portal
// sign / review / counter) is separate and untouched — this is the
// job-level truth for whether a job is covered.
model CompanyAgreement {
  id        String  @id @default(uuid())
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  contractType ContractType @default(RENTAL_AGREEMENT) @map("contract_type")
  title        String? // e.g. "2026 Annual Rental Agreement"

  fileKey          String @map("file_key")
  fileUrl          String @map("file_url")
  originalFilename String @map("original_filename")
  fileSize         Int    @map("file_size")
  mimeType         String @map("mime_type")

  // Annual coverage window. isAnnual=false is a one-off master a single
  // job attaches to; annual masters carry effective/expiry dates.
  isAnnual      Boolean   @default(false) @map("is_annual")
  effectiveDate DateTime? @map("effective_date")
  expiryDate    DateTime? @map("expiry_date")

  signerName String?   @map("signer_name")
  signedAt   DateTime? @map("signed_at")
  note       String?   @db.Text

  source       String? // INTERNAL
  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation("CompanyAgreementUploader", fields: [uploadedById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  addenda JobAgreementAddendum[]

  @@index([companyId])
  @@index([contractType])
  @@index([deletedAt])
  @@map("sr_company_agreements")
}

// Attaches ONE job to a CompanyAgreement as an addendum — "add the job to
// that agreement as an addendum" (Wes, Jul 2026). Manual, per job. The
// linkage alone means the job is covered; an optional signed addendum page
// (the doc that formally adds this job) can be attached too.
model JobAgreementAddendum {
  id                 String           @id @default(uuid())
  jobId              String           @map("job_id")
  companyAgreementId String           @map("company_agreement_id")
  job                Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  companyAgreement   CompanyAgreement @relation(fields: [companyAgreementId], references: [id], onDelete: Cascade)

  // Optional signed addendum page that adds THIS job to the master.
  addendumFileKey  String? @map("addendum_file_key")
  addendumFileUrl  String? @map("addendum_file_url")
  addendumFilename String? @map("addendum_filename")
  addendumFileSize Int?    @map("addendum_file_size")

  note      String? @db.Text
  addedById String? @map("added_by_id")
  addedBy   User?   @relation("JobAgreementAddendumAddedBy", fields: [addedById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([jobId, companyAgreementId])
  @@index([jobId])
  @@index([companyAgreementId])
  @@index([deletedAt])
  @@map("sr_job_agreement_addenda")
}

// ============================================================
// CLIENT RELATIONSHIP HUB (CRH) — May 2026
// Cadence engine, portal access, company-level paperwork, and AI
// reply classification. See docs/specs/client-relationship-hub-brief.md
// for the full spec.
// ============================================================

enum CadenceState {
  QUOTE_DRAFT
  QUOTE_SENT
  QUOTE_ACKNOWLEDGED
  QUOTE_DISCUSSING
  BOOKED
  PICKUP_CONFIRMED
  IN_PROGRESS
  RETURNED
  INVOICED
  PAID
  WRAPPED
  LOST
  CANCELLED
}

enum LostReason {
  // System-derived (written by the cadence runner / reply classifier).
  NO_RESPONSE
  ACKNOWLEDGED_NO_BOOK
  EXPLICIT_REJECTION
  MANUAL_CLOSE
  // Human-chosen, from the "Mark lost" picker on /orders and the order
  // detail page. Added because the only reasons the enum carried were the
  // ones the ROBOT could infer — a rep closing a quote by hand had nothing
  // truthful to pick, and /api/jobs/[id]/mark-lost was writing free text
  // ("Other vendor", "Budget") straight into this enum column, which
  // Postgres rejects at runtime.
  LOST_TO_COMPETITOR
  BUDGET
  TIMING
  SCOPE_CHANGED
  OTHER
}

enum ReplyClassification {
  PURE_ACKNOWLEDGMENT
  ACTIVE_DISCUSSION
  BOOKING_SIGNAL
  EXPLICIT_REJECTION
  UNCLEAR
}

enum InferredFormType {
  BOOKING_INQUIRY
  ANNUAL_AGREEMENT
  JOB_AGREEMENT
  DAMAGE_REPORT
  COI
}

enum CadenceEventType {
  // Unbooked cadence
  QUOTE_NUDGE_24H
  QUOTE_CHECKIN_T72
  QUOTE_CLOSEDOWN_T24
  QUOTE_LOST_MARK

  // Acknowledged-state cadence
  ACK_QUESTIONS_PROMPT_24H
  ACK_SWEETEN_T72
  ACK_CLOSEDOWN_T24

  // Booked cadence
  BOOKING_WELCOME
  COI_RECEIVED_ACK
  PRE_PICKUP_DETAILS_T48
  FINAL_CONFIRM_T24
  PICKUP_DAY_AM
  MID_RENTAL_CHECKIN
  RETURN_REMINDER_T24
  RETURN_ACKNOWLEDGMENT
  WRAP_THANKS_T24
  INVOICE_DELIVERY
  PAYMENT_REMINDER_T14
  REPEAT_BUSINESS_T30
  // Phase 3 lifecycle: emitted by the LOADED_READY rollup when both
  // warehouse + fleet lanes hit terminal. One of the two required
  // client notifications per the lifecycle spec (Phase 0 addendum);
  // the other (CHECKOUT_SIGN_OFF) lands with the future fleet
  // checkout flow.
  LOADED_AND_READY

  // Re-engagement
  LOST_REENGAGEMENT_2W
  LOST_SOFT_CHECKIN_90D

  // Annual paperwork
  ANNUAL_EXPIRY_60D
  ANNUAL_EXPIRY_30D
  ANNUAL_EXPIRY_7D

  // Portal lifecycle
  PORTAL_SUNSET_REMINDER_23M
}

/// Tracks every automated and manual touchpoint for reporting and debugging.
/// Created by state-transition hooks; consumed by /api/cron/cadence which
/// fires due events (scheduledFor <= now AND executedAt IS NULL).
model CadenceEvent {
  id           String           @id @default(uuid())
  orderId      String           @map("order_id")
  order        Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType    CadenceEventType @map("event_type")
  scheduledFor DateTime         @map("scheduled_for")
  executedAt   DateTime?        @map("executed_at")
  skipped      Boolean          @default(false)
  skipReason   String?          @map("skip_reason")
  // Pointer to the EmailMessage row that resulted from this event (when the
  // event was an email send). Kept as a free String rather than a relation so
  // the email row can be hard-deleted without cascading into cadence history.
  emailId      String?          @map("email_id")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([orderId])
  @@index([scheduledFor, executedAt])
  @@map("sr_cadence_events")
}

/// Per-contact portal access record. `contactId` references Person — there is
/// no separate Contact model in this schema; the CRH brief's `Contact` maps
/// 1:1 to `Person` for SirReel.
/// Person-scoped passwordless portal session. Distinct from
/// PortalAccess (which is order-scoped, requires non-null orderId) and
/// from ClientSession (loose email-string key, no FK).
///
/// Lifecycle:
///   1. POST /api/portal/auth/request → INSERT row with magicLinkToken
///      + expiry. Email sent to the matching Person (response is
///      neutral whether or not the email matched — no enumeration).
///   2. GET /api/portal/auth/verify?token=X → look up by token, check
///      magicLinkExpiresAt + magicLinkUsedAt + revokedAt. Stamp
///      magicLinkUsedAt and issue an HMAC-signed cookie carrying this
///      row's id (mirror of jobSession.ts).
///   3. Subsequent /portal/... requests → cookie HMAC-verified, then
///      this row is loaded; revokedAt is the kill switch.
///
/// Cookie exp (30 days) is in jobSession.ts territory; row revocation
/// is via revokedAt.
model PersonSession {
  id       String @id @default(uuid())
  personId String @map("person_id")
  person   Person @relation(fields: [personId], references: [id])

  // Magic-link state — populated on request, consumed on verify.
  magicLinkToken     String    @unique @map("magic_link_token")
  magicLinkExpiresAt DateTime  @map("magic_link_expires_at")
  magicLinkUsedAt    DateTime? @map("magic_link_used_at")

  // Audit
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent") @db.Text
  lastAccessedAt DateTime? @map("last_accessed_at")
  accessCount    Int       @default(0) @map("access_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  revokedAt      DateTime? @map("revoked_at")

  @@index([personId])
  @@map("person_sessions")
}

model PortalAccess {
  id                 String    @id @default(uuid())
  orderId            String    @map("order_id")
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  contactId          String    @map("contact_id")
  contact            Person    @relation("PortalAccessContact", fields: [contactId], references: [id])
  magicLinkToken     String    @unique @map("magic_link_token")
  magicLinkExpiresAt DateTime  @map("magic_link_expires_at")
  // Optional password (hashed, never plain) for persistent login after magic
  // link expires. Bcrypt/argon2 — see CRH brief §13 portal security.
  passwordHash       String?   @map("password_hash")
  createdAt          DateTime  @default(now()) @map("created_at")
  revokedAt          DateTime? @map("revoked_at")
  revokedBy          String?   @map("revoked_by")
  lastAccessedAt     DateTime? @map("last_accessed_at")
  accessCount        Int       @default(0) @map("access_count")

  // Phase 6 commit 1 — back-relation for portal-initiated payments
  // (card or ACH). Recorded operator payments use Payment.recordedBy
  // instead.
  initiatedPayments Payment[] @relation("PortalInitiatedPayments")

  @@index([orderId])
  @@index([contactId])
  @@index([magicLinkToken])
  @@map("sr_portal_accesses")
}

/// One row per hourly health-check run. `services` holds the full per-service
/// JSON payload returned by /api/admin/health so the /admin/health page can
/// render a 24h history without re-probing. `alertedAt` is set when the cron
/// posted to Slack for this run — used by the 4h alert-suppression window so
/// a sustained outage doesn't spam the channel.
model HealthCheckLog {
  id          String    @id @default(uuid())
  checkedAt   DateTime  @default(now()) @map("checked_at")
  overall     String // "healthy" | "degraded" | "down"
  services    Json // full per-service detail (see HealthReport type)
  alertedAt   DateTime? @map("alerted_at")
  alertDetail String?   @map("alert_detail")

  @@index([checkedAt(sort: Desc)])
  @@index([overall, checkedAt])
  @@map("sr_health_check_logs")
}

/// Per-day counter for the date-based order/quote number format
/// (`S{YYMMDD}-{NNN}`). One row per Pacific-time calendar date; `seq`
/// is incremented atomically by `nextOrderNumber()` via UPSERT inside
/// the same transaction as the Order insert, so a rolled-back order
/// rolls back its number too (no daily gaps unless the day itself
/// rolls over mid-tx — acceptable). The legacy `sr_order_number_seq`
/// Postgres SEQUENCE is retained but unused — the 11 pre-existing
/// SR-ORD-* orders keep their numbers (forward-only switch).
model OrderDailyCounter {
  dateKey String @id @map("date_key") // YYMMDD in America/Los_Angeles
  seq     Int    @default(0)

  @@map("order_daily_counter")
}

/// Per-send delivery audit — one row per outbound Resend dispatch.
/// Capture: written at send time with `resendMessageId` (the unique
/// id Resend returns from emails.send()) and `status=SENT`.
/// Webhook: POST /api/webhooks/resend looks up by resendMessageId
/// (unique) and updates `status` + `statusDetail` + `statusAt` as
/// Resend's events arrive (delivered / delivery_delayed / bounced /
/// complained).
/// Surface: order detail page joins on `orderId` to render a
/// delivery pill next to each cadence/email row.
/// Parent FKs are all optional + SetNull on delete so the delivery
/// audit row survives even if the order/invoice is hard-deleted.
model EmailDelivery {
  id              String              @id @default(uuid())
  resendMessageId String              @unique @map("resend_message_id")
  status          EmailDeliveryStatus @default(SENT)
  statusDetail    String?             @map("status_detail")
  statusAt        DateTime            @default(now()) @map("status_at")

  // Send context — at least one of these is set by the caller. Used
  // by the order detail UI to scope the deliveries shown.
  orderId         String? @map("order_id")
  invoiceId       String? @map("invoice_id")
  quoteFollowUpId String? @map("quote_follow_up_id")

  // Envelope — recorded at send for display + debugging
  toAddress   String   @map("to_address")
  ccAddresses String[] @map("cc_addresses")
  subject     String
  // sendAgreementEmail's `label` — e.g. "send-quote:SR-ORD-0042"
  label       String?

  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  quoteFollowUp QuoteFollowUp? @relation(fields: [quoteFollowUpId], references: [id], onDelete: SetNull)

  @@index([orderId, sentAt(sort: Desc)])
  @@index([invoiceId])
  @@index([status])
  @@map("sr_email_deliveries")
}

enum EmailDeliveryStatus {
  SENT
  DELIVERED
  DELAYED
  BOUNCED
  COMPLAINED
}

// ════════════════════════════════════════════════════════════════
// PHASE — HR (isolated)
// ════════════════════════════════════════════════════════════════
//
// HR data is the most sensitive in the system (medical, leave,
// discipline, payroll). The architecture mirrors the claims mail
// pipeline (inbox mode → authorship gate → parse → disposition →
// triage UI) with one structural difference: HR mail is STORED IN
// SEPARATE TABLES (HrEmail, HrMail, HrAttachment) and NEVER written
// to EmailMessage / EmailThread / ClaimMail. The 12+ existing email-
// read surfaces (sales suggested-inquiries, claims triage, exec
// coverage, inbox view, AI extraction cron, etc.) all query
// EmailMessage — so by design they cannot return HR rows. Adding a
// new email-read feature does not need to remember to "exclude HR";
// the table partition makes leakage structurally impossible rather
// than procedurally avoidable.
//
// Access is double-gated: every HR API route AND the nav entry call
// requireHrAccess() (src/lib/hr/allowlist.ts), which checks a
// hardcoded constant + HR_ALLOWLIST env override. A DB-managed flag
// was rejected here because a UI bug or schema migration that wrote
// the wrong row could escalate privilege; the code-reviewed constant
// can only change via a deploy.

// Employee — payroll/HR identity. Distinct from User (which is the
// access-control / login identity). 1:0..1 link from Employee to
// User: most current staff have an HQ login and the link is
// populated; non-login staff (future drivers / warehouse) can exist
// as Employees without a User row.
//
// Email-match fields: workEmail is the canonical address; personalEmails
// captures the secondary addresses HR mail might actually come from
// (Gmail personal accounts, payroll-provider addresses, etc.). The
// Sonnet employee-match step in onboardFromHrEmail searches both.
model Employee {
  id             String    @id @default(uuid())
  fullName       String
  workEmail      String?   @unique @map("work_email")
  personalEmails String[]  @map("personal_emails")
  title          String?
  department     String?
  isActive       Boolean   @default(true) @map("is_active")
  startedOn      DateTime? @map("started_on") @db.Date
  leftOn         DateTime? @map("left_on") @db.Date
  notes          String?   @db.Text

  // Nullable link to the HQ login. UNIQUE so the inverse on User
  // is a clean 1:1; reverse is User.employee.
  userId String? @unique @map("user_id")
  user   User?   @relation("EmployeeUserLink", fields: [userId], references: [id], onDelete: SetNull)

  hrMail        HrMail[]
  hrAttachments HrAttachment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hr_employees")
}

// HrEmail — parallel to EmailMessage; ISOLATED. Pubsub branches at
// the source (`if email === hr@sirreel.com`) and writes here instead
// of EmailMessage. This row is the single source-of-truth for an
// inbound HR Gmail message; the HrMail disposition + HrAttachment
// children point back to it.
model HrEmail {
  id              String  @id @default(uuid())
  // Same dedup contract EmailMessage has — Gmail's per-inbox id is
  // unique within an inbox; the RFC-2822 Message-Id is the cross-
  // inbox key (used for the staff-forward-into-hr@ idempotency check).
  gmailMessageId  String  @unique @map("gmail_message_id")
  rfc822MessageId String? @map("rfc822_message_id")
  inReplyTo       String? @map("in_reply_to")

  fromAddress     String   @map("from_address")
  toAddresses     String[] @map("to_addresses")
  subject         String
  snippet         String?  @db.Text
  bodyText        String?  @map("body_text") @db.Text
  bodyHtml        String?  @map("body_html") @db.Text
  bodySource      String?  @map("body_source")
  attachmentCount Int      @default(0) @map("attachment_count")
  routingHeaders  Json?    @map("routing_headers")

  sentAt DateTime @map("sent_at")
  isRead Boolean  @default(false) @map("is_read")

  // 0-or-1 — populated by onboardFromHrEmail. Null when the
  // background helper hasn't run yet (rare; fire-and-forget); the UI
  // treats missing disposition as "still being processed".
  hrMail      HrMail?
  attachments HrAttachment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([rfc822MessageId])
  @@index([sentAt(sort: Desc)])
  @@map("hr_emails")
}

enum HrCategory {
  TIMESHEET
  PTO_LEAVE
  MEDICAL
  PAYROLL
  BENEFITS
  DISCIPLINE
  COMPLAINT
  ONBOARDING
  RESIGNATION
  OTHER
}

enum HrDisposition {
  FILED // confident employee match + category assigned
  NEEDS_REVIEW // partial info — Wes/Dani assign manually
  IGNORED // non-HR noise (auto-replies, newsletters that slipped through)
}

// HrMail — disposition + parse snapshot per HrEmail. Mirror of
// ClaimMail's role on the claims side. employeeId is nullable for
// NEEDS_REVIEW + IGNORED rows; the triage UI lets Wes/Dani assign it.
model HrMail {
  id         String  @id @default(uuid())
  hrEmailId  String  @unique @map("hr_email_id")
  employeeId String? @map("employee_id")

  category    HrCategory
  disposition HrDisposition
  // Sonnet parse output: { employeeNameGuess, category, summary,
  // confidence, reasoning }. JSON keeps the surface flexible while
  // the classifier prompt evolves; the triage UI reads named keys.
  parse       Json?
  reason      String?

  dismissed    Boolean   @default(false)
  reviewedById String?   @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hrEmail    HrEmail   @relation(fields: [hrEmailId], references: [id], onDelete: Cascade)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  reviewedBy User?     @relation("HrMailReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([disposition, dismissed])
  @@map("hr_mail")
}

// HrAttachment — file metadata + Vercel Blob URL. Parallel to
// ClaimDocument with HR-specific category set. employeeId is set
// when the parent HrEmail's HrMail row links to an employee;
// orphaned attachments (NEEDS_REVIEW / IGNORED) keep employeeId null
// until the rep assigns the parent row.
model HrAttachment {
  id         String  @id @default(uuid())
  hrEmailId  String? @map("hr_email_id")
  employeeId String? @map("employee_id")

  category  HrCategory @default(OTHER)
  title     String
  fileUrl   String     @map("file_url")
  mimeType  String?    @map("mime_type")
  sizeBytes Int?       @map("size_bytes")
  notes     String?    @db.Text

  // AI classifier provenance — same idea as ClaimDocument.typeSource
  // (EMAIL_INGEST vs AI_SUGGESTED vs USER). Reuses the existing
  // DocTypeSource enum since the semantics are identical.
  typeSource     DocTypeSource? @map("type_source")
  typeConfidence Float?         @map("type_confidence")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  hrEmail  HrEmail?  @relation(fields: [hrEmailId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([hrEmailId])
  @@map("hr_attachments")
}

// ═══════════════════════════════════════════════════════════════
// PHASE INCIDENTS — hub between claim-mail, claims, and L&D billing
// ═══════════════════════════════════════════════════════════════
//
// Strategic frame: an incident's recovery paths in preference order
// are CARRIER CLAIM → BILL RENTER → ABSORB. The carrier-required
// floor that used to gate auto-drafted claims now lives on the
// "Upgrade to claim" action against an Incident, where it belongs.
//
// One incident can produce multiple claims (multi-carrier, joint
// renter+driver claims). Status reflects current posture, not a
// terminal — an incident can move through several (e.g.
// OPEN → CLAIM_FILED → BILLED_RENTER as the carrier pays a portion
// and we bill the renter for the deductible delta).
//
// Connections in this build are ADDITIVE — every existing
// InsuranceClaim / DamageItem / ClaimMail / ClaimDocument row keeps
// its prior shape; the new incidentId FKs are nullable and forward-
// only.

enum IncidentSource {
  EMAIL // claim-mail "Open incident report"
  RETURN_INSPECTION // captured during the L&D return-check (future
  //   bridge; not auto-created in this phase)
  MANUAL // dispatcher / rep clicks "+ New incident"
}

enum IncidentStatus {
  OPEN
  CLAIM_FILED // ≥1 InsuranceClaim with incidentId set
  BILLED_RENTER // ≥1 DamageItem with incidentId set + BILL_NOW
  RESOLVED // carrier + renter recovery complete
  WRITTEN_OFF // explicitly absorbed
}

/// Stored severity override on an Incident. NULL means "auto" — the
/// effective severity falls back to the heuristic in
/// src/lib/incidents/derive.ts (computeDerivedSeverity over linked
/// ClaimMail rows). Set explicitly when a human disagrees with the
/// auto-classification (escalate a quiet email to LITIGATION, or
/// downgrade an over-eager lawyer-domain false positive to ROUTINE).
enum IncidentSeverity {
  LITIGATION
  ROUTINE
}

model Incident {
  id             String         @id @default(uuid())
  // SR-INC-NNNN. Generated by nextIncidentNumber() via the
  // sr_incident_number_seq Postgres sequence (created in a follow-up
  // raw SQL after db push, same pattern as sr_claim_number_seq).
  incidentNumber String         @unique @map("incident_number")
  source         IncidentSource
  status         IncidentStatus @default(OPEN)

  // The Order / Asset / Company connection. All nullable so the
  // earliest possible Incident (an email arrives without enough info
  // to match an Order yet) still creates cleanly. The triage UI nags
  // when an Incident has been OPEN > N hours without an Order link.
  orderId   String? @map("order_id")
  assetId   String? @map("asset_id")
  companyId String? @map("company_id")

  description String    @db.Text
  // When the underlying loss occurred (if known). Distinct from
  // createdAt which is when the row landed in HQ. Carrier claims
  // require this; the upgrade-to-claim form forces it then.
  occurredAt  DateTime? @map("occurred_at") @db.Date

  // ── Phase 3 worklist teeth (all additive, all nullable) ─────────
  /// Severity override — NULL means "auto-derive from linked mail".
  /// API computes `effectiveSeverity = severity ?? derivedSeverity`.
  severity        IncidentSeverity? @map("severity")
  /// Who's actively working this incident. Phase 3 gate: anyone with
  /// canManageClaims (ADMIN + MANAGER + AGENT). Soft FK (SetNull on
  /// User delete) so a departing rep's incidents don't cascade.
  assigneeId      String?           @map("assignee_id")
  /// Human-owned next action. When set, the card surfaces this
  /// verbatim instead of the heuristic suggestion from
  /// computeSuggestedNextAction; when null, the heuristic shows as
  /// "Suggested:" with a "set action" affordance.
  nextAction      String?           @map("next_action") @db.Text
  /// When the assignee committed to having the next action done by.
  /// Indexed for the worklist's "overdue first" sort.
  nextActionDueAt DateTime?         @map("next_action_due_at")
  /// Driver who had the unit at time of loss. Distinct from the
  /// renter's primary booking contact (Order.jobContact). Backfilled
  /// from mail parse where available; editable in the card.
  driverName      String?           @map("driver_name")
  // ────────────────────────────────────────────────────────────────

  createdById String? @map("created_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  asset     Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("IncidentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee  User?    @relation("IncidentAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  claims      InsuranceClaim[]
  claimMail   ClaimMail[]
  documents   ClaimDocument[]
  damageItems DamageItem[]

  @@index([status])
  @@index([orderId])
  @@index([createdAt(sort: Desc)])
  @@index([nextActionDueAt])
  @@map("sr_incidents")
}

// ═══════════════════════════════════════
// PLANYO SYNC — daily Planyo→HQ reconciliation
// ═══════════════════════════════════════

enum PlanyoSyncOutcome {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED_PULL
  FAILED_INCOMPLETE
  FAILED_NETWORK
  FAILED_SUSPICIOUS_LOW
  ABORTED_SIGNATURE_MISMATCH
  REVERTED
}

enum PlanyoSyncOp {
  CREATE
  UPDATE_DATES
  UPDATE_QTY
  UPDATE_STATUS
  RELEASE
  RELEASE_CANDIDATE
  FLAG_UNMAPPED
  LOG_CONFLICT
  AMBIGUOUS_ABSENT
  NO_CHANGE
}

model PlanyoSyncRun {
  id               String            @id @default(uuid())
  startedAt        DateTime          @default(now()) @map("started_at")
  finishedAt       DateTime?         @map("finished_at")
  windowStart      DateTime          @map("window_start")
  windowEnd        DateTime          @map("window_end")
  outcome          PlanyoSyncOutcome @default(RUNNING)
  reason           String?           @db.Text
  lastPullCount    Int?              @map("last_pull_count")
  totalServerCount Int?              @map("total_server_count")
  createdCount     Int               @default(0) @map("created_count")
  updatedCount     Int               @default(0) @map("updated_count")
  releasedCount    Int               @default(0) @map("released_count")
  unmappedCount    Int               @default(0) @map("unmapped_count")
  conflictCount    Int               @default(0) @map("conflict_count")
  absentCount      Int               @default(0) @map("absent_count")
  noChangeCount    Int               @default(0) @map("no_change_count")
  dryRun           Boolean           @default(false) @map("dry_run")

  events PlanyoSyncEvent[]

  @@index([startedAt(sort: Desc)])
  @@map("planyo_sync_runs")
}

model PlanyoSyncEvent {
  id                  String        @id @default(uuid())
  runId               String        @map("run_id")
  run                 PlanyoSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  op                  PlanyoSyncOp
  planyoReservationId String?       @map("planyo_reservation_id")
  planyoCartId        String?       @map("planyo_cart_id")
  bookingId           String?       @map("booking_id")
  bookingItemId       String?       @map("booking_item_id")
  before              Json?
  after               Json?
  detail              String?       @db.Text
  createdAt           DateTime      @default(now()) @map("created_at")

  @@index([runId])
  @@index([planyoReservationId])
  @@map("planyo_sync_events")
}

// ═══════════════════════════════════════
// SITE SETTINGS (public marketing surface)
// ═══════════════════════════════════════
/// Admin-managed override of who receives a class of internal HQ
/// notification email. One row per channel `key` — the channel registry
/// (labels, descriptions, built-in defaults) lives in
/// src/lib/email/notificationChannels.ts, NOT here.
///
/// Row ABSENT  → the channel's built-in default applies (env var or the
///               hardcoded roster the channel shipped with).
/// Row PRESENT → its `emails` list is the WHOLE audience. An empty list
///               deliberately silences the channel (meaningful for
///               CC-type channels like the sales-team copy).
///
/// Managed at /admin/notifications (requireAdmin); every change is
/// audit-logged (action: notification_channel.update).
model NotificationChannel {
  key            String   @id
  emails         String[]
  updatedAt      DateTime @updatedAt @map("updated_at")
  updatedByEmail String?  @map("updated_by_email")

  @@map("sr_notification_channels")
}

/// Singleton config for the public marketing site (sirreel.com). One
/// row, keyed by the fixed id "singleton" — every read/write goes
/// through prisma.siteSetting.upsert({ where: { id: 'singleton' }, … }).
/// Admin-managed at /admin/site-settings (requireAdmin).
///
/// heroImageUrl / heroVideoUrl are PRIVATE Vercel Blob URLs (403 on a
/// direct fetch, same store as vehicle photos) — the Home hero serves
/// them through the public proxy /api/public/site-media/[slot], never
/// as a raw blob src.
model SiteSetting {
  id                  String  @id @default("singleton")
  /// The rep a self-serve job is assigned to when no agent is involved —
  /// shown to the client in the portal as "Your SirReel rep".
  ///
  /// Previously this was "first active ADMIN, oldest first", which is not a
  /// business rule: it silently routed every self-serve job to whoever
  /// happened to hold the oldest admin account, and could never pick a
  /// salesperson at all because AGENT role rows were excluded.
  defaultSalesAgentId String? @map("default_sales_agent_id")
  /// Required poster / static-background JPG for the Home hero, and the
  /// <video poster> shown before/if the video plays (private blob URL).
  heroPosterUrl       String? @map("hero_poster_url")
  /// Muted-loop MP4 background for the Home hero (private blob URL).
  heroVideoUrl        String? @map("hero_video_url")
  /// Optional lighter MP4 served under ~768px (private blob URL).
  heroVideoMobileUrl  String? @map("hero_video_mobile_url")

  /// Standing lot GATE CODE — the single code shared by all drivers until
  /// it's physically reprogrammed at the gate. This field only RECORDS the
  /// current value; changing it here does NOT change the physical gate.
  /// Sales agents (AGENT) + admins may edit it; edits are audit-logged by
  /// field name (mirroring the payment-info convention) plus who/when below.
  ///
  /// RELEASE POLICY (Wes 2026-08-22, superseding "never on a portal
  /// surface"): released two ways only —
  ///   1. the after-hours assistant, on a passing server-side verification
  ///   2. a NAMED DRIVER on their own /drive/[token] page, once production
  ///      or an agent has assigned them to a specific vehicle
  /// A driver has been named by the client or an agent, holds a personal
  /// token, and cannot do the job without getting through the gate. Every
  /// driver view is stamped on DriverAssignment.gateCodeViewedAt so a leak
  /// has a trail. Still never on a client-facing or public surface: the
  /// CLIENT gets the job's assistantAuthCode instead, which is theirs.
  gateCode            String?   @map("gate_code")
  gateCodeUpdatedAt   DateTime? @map("gate_code_updated_at")
  gateCodeUpdatedById String?   @map("gate_code_updated_by_id")

  /// Master switch for the public "Who we are" team section on /contact.
  /// Off until the roster + photos are set in /admin/who-we-are.
  whoWeAreEnabled Boolean @default(false) @map("who_we_are_enabled")

  /// PUBLIC downloadable forms (PDF, private blob URLs) — served via the
  /// public proxy /api/public/forms/[slot]. Managed at /admin/forms.
  /// These are the ONLY documents the site ever exposes for download.
  /// SENSITIVE docs are intentionally absent: ACH / payment info is
  /// request-only (routed to the contact intake, never a file link), and
  /// Credit-Card Authorization is CardPointe's domain — SirReel never
  /// collects, stores, or serves card data, so there is no field for it.
  /// STRUCTURED payment / ACH details — ADMIN-MANAGED, delivered by
  /// EMAIL ONLY via the /payment-info request flow (Wes ruled A). NEVER
  /// rendered in any HTML response, never a public file, never
  /// client-reachable. The old free-text `paymentDetails` blob was
  /// removed (never populated) — these fields are the ONLY entry path.
  /// Routing numbers are ABA-validated (9 digits + mod-10) at save.
  /// Changes are audit-logged by FIELD NAME only, never values.
  /// paymentPayeeName is the canonical payee / account-holder name.
  paymentPayeeName        String? @map("payment_payee_name")
  paymentBankName         String? @map("payment_bank_name")
  paymentAccountType      String? @map("payment_account_type")
  paymentAccountNumber    String? @map("payment_account_number")
  paymentRoutingAch       String? @map("payment_routing_ach")
  paymentRoutingWire      String? @map("payment_routing_wire")
  paymentRemittanceEmail  String? @map("payment_remittance_email")
  paymentBankAddress      String? @map("payment_bank_address") @db.Text
  paymentInstructions     String? @map("payment_instructions") @db.Text
  /// Zelle — the tag a client sends to, and the recipient name their banking
  /// app will show them to confirm. Zelle was previously ONLY on invoice PDFs
  /// (ZellePayBlock's hardcoded constants), so a client who asked how to pay
  /// was offered ACH, wire and card but not a method SirReel actually
  /// accepts. It belongs with the other payment fields, not inside a PDF
  /// component.
  paymentZelleHandle      String? @map("payment_zelle_handle")
  paymentZelleName        String? @map("payment_zelle_name")
  /// Two PRIVATE-Blob PDF attachments for the payment-info email —
  /// "ACH Payment Information Form (bank)" and "ACH / Wire Banking
  /// Information (SirReel)". Stored blobKey (server-side fetch) +
  /// original filename (attachment name). NEVER served by any public
  /// route/proxy — private storage + email attachment ONLY.
  paymentAchFormKey       String? @map("payment_ach_form_key")
  paymentAchFormFilename  String? @map("payment_ach_form_filename")
  paymentBankInfoKey      String? @map("payment_bank_info_key")
  paymentBankInfoFilename String? @map("payment_bank_info_filename")

  formCoiUrl             String? @map("form_coi_url")
  formW9Url              String? @map("form_w9_url")
  formRentalAgreementUrl String? @map("form_rental_agreement_url")
  formStudioContractUrl  String? @map("form_studio_contract_url")

  /// Home diagonal service-nav tile images (private blob URLs) — served
  /// via /api/public/site-media/[slot] and managed at /admin/home-tiles.
  /// Each is duotone-tinted to its tile color on the Home page; a null
  /// slot falls back to the solid tile color (graceful empty state).
  tileTruckingUrl       String? @map("tile_trucking_url")
  tileStagesUrl         String? @map("tile_stages_url")
  tileStandingSetsUrl   String? @map("tile_standing_sets_url")
  tileLedWallUrl        String? @map("tile_led_wall_url")
  tileSuppliesUrl       String? @map("tile_supplies_url")
  tileRadiosWifiUrl     String? @map("tile_radios_wifi_url")
  tileGripElectricUrl   String? @map("tile_grip_electric_url")
  tileWardrobeMakeupUrl String? @map("tile_wardrobe_makeup_url")

  /// Editable public-page hero titles (the H1 on each marketing page). Null →
  /// the page's built-in default copy (see src/lib/site/pageTitleDefaults.ts).
  /// Managed at /admin/site-settings.
  titleStandingSets String? @map("title_standing_sets")
  titleVehicles     String? @map("title_vehicles")
  titleContact      String? @map("title_contact")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sr_site_settings")
}

// =============================================
// PORTAL V2 — guided "collect-once" client portal
// =============================================

/// One row per paperwork token: the single "Your details" intake the
/// v2 portal captures once and threads into every document card.
/// Keyed by the PaperworkRequest token (validated in the API route —
/// intentionally no FK so this table stays fully additive).
model PortalV2Intake {
  id       String  @id @default(uuid())
  token    String  @unique
  fullName String? @map("full_name")
  title    String?
  company  String?
  email    String?
  phone    String?

  // Billing block — threaded into the CC-auth card
  billingAddress1 String? @map("billing_address1")
  billingAddress2 String? @map("billing_address2")
  billingCity     String? @map("billing_city")
  billingState    String? @map("billing_state")
  billingZip      String? @map("billing_zip")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("portal_v2_intake")
}

/// Transitional document store for the RentalWorks → HQ handover. The team
/// still creates quotes (and today, invoices) in RW; RW's API exposes no
/// PDF/print endpoint, so staff export the PDF from RW and attach it to the
/// Job here. HQ becomes the single place to FIND the document while RW
/// remains the system of record. Retire once quoting/invoicing is native.
enum JobDocumentKind {
  QUOTE
  INVOICE
  OTHER
}

model JobDocument {
  id     String          @id @default(uuid())
  jobId  String          @map("job_id")
  kind   JobDocumentKind @default(OTHER)
  /// Origin of the file. "RENTALWORKS" for RW exports; "INTERNAL" for
  /// anything staff produced outside RW.
  source String          @default("RENTALWORKS")

  /// The RW quote / invoice number printed on the document, for
  /// cross-reference against RW and the order.
  refNumber    String?   @map("ref_number")
  /// Face amount, denormalized for at-a-glance listing (not authoritative).
  amount       Decimal?  @db.Decimal(12, 2)
  documentDate DateTime? @map("document_date")

  fileKey          String  @map("file_key")
  fileUrl          String  @map("file_url")
  originalFilename String  @map("original_filename")
  fileSize         Int     @map("file_size")
  mimeType         String  @map("mime_type")
  note             String? @db.Text

  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation("JobDocumentUploader", fields: [uploadedById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, deletedAt])
  @@map("sr_job_documents")
}

/// Read-only mirror of RentalWorks invoices.
///
/// RW's invoice/browse supports NO server-side filtering (every
/// searchFields query 400s, even on Status), so we bulk-pull and cache a
/// slim projection here. Pages then read HQ instead of hitting RW live —
/// which also removes the silent-$0 failure mode when the RW token expires
/// (a stale mirror is honest; a zeroed live fetch is not).
///
/// Joined to HQ by rwCustomerId -> Company.rentalworksCustomerId (97%
/// populated). Job-level joining is NOT possible: Booking.rentalworksOrderId
/// is unpopulated. Retire with RW.
model RwInvoice {
  id                 String    @id @default(uuid())
  rwInvoiceId        String    @unique @map("rw_invoice_id")
  invoiceNumber      String?   @map("invoice_number")
  invoiceType        String?   @map("invoice_type")
  status             String?
  invoiceDate        DateTime? @map("invoice_date")
  dueDate            DateTime? @map("due_date")
  rwOrderId          String?   @map("rw_order_id")
  orderNumber        String?   @map("order_number")
  rwCustomerId       String?   @map("rw_customer_id")
  customerName       String?   @map("customer_name")
  poNumber           String?   @map("po_number")
  /// The evidence fields that make job<->order matching possible. `deal` is
  /// RW's production name and lines up with Job.name; `agent` lines up with
  /// the HQ job agent; billing dates are the real rental window.
  dealName           String?   @map("deal_name")
  dealNumber         String?   @map("deal_number")
  orderDescription   String?   @map("order_description")
  invoiceDescription String?   @map("invoice_description")
  agent              String?
  billingStartDate   DateTime? @map("billing_start_date")
  billingEndDate     DateTime? @map("billing_end_date")
  orderDate          DateTime? @map("order_date")
  invoiceTotal       Decimal   @default(0) @map("invoice_total") @db.Decimal(12, 2)
  receivedTotal      Decimal   @default(0) @map("received_total") @db.Decimal(12, 2)
  remainingTotal     Decimal   @default(0) @map("remaining_total") @db.Decimal(12, 2)
  syncedAt           DateTime  @default(now()) @map("synced_at")

  @@index([rwCustomerId])
  @@index([remainingTotal])
  @@map("sr_rw_invoices")
}

/// The payment EVENT the RW mirror cannot express. The mirror is deleted and
/// recreated on every sync, so "when did this invoice get paid" is knowable
/// only by noticing the transition: a nightly sync where remaining hits zero
/// on an invoice that had a balance. One row per invoice, written the first
/// sync that sees it paid, carrying snapshots (the mirror row it describes
/// will be dropped on the next sync).
///
/// This is the feedstock for days-to-pay per client. observedPaidAt is at
/// sync granularity (~daily) — good enough for payment-behavior metrics,
/// useless for intraday anything.
///
/// preTracking: rows seeded when tracking began (2026-08-18) for invoices
/// ALREADY paid — their true payment date is unknown, so they are excluded
/// from latency math but must exist so later syncs don't "observe" them
/// freshly and pollute the metric with garbage dates.
model RwInvoicePaidObservation {
  id             String    @id @default(uuid())
  rwInvoiceId    String    @unique @map("rw_invoice_id")
  invoiceNumber  String?   @map("invoice_number")
  customerName   String?   @map("customer_name")
  rwCustomerId   String?   @map("rw_customer_id")
  invoiceDate    DateTime? @map("invoice_date")
  dueDate        DateTime? @map("due_date")
  invoiceTotal   Decimal   @default(0) @map("invoice_total") @db.Decimal(12, 2)
  observedPaidAt DateTime  @default(now()) @map("observed_paid_at")
  preTracking    Boolean   @default(false) @map("pre_tracking")

  @@index([customerName])
  @@index([observedPaidAt])
  @@map("sr_rw_invoice_paid_observations")
}

/// Ana's ruling on an aged receivable — the review that used to live in
/// emailed spreadsheets, kept in HQ instead (Wes, 2026-08-19). One row per
/// invoice, upserted; the latest decision stands and EmailDelivery-style
/// history is deliberately not kept (the decision is the record, not the
/// deliberation).
///
///   STILL_OWED  keep chasing — stays in the receivable and the worklist
///   DISPUTE     contested — stays in the receivable, flagged
///   WRITE_OFF   deemed uncollectible — leaves the Outstanding tile and the
///               collectible list (like a paid-mark), and becomes a line in
///               the bad-debt tax report with the decided date and amount
///
/// Snapshots (number/customer/amount) because the mirror row this describes
/// is recreated nightly and may vanish entirely — a tax-claim line must
/// outlive its source, same reasoning as RwCollectionCharge.
model RwInvoiceTriage {
  id            String   @id @default(uuid())
  rwInvoiceId   String   @unique @map("rw_invoice_id")
  decision      String
  note          String?
  invoiceNumber String?  @map("invoice_number")
  customerName  String?  @map("customer_name")
  amount        Decimal  @default(0) @db.Decimal(12, 2)
  decidedById   String?  @map("decided_by_id")
  decidedAt     DateTime @default(now()) @map("decided_at")

  @@index([decision])
  @@map("sr_rw_invoice_triage")
}

/// "This receivable is waiting on an insurance carrier, not the client."
/// Manual flag (Wes, 2026-08-19) — nothing in RW distinguishes the payer
/// (every invoice is type BILLING), and the claims pod is too young to
/// auto-link, so the person who knows sets it. Absence of a row means the
/// default: waiting on client payment. Optional claimNumber ties it to the
/// claims pod when one exists.
model RwInvoiceInsuranceFlag {
  id          String   @id @default(uuid())
  rwInvoiceId String   @unique @map("rw_invoice_id")
  claimNumber String?  @map("claim_number")
  note        String?
  flaggedById String?  @map("flagged_by_id")
  flaggedAt   DateTime @default(now()) @map("flagged_at")

  @@map("sr_rw_invoice_insurance_flags")
}

/// Links an HQ Job to a RentalWorks ORDER (by order number). One RW order
/// has many invoices, so linking at the ORDER level rolls every current and
/// future invoice for that order up to the job automatically.
///
/// Deliberately its OWN table keyed on the order number rather than a column
/// on RwInvoice: the mirror is deleted and recreated on every sync, so a link
/// stored on those rows would be wiped. Retire with RW.
/// Mirror of RentalWorks QUOTES — pre-invoice orders. RW quotes share the
/// order-number sequence (a quote's number survives conversion to an order,
/// verified 2026-08-22: quote 304485 sits in the same 30xxxx sequence as the
/// invoice mirror's order numbers), so linking a JobRwOrder against a QUOTE's
/// number is future-proof: the invoices that eventually carry it roll up
/// automatically. Wiped and rebuilt on every sync like RwInvoice; `raw`
/// keeps the full named row so unmapped columns are never lost. Retire with RW.
model RwQuote {
  id           String    @id @default(uuid())
  rwQuoteId    String    @map("rw_quote_id")
  quoteNumber  String?   @map("quote_number")
  orderNumber  String?   @map("order_number")
  status       String?
  quoteDate    DateTime? @map("quote_date")
  rwCustomerId String?   @map("rw_customer_id")
  customerName String?   @map("customer_name")
  dealName     String?   @map("deal_name")
  dealNumber   String?   @map("deal_number")
  description  String?
  agent        String?
  startDate    DateTime? @map("start_date")
  endDate      DateTime? @map("end_date")
  total        Decimal?  @db.Decimal(12, 2)
  raw          Json?
  syncedAt     DateTime  @map("synced_at")

  @@index([rwCustomerId])
  @@index([orderNumber])
  @@map("sr_rw_quotes")
}

/// Number → internal-id reference for RentalWorks ORDERS, plus enough
/// header to label a link. RW's browse endpoints reject every
/// server-side filter shape (same defect the invoice + quote syncs
/// document), and GET /api/v1/order/{id} takes only the internal
/// OrderId — so opening "RW order #304486" requires this mapping.
/// Populated lazily: a cache miss triggers a full order/browse page
/// scan that upserts every row (~4k), so one miss warms the whole
/// table. See src/lib/rentalworks/orderRef.ts.
model RwOrderRef {
  id           String    @id @default(uuid())
  rwOrderId    String    @unique @map("rw_order_id")
  orderNumber  String    @map("order_number")
  description  String?
  customerName String?   @map("customer_name")
  dealName     String?   @map("deal_name")
  status       String?
  total        Decimal?  @db.Decimal(12, 2)
  orderDate    DateTime? @map("order_date")
  syncedAt     DateTime  @map("synced_at")

  @@index([orderNumber])
  @@map("sr_rw_order_refs")
}

/// A bookable stage's INTERIOR AREAS — the rooms and lots that live inside
/// a stage rental rather than being rented on their own (Wes 2026-08-24:
/// "we will only have 3 options: Standing Sets, LED/Volume Stage and Black
/// Box. The rest should be selectable as utilized areas under that rental";
/// parking lots are "additional spaces that can be connected to a hold").
///
/// These were Assets until 2026-08-24 — one board row each, 14 rows for a
/// studio that can really only be sold three ways. They carried ZERO
/// BookingAssignments (verified before the move), so nothing was lost by
/// retiring those Asset rows; the names live on here.
///
/// Areas do NOT consume capacity. Selecting six rooms on a Standing Sets
/// hold still occupies exactly one stage.
model StageArea {
  id          String   @id @default(uuid())
  name        String   @unique
  /// ROOM (interior set/office) or PARKING (exterior lot). Groups the picker.
  kind        String   @default("ROOM")
  /// The stage this area lives INSIDE, by unit name — e.g. Hospital,
  /// Police/Jail and Morgue are sets within Standing Sets (Wes
  /// 2026-08-24: "Lankershim Studios has three main stages within the
  /// complex"). NULL = complex-wide and offered on every stage (green
  /// rooms, offices, parking). Scoped by NAME rather than assetId so a
  /// retired/re-created stage Asset can't orphan the mapping.
  parentStage String?  @map("parent_stage")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  bookingItems BookingItemStageArea[]

  @@map("sr_stage_areas")
}

/// Which areas a given stage hold is using. Join is explicit so an area
/// can later carry per-booking notes without a schema rewrite.
model BookingItemStageArea {
  id            String   @id @default(uuid())
  bookingItemId String   @map("booking_item_id")
  stageAreaId   String   @map("stage_area_id")
  createdAt     DateTime @default(now()) @map("created_at")

  bookingItem BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  stageArea   StageArea   @relation(fields: [stageAreaId], references: [id], onDelete: Cascade)

  @@unique([bookingItemId, stageAreaId])
  @@index([stageAreaId])
  @@map("sr_booking_item_stage_areas")
}

model JobRwOrder {
  id            String   @id @default(uuid())
  jobId         String   @map("job_id")
  rwOrderNumber String   @map("rw_order_number")
  linkedById    String?  @map("linked_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rwOrderNumber])
  @@index([rwOrderNumber])
  @@map("sr_job_rw_orders")
}

/// The FINAL invoice for a job — the number Jose lands on after the back and
/// forth with the client, uploaded from the job page and queued for Ana to
/// collect.
///
/// This is the handoff between sales and collections. Before it existed, the
/// collections screen listed every open RW invoice with no signal about which
/// were actually agreed and ready to charge; "final" was knowledge that lived
/// only in Jose's inbox.
///
/// jobId is a REAL relation — Job is HQ-native and stable, unlike the RW
/// invoice mirror (which is dropped and rebuilt each sync, hence the string
/// keys on RwCollectionCharge). rwInvoiceId/invoiceNumber are optional: the
/// final number may or may not correspond to a single RW invoice.
///
/// Interim shape. When billing moves into HQ this is replaced by a "finalize"
/// action on the HQ invoice itself, and the PDF upload goes away.
model JobFinalInvoice {
  id            String    @id @default(uuid())
  jobId         String    @map("job_id")
  /// Optional pointer at the RW mirror row this settles. String, not a
  /// relation — the mirror is recreated on every sync.
  rwInvoiceId   String?   @map("rw_invoice_id")
  invoiceNumber String?   @map("invoice_number")
  /// The agreed final amount. What Ana charges unless she overrides it.
  amount        Decimal   @db.Decimal(12, 2)
  pdfUrl        String?   @map("pdf_url")
  pdfKey        String?   @map("pdf_key")
  /// READY (awaiting collection) | COLLECTED | VOID. Not an enum: this whole
  /// model is interim, and a Postgres enum is the one thing that makes
  /// retiring it awkward.
  status        String    @default("READY")
  note          String?
  uploadedById  String?   @map("uploaded_by_id")
  uploadedAt    DateTime  @default(now()) @map("uploaded_at")
  /// Payment-options email: when it last went out and to whom. Stamped on
  /// every send including manual resends — this is delivery state, not an
  /// audit log (EmailDelivery keeps the per-send record). Null = never sent,
  /// which the collections queue surfaces so Ana knows the client has NOT
  /// been told how to pay.
  emailedAt     DateTime? @map("emailed_at")
  emailedTo     String?   @map("emailed_to")
  /// How the money actually arrived, stamped when status flips COLLECTED.
  /// CARD is stamped by the charge route; WIRE/ACH/ZELLE/CHECK/OTHER by the
  /// Mark-collected action, because those arrive at the bank, not through HQ.
  /// String, not an enum — same interim-model reasoning as `status`.
  collectedAt   DateTime? @map("collected_at")
  collectedVia  String?   @map("collected_via")
  collectedById String?   @map("collected_by_id")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status, uploadedAt])
  @@index([jobId])
  @@map("sr_job_final_invoices")
}

/// A card charge taken in the collections workspace against a RentalWorks
/// invoice, for money collected BEFORE billing moves into HQ.
///
/// Keyed on rw_invoice_id as a STRING, not a relation — the RwInvoice mirror
/// is deleted and recreated on every sync, so a foreign key would be wiped
/// (same reason RwInvoicePaidMark does it this way). invoice_number and
/// customer_name are SNAPSHOTS for the same reason: a payment record must
/// outlive the mirror row it was taken against.
///
/// NOT the Payment table: Payment requires an HQ Invoice, and these invoices
/// live in RentalWorks. Retire alongside RW.
///
/// `amount` is what the invoice is credited. `surcharge_amount` is the 3% card
/// fee charged ON TOP at the gateway — the customer's card was debited
/// amount + surcharge_amount. Same split as Payment, so the two read alike.
model RwCollectionCharge {
  id              String   @id @default(uuid())
  rwInvoiceId     String   @map("rw_invoice_id")
  invoiceNumber   String?  @map("invoice_number")
  customerName    String?  @map("customer_name")
  amount          Decimal  @db.Decimal(12, 2)
  surchargeAmount Decimal? @map("surcharge_amount") @db.Decimal(10, 2)
  cardLast4       String?  @map("card_last4")
  cardType        String?  @map("card_type")
  cardholderName  String?  @map("cardholder_name")
  /// CardPointe response fields, kept for dispute evidence and reconciliation.
  authCode        String?  @map("auth_code")
  retref          String?
  respText        String?  @map("resp_text")
  /// Raw gateway verdict fields. Approval classification runs on these, and
  /// this gateway omits respstat entirely — so without them a misclassified
  /// charge is undiagnosable after the fact: the row would read DECLINED with
  /// no record of what CardConnect actually returned.
  respCode        String?  @map("resp_code")
  respStat        String?  @map("resp_stat")
  /// APPROVED | DECLINED | ERROR. Declines are recorded too — a collections
  /// call that failed is information, and silently dropping it makes the
  /// history lie about how often cards bounce.
  status          String   @default("APPROVED")
  /// The RW invoice PDF the operator dropped in. Private blob + key.
  pdfUrl          String?  @map("pdf_url")
  pdfKey          String?  @map("pdf_key")
  note            String?
  chargedById     String?  @map("charged_by_id")
  chargedAt       DateTime @default(now()) @map("charged_at")

  /// Reversal. 'VOID' pre-settlement, 'REFUND' post-settlement — the gateway
  /// decides which is possible, we record which happened. Kept on the charge
  /// rather than as a negative row so a reversed charge reads as one event,
  /// matching how Payment tracks voidedAt instead of negative amounts.
  reversals RwCollectionReversal[]

  reversedAt     DateTime? @map("reversed_at")
  reversalKind   String?   @map("reversal_kind")
  reversalRetref String?   @map("reversal_retref")
  reversalAmount Decimal?  @map("reversal_amount") @db.Decimal(12, 2)
  reversalReason String?   @map("reversal_reason")
  reversedById   String?   @map("reversed_by_id")

  @@index([rwInvoiceId])
  @@index([chargedAt])
  @@map("sr_rw_collection_charges")
}

/// HQ-side "paid" override for a RentalWorks invoice. RW's status (CLOSED /
/// VOID / NEW / PROCESSED) is authoritative, but RW can lag — an invoice
/// collected today may sit NEW for days. Staff mark it paid here to clear it
/// from HQ AR without waiting on RW. Keyed on rw_invoice_id (NOT a relation)
/// because the mirror is deleted/recreated each sync. Reversible.
model RwInvoicePaidMark {
  id          String   @id @default(uuid())
  rwInvoiceId String   @unique @map("rw_invoice_id")
  note        String?
  markedById  String?  @map("marked_by_id")
  markedAt    DateTime @default(now()) @map("marked_at")

  @@map("sr_rw_invoice_paid_marks")
}

/// A scoped, revocable link that lets a client's accounts-payable team read
/// SirReel's banking details WITHOUT holding a portal session.
///
/// Producers authorize the job; a separate A/P department pays it. Before
/// this, the producer read the details in the portal and retyped or forwarded
/// them — putting the numbers back into email at the client's end, which is
/// the hop invoice-redirect fraud exploits.
///
/// The share email carries NO account numbers, only this token's URL, so
/// there is nothing in the message for an attacker to alter. Access is
/// limited to the payment-details page: it is not portal access, and it does
/// not expose agreements, invoices or the card authorization.
model PaymentDetailsShare {
  id             String    @id @default(uuid())
  /// Random, not sequential — the URL is the credential.
  token          String    @unique
  /// The portal session that created the share, when one did. Null for a
  /// share minted by the public payment-info request flow, where the
  /// requester has no portal session.
  portalAccessId String?   @map("portal_access_id")
  /// PORTAL — a producer sent it from the job portal.
  /// PUBLIC_REQUEST — someone asked via the payment-info form.
  createdVia     String    @default("PORTAL") @map("created_via")
  /// Resolved CRM person for a PUBLIC_REQUEST share, for audit.
  personId       String?   @map("person_id")
  sentToEmail    String    @map("sent_to_email")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  /// First view and running count — an unviewed share is a signal the email
  /// never landed, and a surprising view count is worth someone looking at.
  firstViewedAt  DateTime? @map("first_viewed_at")
  viewCount      Int       @default(0) @map("view_count")

  @@index([token])
  @@index([portalAccessId])
  @@map("sr_payment_details_shares")
}

/// One reversal of a collections charge — a void, a full refund, or a
/// PARTIAL refund. A ledger, not a flag, because a charge can be refunded
/// more than once: the single reversal_* columns on RwCollectionCharge could
/// record exactly one, so a second partial had nowhere to go and the first
/// one's amount silently became the whole story.
///
/// Those columns remain for the rows written before this table existed (they
/// were backfilled here) but are no longer the source of truth — read this.
model RwCollectionReversal {
  id          String   @id @default(uuid())
  chargeId    String   @map("charge_id")
  /// VOID annuls the whole authorization pre-settlement and is therefore
  /// never partial. REFUND returns money post-settlement and may be.
  kind        String
  /// Gateway reference for the reversal. A void returns the ORIGINAL retref
  /// (it annuls that transaction); a refund returns a new one.
  retref      String?
  amount      Decimal  @db.Decimal(12, 2)
  reason      String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  charge RwCollectionCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([chargeId])
  @@map("sr_rw_collection_reversals")
}

/// Every call SirReel makes to the CardPointe gateway, with the raw response.
///
/// Wes, 2026-08-14: AuthResponse.raw was documented as "exposed so callers can
/// persist for forensics" and no caller ever did. So when Fiserv's validation
/// review reported that a merchant-initiated charge returned `cvvresp: N`, we
/// could not see it ourselves, could not check the other test transactions,
/// and could not confirm the fix without asking them to re-run it.
///
/// Written from the client layer rather than by callers, because "each caller
/// should persist this" is exactly the arrangement that produced nothing.
///
/// Redacted on the way in: tokens and account numbers are reduced to last 4,
/// and any CVV/PIN/track key is dropped. `cvvresp` and `avsresp` are RESPONSE
/// CODES, not cardholder data, and are the fields worth keeping — they answer
/// "what did we send, and what did the network think of it".
model CardpointeGatewayCall {
  id         String   @id @default(cuid())
  /// auth | void | refund | inquire
  operation  String
  merchid    String?
  retref     String?
  /// Authoritative approval flag: A approved, B retry, C declined.
  respstat   String?
  respcode   String?
  resptext   String?
  /// Amount the gateway reports acting on — with surcharging enabled this
  /// can exceed what we sent.
  amount     String?
  /// CVV match result. The VALUE, not the presence, says whether a CVV
  /// reached the gateway: M/N mean one was submitted and judged, P means it
  /// was not processed at all, S means the card carries none. A gateway that
  /// received no CVV still answers "P", so presence proves nothing. M or N on
  /// a merchant-initiated charge is the thing that must never happen.
  /// See src/lib/cardpointe/callFlags.ts for the measurements behind this.
  cvvresp    String?
  /// Address/postal verification result.
  avsresp    String?
  /// HTTP status, so a gateway outage is distinguishable from a decline.
  httpStatus Int?     @map("http_status")
  /// Redacted request and response payloads.
  request    Json?
  response   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([retref])
  @@index([operation, createdAt])
  @@index([createdAt])
  @@map("sr_cardpointe_gateway_calls")
}

enum ClientDetailReplyStatus {
  PENDING
  APPLIED
  DISMISSED
}

/// A client's own answer to "what's the production company and project
/// name?", typed on the no-login /details/<token> page the Quick Reply
/// email links to.
///
/// Email cannot carry working input fields — Gmail strips <form>, Outlook
/// never supported it — so the ask that used to end in "just reply with
/// those" now also offers a one-tap page. The answer lands here as
/// STRUCTURED data instead of prose in an inbox someone has to re-key.
///
/// Deliberately NOT applied to anything on arrival (Wes, 2026-08-25): an
/// unauthenticated reply naming the client on a booking is a SUGGESTION,
/// not a fact — the person answering may not be the one who books, and a
/// typo would otherwise become a real Company row. An agent accepts it,
/// and accepting seeds the normal CompanyPicker / JobResolver flows so
/// their near-match and find-or-create discipline still applies.
///
/// Bound to whichever context existed when the email went out. Usually
/// the INQUIRY: the ask fires precisely when we have no company, and a
/// soft hold needs one, so there is normally no Booking yet. bookingId is
/// set for the narrower case where holds exist but the job is unnamed.
/// Both null is not allowed in practice — the token always carries one.
model ClientDetailReply {
  id String @id @default(uuid())

  inquiryId String?  @map("inquiry_id")
  inquiry   Inquiry? @relation("InquiryDetailReplies", fields: [inquiryId], references: [id], onDelete: Cascade)
  bookingId String?  @map("booking_id")
  booking   Booking? @relation("BookingDetailReplies", fields: [bookingId], references: [id], onDelete: Cascade)

  /// Verbatim as typed. Never matched or normalized on write — matching is
  /// the agent's accept step, through the pickers that already do it well.
  companyName String? @map("company_name")
  projectName String? @map("project_name")

  /// The address the email was SENT to, taken from the signed token, never
  /// from the form. A submitter cannot claim to be someone else.
  sentToEmail String? @map("sent_to_email")

  status       ClientDetailReplyStatus @default(PENDING)
  resolvedById String?                 @map("resolved_by_id")
  resolvedBy   User?                   @relation("DetailReplyResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?               @map("resolved_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([inquiryId])
  @@index([bookingId])
  @@index([status])
  @@map("sr_client_detail_replies")
}
