// ═══════════════════════════════════════════════════════════════
// SIRREEL PLATFORM — PRISMA SCHEMA
// 21 Tables · 11 Sections · All Relationships Defined
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════
// 1. FLEET & ASSETS
// ═══════════════════════════════════════

enum Location {
  LANKERSHIM
  NAPA
  UTAH
  CHESTNUT // legacy
  LIMA // legacy
  ON_RENTAL
  IN_TRANSIT
  BODY_SHOP
  HIGH_TECH
}

enum AssetStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
  IN_TRANSIT
  WAREHOUSE
  RETIRED
  SOLD
  STOLEN
  TOTALED // insurance write-off — terminal (out of fleet), unit kept for history
}

enum AssetTier {
  PREMIUM
  STANDARD
  ECONOMY
}

enum Region {
  LA
  NORCAL
  UTAH
}

model AssetCategory {
  id                String             @id @default(uuid())
  name              String // "Cube Truck", "PopVan", "Studios"
  slug              String             @unique // "cube-truck"
  totalUnits        Int                @map("total_units")
  dailyRate         Decimal            @map("daily_rate") @db.Decimal(10, 2)
  weeklyRate        Decimal?           @map("weekly_rate") @db.Decimal(10, 2)
  minRentalHours    Int                @default(24) @map("min_rental_hours")
  maxRentalDays     Int                @default(365) @map("max_rental_days")
  region            Region             @default(LA)
  isPublished       Boolean            @default(true) @map("is_published")
  // Soft-delete / archive — mirrors InventoryItem. `isActive=false` is the
  // archived state (hidden from the default Fleet Pricing list + pickers);
  // `archivedAt` records WHEN for the audit trail. Archive (not hard-delete)
  // is the only safe option once a category has Asset units / order lines /
  // rate-change history, so the row survives for those FK references and
  // existing quotes/invoices stay intact. Restore flips back to true/null.
  isActive          Boolean            @default(true) @map("is_active")
  archivedAt        DateTime?          @map("archived_at")
  /// This category cannot be a will-call: SirReel has to deliver it and
  /// collect it. Restroom trailers are the founding case (Wes 2026-08-28) —
  /// a client cannot tow one, so an order holding one that isn't marked for
  /// delivery and pickup is an order with no truck booked.
  ///
  /// A SUGGESTION, not a constraint. The order page prompts sales to mark
  /// both and they click once; nothing auto-flips Order.deliveryRequested
  /// behind them, because a silent write is how a delivery gets scheduled
  /// that nobody meant to promise.
  requiresDelivery  Boolean            @default(false) @map("requires_delivery")
  // Operator-facing flag for the "+ New Hold" picker on the gantt
  // /reservations page. Orthogonal to isPublished — that controls
  // storefront / quote-side visibility; this controls whether the
  // category is a sensible target for an asset-bound hold in the
  // operator scheduler. Default true so new categories show up; flip
  // false on test rigs and any other unit-tracked category that
  // shouldn't surface in the operator picker.
  reservableOnGantt Boolean            @default(true) @map("reservable_on_gantt")
  description       String?            @db.Text
  imageUrl          String?            @map("image_url")
  sortOrder         Int                @default(0) @map("sort_order")
  // Phase 2 sales pipeline — see InventoryItem for semantics.
  aliases           String[]           @default([])
  department        LineItemDepartment
  // Defensive RW columns (May 2026). The May spike doesn't write to
  // AssetCategory rows, but Phase 4 may map RW Categories ↔ SirReel
  // AssetCategory; columns are in place to avoid a re-migration.
  needsReview       Boolean            @default(false) @map("needs_review")
  rwLastSyncedAt    DateTime?          @map("rw_last_synced_at")
  rwId              String?            @map("rw_id")

  // Integration IDs
  planyoResourceId   Int?    @unique @map("planyo_resource_id")
  rentalworksCategId String? @map("rentalworks_category_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  assets            Asset[]
  bookingItems      BookingItem[]
  orderLineItems    OrderLineItem[]
  rateChangeLogs    RateChangeLog[]
  vehicleCategories VehicleCategory[]

  @@index([rwId])
  @@index([needsReview])
  @@map("asset_categories")
}

model Asset {
  id            String      @id @default(uuid())
  categoryId    String      @map("category_id")
  unitName      String      @map("unit_name") // "18", "Sprinter #2 (A)", "Lankershim Studio"
  status        AssetStatus @default(AVAILABLE)
  location      Location    @default(LANKERSHIM)
  tier          AssetTier   @default(STANDARD)
  // 1–5 age/condition class for the fleet-assignment optimizer.
  // Distinct from the legacy `tier` field above (3-bucket marketing
  // tier: PREMIUM/STANDARD/ECONOMY). equipmentTier matches
  // ProductionTypeProfile.tier pools: tier=5 routes to newest-gear
  // pool, tier=1 to oldest. Nullable until the fleet team backfills
  // the 5-bucket classification across the inventory.
  equipmentTier Int?        @map("equipment_tier")

  // Vehicle details
  vin          String? @db.VarChar(20)
  licensePlate String? @map("license_plate") @db.VarChar(20)
  year         Int?
  make         String? @db.VarChar(50)
  model        String? @db.VarChar(50)
  mileage      Int?

  // Valuation (for insurance claims)
  purchasePrice      Decimal? @map("purchase_price") @db.Decimal(12, 2)
  currentValue       Decimal? @map("current_value") @db.Decimal(12, 2)
  // CRH §6.2 — INTERNAL ONLY. Never surface in any client-facing endpoint.
  // The portal data endpoint's Prisma select clause is the audit checkpoint;
  // any new selector that touches `assets` must explicitly exclude these.
  insurancePolicyNum String?  @map("insurance_policy_num") @db.VarChar(50)
  insuranceCardUrl   String?  @map("insurance_card_url")

  // CRH DOT packet (client-facing). Registration + BIT certificate live on
  // the Asset because that's our existing Vehicle equivalent in this
  // schema. Each has an expiry the daily cron uses to alert fleet (Julian
  // + Chris) at 30 days out, and a soft-block guard on job assignment when
  // the rental return date falls after the doc expires.
  registrationUrl         String?   @map("registration_url")
  registrationExpiresAt   DateTime? @map("registration_expires_at") @db.Date
  bitCertificateUrl       String?   @map("bit_certificate_url")
  bitCertificateExpiresAt DateTime? @map("bit_certificate_expires_at") @db.Date

  // Per-vehicle keypad / lockbox access code. Released through the
  // after-hours assistant's server-side verification, by an agent
  // verbally, or — Wes 2026-08-22 — to a NAMED DRIVER on their own
  // /drive/[token] page for THE VEHICLE THEY ARE ASSIGNED TO and only
  // when that pickup is unattended (blindPickup), since the instructions
  // in that case are literally "keys are in the lockbox" and there is no
  // one there to let them in. Never for a vehicle they aren't driving,
  // and never on a client-facing or public surface.
  accessCode String? @map("access_code") @db.VarChar(40)

  // Integration IDs
  rentalworksAssetId String? @map("rentalworks_asset_id")
  damageIdRef        String? @map("damage_id_ref")

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  category           AssetCategory       @relation(fields: [categoryId], references: [id])
  // Unified catalog FK (Aug 2026). Coexists with the AssetCategory FK
  // through the cutover — readers prefer this one, the legacy column
  // stays populated so nothing has to be dropped. See InventoryItem.
  catalogItemId      String?             @map("catalog_item_id")
  catalogItem        InventoryItem?      @relation(fields: [catalogItemId], references: [id])
  bookingAssignments BookingAssignment[]
  maintenanceRecords MaintenanceRecord[]
  dispatchTasks      DispatchTask[]
  inspections        Inspection[]
  insuranceClaims    InsuranceClaim[]
  incidents          Incident[]
  checkoutRecords    CheckoutRecord[]
  lotChecks          LotCheck[]
  bitInspections     BitInspection[]

  @@index([catalogItemId])
  @@map("assets")
}

// DOT BIT (Biennial Inspection of Terminals) inspection history per vehicle
// unit (DOT paperwork Phase 1 — data foundation). A unit accumulates many
// over time; the "current" BIT is the one with the latest inspectionDate.
// Distinct from the legacy single-slot Asset.bitCertificateUrl /
// bitCertificateExpiresAt fields (a current-cert pointer the alert cron
// reads) — this model is the dated, PDF-backed history.
//
// pdfBlobKey holds the PRIVATE Vercel Blob URL (access:'private'); the PDF
// is served only through the gated proxy via streamPrivateBlobAsResponse,
// never a public CDN URL.
model BitInspection {
  id             String   @id @default(uuid())
  assetId        String   @map("asset_id")
  inspectionDate DateTime @map("inspection_date") @db.Date
  pdfBlobKey     String   @map("pdf_blob_key")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, inspectionDate(sort: Desc)])
  @@map("bit_inspections")
}

// ═══════════════════════════════════════
// 2. CLIENTS & CRM
// ═══════════════════════════════════════

enum ClientTier {
  VIP
  PREFERRED
  STANDARD
  NEW
}

/// How often a client negotiates rates. Set on Company; drives the
/// "Negotiates" badge on lists + the Discount profile section on
/// the client file. NONE = doesn't negotiate; ALWAYS = expects a
/// discount on every quote.
enum DiscountTendency {
  NONE
  OCCASIONAL
  FREQUENT
  ALWAYS
}

enum ProductionType {
  FILM
  TV
  COMMERCIAL
  MUSIC_VIDEO
  CORPORATE
  EVENT_PLANNER
  OTHER
}

// Lookup table for production-type metadata that drives the
// future fleet-assignment optimizer (commit 1 of the production-
// type tiering work, May 2026). Distinct from the legacy
// ProductionType enum above — that enum is a free-form category
// label on Job / Company; this table carries the structured tier +
// sales-mode + price-sensitivity profile used by routing logic.
// The two coexist; later commits will migrate writers across.
model ProductionTypeProfile {
  id               String   @id @default(uuid())
  name             String   @unique
  slug             String   @unique
  tier             Int // 1–5; 5 = newest-gear pool, 1 = oldest
  upsellPropensity Int      @map("upsell_propensity") // 1–5; 1 = none, 5 = high
  priceSensitivity Int      @map("price_sensitivity") // 1–5; 1 = premium-tolerant, 5 = very sensitive
  salesMode        String   @map("sales_mode") // WHITE_GLOVE | HIGHER_TOUCH | SEMI_AUTO | LIGHT_TOUCH | FULL_AUTO
  sortOrder        Int      @default(0) @map("sort_order")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  jobs                   Job[]     @relation("JobProductionTypeProfile")
  mostCommonForCompanies Company[] @relation("CompanyMostCommonProductionTypeProfile")

  @@map("production_type_profiles")
}

// Customer-facing vehicle catalog tile lookup for the unified
// production-order shop (/order/supplies). Distinct from
// AssetCategory (the internal fleet-bucket grouping that
// schedules and assigns specific Assets) — VehicleCategory rows
// are the cards a client sees and picks from, with marketing copy
// and a "from $X/day" price hint. The internal Asset.categoryId
// linkage stays separate; a fleet ops handoff later maps a
// VehicleCategory pick to a specific AssetCategory pool.
//
// dailyRate is the customer-facing "from" rate; null = price-on-
// quote (don't render a price hint). photoUrl is admin-managed;
// null renders a graceful placeholder.
model VehicleCategory {
  id                  String                 @id @default(uuid())
  name                String                 @unique
  slug                String                 @unique
  subtitle            String?
  photoUrl            String?                @map("photo_url")
  // dailyRate is now a FALLBACK/override only. When assetCategoryId is set,
  // the public order form reads the price LIVE from the linked
  // AssetCategory.dailyRate (Fleet Pricing — one source of truth), so owned
  // vehicles never have a second place to maintain a rate. NULL here +
  // unlinked = "price on quote" (the sub-rental trailers).
  dailyRate           Decimal?               @map("daily_rate") @db.Decimal(10, 2)
  sortOrder           Int                    @default(0) @map("sort_order")
  active              Boolean                @default(true)
  // Structured public-site spec fields (all nullable — a missing spec is
  // simply omitted from the vehicle detail page). One set per vehicle; edited
  // in HQ (/admin/vehicle-catalog) and read LIVE by the public /vehicles pages.
  baseVehicle         String?                @map("base_vehicle") // e.g. "Ford Transit Cargo"
  model               String? // trim / model designation
  fuelType            String?                @map("fuel_type") // e.g. "Gas", "Diesel"
  lengthFt            Decimal?               @map("length_ft") @db.Decimal(6, 2) // overall length in feet
  heightClearance     String?                @map("height_clearance") // e.g. "9' 6\""
  interiorBoxHeight   String?                @map("interior_box_height") // e.g. "6' 2\""
  liftGateSpec        String?                @map("lift_gate_spec") // e.g. "3,000 lb hydraulic"
  tagline             String? // short hero line
  description         String? // longer marketing paragraph
  // Publish gate for the public site: a vehicle is client-visible only when
  // published=true AND it has at least one photo (VehicleCategoryPhoto or the
  // legacy photoUrl). Unpublished rows still appear in HQ admin views.
  published           Boolean                @default(false)
  // Public-site feature bullets, one per line (rendered as a list under specs).
  features            String?
  // Link to the operational Fleet Pricing category (owned vehicles). NULL for
  // sub-rentals that have no owned fleet inventory (Wardrobe Trailer, etc.).
  assetCategoryId     String?                @map("asset_category_id")
  assetCategory       AssetCategory?         @relation(fields: [assetCategoryId], references: [id], onDelete: SetNull)
  // Unified catalog FK (Aug 2026). Coexists with the AssetCategory FK
  // through the cutover — readers prefer this one, the legacy column
  // stays populated so nothing has to be dropped. See InventoryItem.
  catalogItemId       String?                @map("catalog_item_id")
  catalogItem         InventoryItem?         @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  photos              VehicleCategoryPhoto[]
  /// UNLISTED client page for a vehicle we do NOT publish in the catalog —
  /// same /unit/[token] surface the subcontracted units use, and deliberately
  /// indistinguishable from them: a client should not be able to tell which
  /// units we own and which we bring in. NULL = no page. Clearing revokes.
  ///
  /// Separate from `published`, which governs the LISTED catalog at
  /// /vehicles/[slug]. A vehicle can have an unlisted page without ever
  /// appearing in the public catalog — that is the whole point of it.
  publicToken         String?                @unique @map("public_token")
  publicTokenMintedAt DateTime?              @map("public_token_minted_at")

  @@index([assetCategoryId])
  @@index([catalogItemId])
  @@map("vehicle_categories")
}

// Gallery photos for a public vehicle page. url points at a PRIVATE blob
// (uploadPrivateImage) — always served back through a proxy route, never raw.
// Exactly one photo per vehicle should be isPrimary (enforced in the API, not
// the schema); ordering is sortOrder asc, createdAt asc.
model VehicleCategoryPhoto {
  id                String          @id @default(uuid())
  vehicleCategoryId String          @map("vehicle_category_id")
  vehicleCategory   VehicleCategory @relation(fields: [vehicleCategoryId], references: [id], onDelete: Cascade)
  url               String
  sortOrder         Int             @default(0) @map("sort_order")
  isPrimary         Boolean         @default(false) @map("is_primary")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([vehicleCategoryId])
  @@map("vehicle_category_photos")
}

// ── Spaces (Standing Sets / Stages / LED Wall) ─────────────────────
// Generic public-catalog model for bookable production spaces — launched
// with Standing Sets, reused by Stages + LED Wall later. Mirrors the
// VehicleCategory + VehicleCategoryPhoto pattern exactly: private-Blob
// photos served through the public catalog-image proxy, a `published`
// gate, and an `active` archive flag. Client-visible ONLY when active +
// published AND it has at least one photo (see PUBLIC_SPACE_VISIBLE_WHERE
// in lib/site/spaces.ts) — photo-less/unpublished rows 404 publicly.
enum SpaceType {
  STANDING_SET
  STAGE
  LED_WALL
}

model Space {
  id          String    @id @default(uuid())
  name        String
  type        SpaceType
  description String?   @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  // Public publish gate; `active` is the HQ archive flag (soft-delete —
  // archived rows drop out of the admin default view but are never hard-
  // deleted). Parallels VehicleCategory.published / .active.
  published   Boolean   @default(false)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  photos SpacePhoto[]

  // Names are unique WITHIN a type (a Stage and a Standing Set may share a
  // name); also the upsert key for the idempotent seed.
  @@unique([type, name])
  @@index([type, published])
  @@map("spaces")
}

// Gallery photos for a Space. url points at a PRIVATE blob
// (uploadPrivateImage) — served back ONLY through the catalog-image proxy
// (kind=space / space-photo), never the raw blob URL. Exactly one
// isPrimary per space (enforced in the API); order is sortOrder asc.
model SpacePhoto {
  id        String   @id @default(uuid())
  spaceId   String   @map("space_id")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([spaceId])
  @@map("space_photos")
}

model Company {
  id            String         @id @default(uuid())
  name          String
  website       String?
  industry      ProductionType @default(OTHER)
  tier          ClientTier     @default(NEW)
  totalSpend    Decimal        @default(0) @map("total_spend") @db.Decimal(12, 2)
  totalBookings Int            @default(0) @map("total_bookings")

  // Cached mode of productionTypeProfileId across this company's Jobs.
  // Recomputed by lib/companies/recomputeMostCommonProductionTypeProfile.
  // Nullable — companies with zero jobs (or no profile-tagged jobs) get
  // null. Not maintained by the booking flow yet; the recompute helper
  // is called manually from a backfill script in this commit. Wiring
  // into the Job create/update path lands in a later commit.
  mostCommonProductionTypeProfileId String? @map("most_common_production_type_profile_id")

  // Default agent
  defaultAgentId String? @map("default_agent_id")

  orders     Order[]
  activities Activity[]

  // Insurance (for claims — client's production insurance)
  insuranceCarrier   String?   @map("insurance_carrier")
  insurancePolicyNum String?   @map("insurance_policy_num")
  insuranceContact   String?   @map("insurance_contact")
  coiOnFile          Boolean   @default(false) @map("coi_on_file")
  coiExpiry          DateTime? @map("coi_expiry")
  coiDocumentUrl     String?   @map("coi_document_url")

  // Integration
  rentalworksCustomerId String? @map("rentalworks_customer_id")

  /// Last day this client actually had gear out, from the RentalWorks
  /// invoice mirror (billingEndDate, falling back to invoiceDate).
  /// Drives the "gone quiet" signals. Null until the rollup has run, or
  /// when the client has no RW invoices at all.
  lastRentalAt    DateTime? @map("last_rental_at")
  /// When totalSpend / totalBookings / lastRentalAt were last recomputed.
  /// These are a CACHE of RwInvoice, which is itself deleted and rebuilt
  /// on every RW sync — so a stale stamp means the numbers are stale, and
  /// the UI can say "as of" instead of implying they are live.
  spendRolledUpAt DateTime? @map("spend_rolled_up_at")

  billingEmail   String? @map("billing_email")
  billingAddress String? @map("billing_address") @db.Text
  notes          String? @db.Text

  // Discount / negotiation profile — institutional memory on this
  // client. discountTendency drives the "Negotiates" badge on the
  // CRM list (next pass — wired in the Needs-attention strip work).
  // typicalDiscountPct is what they usually angle for (15 = "15%").
  // discountNotes is free-text context (e.g. "always asks for free
  // delivery"). All three are agent-set, no derivation today.
  discountTendency   DiscountTendency @default(NONE) @map("discount_tendency")
  typicalDiscountPct Int?             @map("typical_discount_pct")
  discountNotes      String?          @map("discount_notes") @db.Text

  // ── CRH: Company-level paperwork (institutional memory) ────────────────
  // Annual MSA (Master Services Agreement). When `annualAgreementApprovedAt`
  // is set AND `annualAgreementExpiresAt` is still in the future, new jobs
  // for this company skip the per-job agreement signing flow.
  annualAgreementUrl           String?   @map("annual_agreement_url")
  annualAgreementEffectiveDate DateTime? @map("annual_agreement_effective_date")
  annualAgreementExpiresAt     DateTime? @map("annual_agreement_expires_at")
  annualAgreementSignedBy      String?   @map("annual_agreement_signed_by")
  annualAgreementApprovedBy    String?   @map("annual_agreement_approved_by")
  annualAgreementApprovedAt    DateTime? @map("annual_agreement_approved_at")

  // Annual COI (Certificate of Insurance). Parallel structure to the MSA;
  // additionally stores the coverage limits so the CRH job-creation flow
  // can validate per-job requirements against the annual policy.
  annualCoiUrl           String?   @map("annual_coi_url")
  annualCoiEffectiveDate DateTime? @map("annual_coi_effective_date")
  annualCoiExpiresAt     DateTime? @map("annual_coi_expires_at")
  annualCoiCoverageGL    Decimal?  @map("annual_coi_coverage_gl") @db.Decimal(14, 2)
  annualCoiCoverageAuto  Decimal?  @map("annual_coi_coverage_auto") @db.Decimal(14, 2)
  annualCoiApprovedBy    String?   @map("annual_coi_approved_by")
  annualCoiApprovedAt    DateTime? @map("annual_coi_approved_at")

  // Negotiated terms. When set, future Quote/Job flows render a banner and
  // use this PDF as the baseline (not the standard SirReel template). The
  // `summary` is the plain-English diff future-Wes reads to remember WHAT
  // was negotiated, not just THAT it was.
  negotiatedTermsUrl           String?   @map("negotiated_terms_url")
  negotiatedTermsSummary       String?   @map("negotiated_terms_summary") @db.Text
  negotiatedTermsNegotiatedAt  DateTime? @map("negotiated_terms_negotiated_at")
  negotiatedTermsApprovedBy    String?   @map("negotiated_terms_approved_by")
  negotiatedTermsApprovedAt    DateTime? @map("negotiated_terms_approved_at")
  negotiatedTermsActiveAsOf    DateTime? @map("negotiated_terms_active_as_of")
  negotiatedTermsReviewDueDate DateTime? @map("negotiated_terms_review_due_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  defaultAgent                    User?                  @relation("DefaultAgent", fields: [defaultAgentId], references: [id])
  mostCommonProductionTypeProfile ProductionTypeProfile? @relation("CompanyMostCommonProductionTypeProfile", fields: [mostCommonProductionTypeProfileId], references: [id])
  affiliations                    Affiliation[]
  bookings                        Booking[]
  drivers                         Driver[]
  insuranceClaims                 InsuranceClaim[]
  incidents                       Incident[]
  emailMessages                   EmailMessage[]
  jobs                            Job[]
  contractReviews                 ContractReview[]
  coiChecks                       CoiCheck[]
  agreements                      CompanyAgreement[]
  inquiries                       Inquiry[]
  inquiryCaptures                 InquiryCapture[]       @relation("CaptureCompany")
  outreachActivities              OutreachActivity[]     @relation("CompanyOutreach")
  negotiatedRates                 CompanyRate[]

  @@index([mostCommonProductionTypeProfileId])
  @@map("companies")
}

enum PersonRole {
  UPM
  PRODUCER
  LINE_PRODUCER
  PRODUCTION_MANAGER
  PRODUCTION_COORDINATOR
  PRODUCTION_SUPERVISOR
  TRANSPORTATION_COORDINATOR
  ART_COORDINATOR
  COORDINATOR
  OWNER

  // Added 2026-08-26. The capture pipeline was recognising these
  // titles as production-legitimate (PRODUCTION_TITLE_TOKENS covers
  // art dept, locations, grip, wardrobe) and then had nowhere to put
  // them, so every one landed in OTHER. Emmett Tekstra is the case
  // that surfaced it: his signature reads "Production Designer | Art
  // Director", the capture logged "production_title:art director" as
  // its legitimacy signal, and his role is OTHER because no bucket
  // existed. 250 contacts had a correctly-parsed title and OTHER.
  //
  // These four are the ones that actually rent vehicles from us —
  // art department builds and strikes sets, locations moves the unit,
  // accounting cuts the PO, and the PA is often who places the order.
  ART_DIRECTOR
  LOCATION_MANAGER
  PRODUCTION_ACCOUNTANT
  PRODUCTION_ASSISTANT

  // Added 2026-08-26 (Wes). Grip and electric are SEPARATE departments
  // — grip rigs and supports, electric lights — and they book their own
  // trucks. An earlier draft proposed one combined GRIP_ELECTRIC bucket;
  // Wes corrected it. Keep them apart.
  GRIP
  GAFFER_ELECTRIC

  OTHER
}

model Person {
  id        String     @id @default(uuid())
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  email     String     @unique
  phone     String?    @db.VarChar(30)
  mobile    String?    @db.VarChar(30)
  role      PersonRole @default(OTHER)
  tier      ClientTier @default(NEW)

  // Assigned agent at SirReel
  assignedAgentId String? @map("assigned_agent_id")

  // Lifetime stats (across ALL companies)
  totalSpend    Decimal        @default(0) @map("total_spend") @db.Decimal(12, 2)
  totalBookings Int            @default(0) @map("total_bookings")
  activities    Activity[]
  dispatchTasks DispatchTask[]
  lastBookingAt DateTime?      @map("last_booking_at")

  // "Works with" — e.g. UPM's regular coordinator
  worksWithId String? @map("works_with_id")

  // Integration
  planyoUserId Int? @map("planyo_user_id")

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  // Provenance — populated by the CRM auto-capture pipeline (see
  // src/lib/crm/captureFromEmail.ts). `source` is a free-form tag
  // ("email_capture", "manual", "intake_form", "import") so callers
  // can attribute records without a schema migration each time a new
  // origin shows up. `sourceMessageId` is the EmailMessage.id of the
  // mail that produced or last enriched this person — exposed on the
  // contact detail page as "Captured from <inbox>, <date>".
  source            String?   @map("source")
  sourceMessageId   String?   @map("source_message_id")
  // Verbatim signature title (e.g. "Sr. Production Coordinator —
  // FX Networks"). Kept alongside the mapped `role` enum because the
  // enum collapses dozens of real-world titles into ~10 buckets;
  // rawTitle preserves what the person actually called themselves.
  rawTitle          String?   @map("raw_title")
  // Most recent project / show / production name parsed off mail
  // from this contact. Single string, not a history — the review
  // widget surfaces "last seen on" as a sales prompt.
  lastKnownProject  String?   @map("last_known_project")
  // /admin/dedup "Not a dupe — shared office line" button stamps
  // this on every member of the cluster. The cluster API filters
  // out persons with this flag set so suppressed clusters drop
  // from the default queue. Nullable so a reviewer can un-suppress
  // by setting it back to null (no separate column needed).
  dedupSuppressedAt DateTime? @map("dedup_suppressed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  assignedAgent        User?                       @relation("PersonAgent", fields: [assignedAgentId], references: [id])
  worksWith            Person?                     @relation("WorksWith", fields: [worksWithId], references: [id])
  worksWithBack        Person[]                    @relation("WorksWith")
  affiliations         Affiliation[]
  bookings             Booking[]                   @relation("BookingContact")
  referredBookings     Booking[]                   @relation("BookingReferrer")
  user                 User?                       @relation("ContactUser")
  emailMessages        EmailMessage[]
  jobContacts          JobContact[]
  orderContacts        Order[]                     @relation("OrderJobContact")
  inquiries            Inquiry[]                   @relation("InquiryContact")
  portalAccesses       PortalAccess[]              @relation("PortalAccessContact")
  welcomeInvites       WelcomeInvite[]             @relation("WelcomeInvitePerson")
  personSessions       PersonSession[]
  inquiryCaptures      InquiryCapture[]            @relation("CaptureContact")
  outreachActivities   OutreachActivity[]          @relation("PersonOutreach")
  suppressions         EmailSuppression[]          @relation("PersonSuppressions")
  campaignRecipients   OutreachCampaignRecipient[] @relation("OutreachCampaignRecipient")
  touchPlanEnrollments TouchPlanEnrollment[]       @relation("TouchPlanEnrollee")
  emailAliases         PersonEmailAlias[]          @relation("PersonAliases")
  // Reverse side of PersonMerge — every merge where THIS person was the
  // survivor. Loser rows are deleted at merge time (their snapshot lives
  // on PersonMerge), so there's no loser-side back-relation to model.
  mergesAsSurvivor     PersonMerge[]               @relation("MergeSurvivor")

  @@map("people")
}

// Email aliases that route to a Person — populated when a duplicate
// Person row is merged in. The loser's email lands here so the next
// inbound capture / classifier lookup case-insensitively resolves to
// the survivor instead of re-minting the dupe. Every email→Person
// resolution path MUST consult this table; see
// src/lib/people/resolveByEmail.ts for the single shared helper.
//
// Values are stored lowercase (write-path responsibility). The
// @unique enforces global single-ownership: an alias can only point
// at one survivor at a time, no chains. If the survivor is itself
// merged later, the alias rows repoint to the new survivor.
model PersonEmailAlias {
  id        String   @id @default(uuid())
  personId  String   @map("person_id")
  email     String   @unique
  // The PersonMerge that minted this alias. Cascades the alias row
  // away if the merge is reversed.
  mergeId   String?  @map("merge_id")
  createdAt DateTime @default(now()) @map("created_at")

  person Person       @relation("PersonAliases", fields: [personId], references: [id], onDelete: Cascade)
  merge  PersonMerge? @relation("MergeAliases", fields: [mergeId], references: [id], onDelete: SetNull)

  @@index([personId])
  @@map("person_email_aliases")
}

// Audit + reversal source-of-truth for every Person merge. Loser
// row is HARD-DELETED at merge time — the snapshot here is the
// only way back. Reversal recreates the loser row from this JSON
// blob (original id preserved), walks repointLog in reverse, then
// stamps reversedAt. Reversal failures stay on the row (reversalErrors)
// for human triage.
//
// See src/lib/people/mergePersons.ts for the merge primitive and
// src/lib/people/reverseMerge.ts for the reverse primitive.
model PersonMerge {
  id                       String   @id @default(uuid())
  survivorId               String   @map("survivor_id")
  // Survivor's email at merge time, before the lowercase
  // normalization that the merge primitive runs as part of its
  // root-cause fix. Reversal restores this so the loser's pre-merge
  // email (which may differ ONLY in case from the survivor's
  // normalized form — the canary case) can come back without
  // colliding on Person.email's @unique.
  survivorEmailBeforeMerge String?  @map("survivor_email_before_merge")
  // Snapshot of the loser Person at merge time — full field set so
  // reversal is a JSON unpack, not a guess. Schema is loose
  // intentionally: if Person gains fields, older PersonMerge rows
  // remain valid (extra fields land as null on the restored loser).
  loserSnapshot            Json     @map("loser_snapshot")
  // Per-FK repoint log. Each entry: { table, op: 'repoint'|'delete'|'sum',
  //   loserId, survivorId, affectedIds: [...], details: {...} }.
  // Reversal walks this in reverse and inverts each op.
  repointLog               Json     @map("repoint_log")
  // PersonEmailAlias rows minted by this merge — deleted on reversal.
  // Indirect (FK on PersonEmailAlias.mergeId) so the list is
  // discoverable even if this array drifts; kept here for cheap audit.
  aliasIds                 String[] @map("alias_ids")

  mergedAt       DateTime  @default(now()) @map("merged_at")
  mergedById     String    @map("merged_by_id")
  reversedAt     DateTime? @map("reversed_at")
  reversedById   String?   @map("reversed_by_id")
  // Populated when reversal hits a conflict (e.g. survivor row was
  // edited downstream and the loser's old refs can't cleanly come
  // back). Reversal aborts; this row stays in place; human triage.
  reversalErrors Json?     @map("reversal_errors")

  survivor   Person             @relation("MergeSurvivor", fields: [survivorId], references: [id])
  mergedBy   User               @relation("PersonMergeOperator", fields: [mergedById], references: [id])
  reversedBy User?              @relation("PersonMergeReverser", fields: [reversedById], references: [id])
  aliases    PersonEmailAlias[] @relation("MergeAliases")

  @@index([survivorId])
  @@index([mergedAt])
  @@map("person_merges")
}

model Affiliation {
  id             String      @id @default(uuid())
  personId       String      @map("person_id")
  companyId      String      @map("company_id")
  productionName String?     @map("production_name") // "Stranger Things S5", "MI:7"
  roleOnShow     PersonRole? @map("role_on_show")
  startDate      DateTime?   @map("start_date") @db.Date
  endDate        DateTime?   @map("end_date") @db.Date
  isCurrent      Boolean     @default(true) @map("is_current")

  // Revenue from this person+company combo
  totalSpend    Decimal @default(0) @map("total_spend") @db.Decimal(12, 2)
  totalBookings Int     @default(0) @map("total_bookings")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  person  Person  @relation(fields: [personId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([personId, companyId, productionName])
  @@map("affiliations")
}

// ═══════════════════════════════════════
// 3. DRIVERS
// ═══════════════════════════════════════

enum DriverType {
  EXTERNAL // Production company's driver
  INTERNAL // SirReel driver (Wes, Hugo, etc.)
}

model Driver {
  id        String  @id @default(uuid())
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  phone     String? @db.VarChar(30)
  email     String?

  // License
  licenseNumber   String?   @map("license_number") @db.VarChar(30)
  licenseState    String?   @map("license_state") @db.VarChar(5)
  licenseExpiry   DateTime? @map("license_expiry")
  /// DEPRECATED — predates the front/back capture below and was never
  /// written by any code path (0 rows). Kept so the column isn't dropped;
  /// new writes go to licenseFrontUrl / licenseBackUrl.
  licensePhotoUrl String?   @map("license_photo_url")

  // ── License images. A driver's licence is sensitive PII, so both
  //    sides live in the PRIVATE blob store and are served only through
  //    the authed proxy at /api/drivers/[id]/license/[side]. The URL
  //    never reaches the browser. Same treatment as COI / WC.
  licenseFrontKey      String?   @map("license_front_key")
  licenseFrontUrl      String?   @map("license_front_url")
  licenseFrontMimeType String?   @map("license_front_mime_type")
  licenseBackKey       String?   @map("license_back_key")
  licenseBackUrl       String?   @map("license_back_url")
  licenseBackMimeType  String?   @map("license_back_mime_type")
  licenseUploadedAt    DateTime? @map("license_uploaded_at")

  // ── What the AI read off the card. This is EXTRACTION, not validation:
  //    it tells us what the licence says, never whether the state still
  //    considers it good. `licenseExpired` is the one real check we can
  //    make offline (expiry date vs today). A DMV/MVR status check would
  //    need a third-party service and is deliberately not attempted.
  licenseAiReview     Json?     @map("license_ai_review")
  licenseReviewAt     DateTime? @map("license_review_at")
  licenseExpired      Boolean?  @map("license_expired")
  dateOfBirth         DateTime? @map("date_of_birth")
  licenseClass        String?   @map("license_class") @db.VarChar(10)
  licenseEndorsements String?   @map("license_endorsements") @db.VarChar(60)
  licenseRestrictions String?   @map("license_restrictions") @db.VarChar(60)

  // Staff sign-off — a human looked at the images and accepted them.
  // Separate from the AI read, which is only ever an assist.
  licenseVerified     Boolean   @default(false) @map("license_verified")
  licenseVerifiedAt   DateTime? @map("license_verified_at")
  licenseVerifiedById String?   @map("license_verified_by_id")

  // ── Driver portal access. One live token per driver: staff mint it and
  //    either email it to the driver or open it on a tablet at pickup.
  //    Nullable so a driver record can exist without portal access.
  portalToken     String?   @unique @map("portal_token")
  portalTokenAt   DateTime? @map("portal_token_at")
  portalExpiresAt DateTime? @map("portal_expires_at")

  type      DriverType @default(EXTERNAL)
  companyId String?    @map("company_id") // Which production sent them (external drivers)

  // Tracking
  totalCheckouts  Int     @default(0) @map("total_checkouts")
  damageIncidents Int     @default(0) @map("damage_incidents")
  flagged         Boolean @default(false) // Auto-set if damage history
  flagReason      String? @map("flag_reason") @db.Text

  notes    String? @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company           Company?           @relation(fields: [companyId], references: [id])
  checkoutRecords   CheckoutRecord[]
  dispatchTasks     DispatchTask[]     @relation("TaskDriver")
  driverAssignments DriverAssignment[]

  @@map("drivers")
}

enum DriverAssignmentStatus {
  INVITED // email sent, driver hasn't opened it
  VIEWED // driver opened their job page
  READY // licence on file, checked, unexpired
  PICKED_UP // handed over (CheckoutRecord carries the authoritative record)
  CANCELLED
}

/// A named driver for ONE vehicle on ONE job — the spine of the driver
/// workflow. Distinct from CheckoutRecord.driverId, which records who
/// physically took the keys; this is the plan, created days earlier by
/// whoever knows: the production client from their job page, the sales
/// agent, or warehouse/fleet from the board.
///
/// Carries its own token because the driver's page is per-ASSIGNMENT
/// (this vehicle, this job, these instructions) while a licence is
/// per-PERSON — so licence uploads from this page still write to Driver.
model DriverAssignment {
  id                  String @id @default(uuid())
  driverId            String @map("driver_id")
  bookingAssignmentId String @map("booking_assignment_id")

  /// No-login credential for the driver's job page. Separate from
  /// Driver.portalToken (licence-only, per-person) so revoking one
  /// job's link doesn't lock a driver out of every other job.
  token     String    @unique
  expiresAt DateTime? @map("expires_at")

  status DriverAssignmentStatus @default(INVITED)

  /// Who named this driver. `invitedByUserId` is null when the
  /// production client did it from their own portal job page —
  /// they have no HQ User — so `invitedBySource` is the honest record.
  invitedByUserId  String?   @map("invited_by_user_id")
  invitedBySource  String    @default("STAFF") @map("invited_by_source") // STAFF | CLIENT
  invitedAt        DateTime  @default(now()) @map("invited_at")
  emailSentTo      String?   @map("email_sent_to")
  firstViewedAt    DateTime? @map("first_viewed_at")
  /// First time this driver was shown the real gate code. Stamped so a
  /// leaked code can be traced to who had it and from when — the price
  /// of putting a shared secret on a page.
  gateCodeViewedAt DateTime? @map("gate_code_viewed_at")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  driver            Driver            @relation(fields: [driverId], references: [id])
  bookingAssignment BookingAssignment @relation(fields: [bookingAssignmentId], references: [id])
  invitedByUser     User?             @relation("DriverAssignmentInvitedBy", fields: [invitedByUserId], references: [id])

  /// One live row per driver per vehicle-assignment; re-inviting the same
  /// driver updates rather than piling up duplicates.
  @@unique([driverId, bookingAssignmentId])
  @@index([bookingAssignmentId])
  @@map("driver_assignments")
}

// ═══════════════════════════════════════
// 4. BOOKINGS & RESERVATIONS
// ═══════════════════════════════════════

enum BookingStatus {
  REQUEST
  AI_REVIEW
  PENDING_APPROVAL
  CONFIRMED
  ACTIVE
  RETURNED
  CANCELLED
  ARCHIVED
}

enum BookingPriority {
  URGENT
  HIGH
  STANDARD
  LOW
}

enum BookingSource {
  WEBSITE
  PHONE
  EMAIL
  AGENT_DIRECT
  AI_AUTO
  /// Rows created by the Planyo orphan backfill (one-off, May 2026,
  /// run from the timeline-booking-truth branch before it merged).
  /// Listed here so main's schema reflects the live DB; not used by
  /// new code paths. 74 rows currently carry this source.
  PLANYO_BACKFILL
}

enum UnionStatus {
  UNION
  NON_UNION
  UNKNOWN
}

model Booking {
  id             String          @id @default(uuid())
  bookingNumber  String          @unique @map("booking_number") // SR-2026-0042
  /// NULLABLE since 2026-08-24 (call-in intake): a client can phone in a
  /// reservation before the production company is known. A Booking with
  /// companyId = NULL is INCOMPLETE — the gantt shows a warning triangle
  /// until an agent fills it in (see src/lib/scheduling/infoGaps.ts).
  /// Everything created through a normal quote/order flow still carries one.
  companyId      String?         @map("company_id")
  personId       String          @map("person_id") // Who called / requested (coordinator or UPM)
  referredById   String?         @map("referred_by_id") // The UPM, if a coordinator called on their behalf
  agentId        String          @map("agent_id")
  /// Optional FK back to the SirReel HQ-native Job (billing-side). New
  /// holds created via +Hold pick or create a Job and stamp this. NULL
  /// on legacy Bookings (Planyo-imported, pre-Job-linkage) — Order is
  /// still the only required path from Booking → Job. The native
  /// scheduling engine does NOT read this column.
  jobId          String?         @map("job_id")
  productionName String?         @map("production_name") // "Stranger Things S5" — legacy free-text; new holds skip it
  /// EMPTY STRING = "job not named yet" (call-in intake). Kept NOT NULL so
  /// the ~460 existing read sites stay string-typed; use
  /// src/lib/scheduling/infoGaps.ts rather than testing for '' by hand.
  jobName        String          @map("job_name")
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  status         BookingStatus   @default(REQUEST)
  priority       BookingPriority @default(STANDARD)
  totalPrice     Decimal?        @map("total_price") @db.Decimal(12, 2)
  depositAmount  Decimal?        @map("deposit_amount") @db.Decimal(10, 2)
  depositPaid    Boolean         @default(false) @map("deposit_paid")

  // Compliance
  rentalAgreement Boolean     @default(false) @map("rental_agreement")
  coiReceived     Boolean     @default(false) @map("coi_received")
  unionStatus     UnionStatus @default(UNKNOWN) @map("union_status")

  // Delivery
  deliveryAddress String? @map("delivery_address") @db.Text
  deliveryTime    String? @map("delivery_time")
  pickupAddress   String? @map("pickup_address") @db.Text
  pickupTime      String? @map("pickup_time")

  // Notes
  notes      String? @db.Text
  adminNotes String? @map("admin_notes") @db.Text

  // AI
  aiAnalysisId String? @map("ai_analysis_id")

  // Integration
  rentalworksOrderId   String? @map("rentalworks_order_id")
  rentalworksInvoiceId String? @map("rentalworks_invoice_id")
  invoiceStatus        String? @map("invoice_status") // not_created, draft, sent, paid, overdue

  /// Planyo cart_id this Booking was imported from. Cart-level
  /// idempotency anchor for scheduling-planyo-migration.ts re-runs:
  /// when Planyo gains a new reservation on an already-imported cart,
  /// the script looks up the existing Booking via this @unique field
  /// and APPENDS new BookingItems instead of creating a duplicate
  /// Booking. NULL on Bookings created via the +Hold flow.
  planyoCartId String? @unique @map("planyo_cart_id")

  /// Call-in intake: the agent expects a billable Order to be attached to
  /// this reservation later. A declared expectation, not a derived fact —
  /// it keeps the incomplete-info triangle up until an Order exists.
  expectsOrder Boolean @default(false) @map("expects_order")

  source BookingSource @default(PHONE)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  confirmedAt DateTime? @map("confirmed_at")
  returnedAt  DateTime? @map("returned_at")
  /// Soft-archive marker set by POST /api/bookings/[id]/archive. The
  /// /bookings page filters `archivedAt IS NULL` by default; restoring
  /// clears the field. Related rows (PaperworkRequest, SignedAgreement
  /// via Orders, PortalAccess, etc.) are left untouched — archive is a
  /// visibility-only flag, not a cascade. A separate ADMIN-only purge
  /// path will handle hard deletion later.
  archivedAt  DateTime? @map("archived_at")

  // Relations
  /// onDelete: Restrict is PINNED. Making companyId optional flipped
  /// Prisma's implicit default to SetNull, which would silently orphan real
  /// bookings when a company row is deleted (the CRM duplicate-merge path
  /// deletes companies without re-pointing bookings). Restrict keeps the
  /// pre-2026-08-24 guarantee: you cannot delete a company that still has
  /// bookings.
  company           Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  person            Person              @relation("BookingContact", fields: [personId], references: [id])
  referredBy        Person?             @relation("BookingReferrer", fields: [referredById], references: [id])
  agent             User                @relation("BookingAgent", fields: [agentId], references: [id])
  job               Job?                @relation(fields: [jobId], references: [id])
  items             BookingItem[]
  dispatchTasks     DispatchTask[]
  insuranceClaims   InsuranceClaim[]
  aiDecisions       AiDecision[]
  paperworkRequests PaperworkRequest[]
  orders            Order[]
  activities        Activity[]
  reservations      Reservation[]
  detailReplies     ClientDetailReply[] @relation("BookingDetailReplies")

  @@index([jobId])
  @@map("bookings")
}

// Planyo-mirror rows from the timeline-booking-truth backfill. Kept in
// schema so main matches the live DB; not consumed by current code
// paths. The native scheduling engine does NOT use this model — it
// reads from BookingItem + BookingAssignment.
model Reservation {
  id        String   @id @default(uuid())
  bookingId String?  @map("booking_id")
  booking   Booking? @relation(fields: [bookingId], references: [id])

  unitName String  @map("unit_name")
  category String?

  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")

  status ReservationStatus @default(HOLD)
  source ReservationSource @default(PLANYO)

  planyoReservationId String? @unique @map("planyo_reservation_id")
  planyoCartId        String? @map("planyo_cart_id")
  planyoCompany       String? @map("planyo_company")
  planyoJobName       String? @map("planyo_job_name")
  planyoAgent         String? @map("planyo_agent")
  planyoCustomerName  String? @map("planyo_customer_name")
  planyoCustomerEmail String? @map("planyo_customer_email")
  planyoCustomerPhone String? @map("planyo_customer_phone")
  notes               String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([bookingId])
  @@index([unitName])
  @@index([startTime, endTime])
  @@index([planyoCartId])
  @@map("reservations")
}

enum ReservationStatus {
  CONFIRMED
  HOLD
  CANCELLED
}

enum ReservationSource {
  PLANYO
  NATIVE
}

enum BookingItemStatus {
  REQUESTED
  ASSIGNED
  SUBSTITUTED
  UNFULFILLED
}

model BookingItem {
  id         String            @id @default(uuid())
  bookingId  String            @map("booking_id")
  categoryId String            @map("category_id")
  quantity   Int
  dailyRate  Decimal           @map("daily_rate") @db.Decimal(10, 2)
  lineTotal  Decimal?          @map("line_total") @db.Decimal(10, 2)
  status     BookingItemStatus @default(REQUESTED)
  /// Hold rank — 1 = primary, ≥2 = backup ("2nd hold" / "3rd hold").
  /// Backups can overlap a category at capacity; they do NOT consume
  /// availableToHold. Manual promotion only — when a primary
  /// releases, an agent surfaces the next-rank backup explicitly.
  /// Replaces the Planyo "X - 2ND HOLD" placeholder workaround.
  holdRank   Int               @default(1) @map("hold_rank")
  notes      String?           @db.Text

  // Relations
  booking       Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  category      AssetCategory          @relation(fields: [categoryId], references: [id])
  // Unified catalog FK (Aug 2026). Coexists with the AssetCategory FK
  // through the cutover — readers prefer this one, the legacy column
  // stays populated so nothing has to be dropped. See InventoryItem.
  catalogItemId String?                @map("catalog_item_id")
  catalogItem   InventoryItem?         @relation(fields: [catalogItemId], references: [id])
  assignments   BookingAssignment[]
  stageAreas    BookingItemStageArea[]

  @@index([catalogItemId])
  @@map("booking_items")
}

enum AssignmentStatus {
  ASSIGNED
  CHECKED_OUT
  RETURNED
  SWAPPED
}

model BookingAssignment {
  id            String           @id @default(uuid())
  bookingItemId String           @map("booking_item_id")
  assetId       String           @map("asset_id")
  startDate     DateTime         @map("start_date") @db.Date
  endDate       DateTime         @map("end_date") @db.Date
  status        AssignmentStatus @default(ASSIGNED)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  bookingItem     BookingItem      @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  asset           Asset            @relation(fields: [assetId], references: [id])
  checkoutRecords CheckoutRecord[]
  inspections     Inspection[]     @relation("AssignmentInspections")

  driverAssignments DriverAssignment[]

  @@map("booking_assignments")
}

// ═══════════════════════════════════════
// 5. CHECKOUT RECORDS (Fleet process)
// ═══════════════════════════════════════

model CheckoutRecord {
  id                  String  @id @default(uuid())
  bookingAssignmentId String  @map("booking_assignment_id")
  assetId             String  @map("asset_id")
  // Nullable (Sprint 2A): a pre-rental inspection creates the record
  // before the client's driver is known; the driver attaches at
  // physical pickup. Relaxed with the table empty — approved 2026-07-02.
  driverId            String? @map("driver_id")
  checkedOutBy        String  @map("checked_out_by") // Fleet team member

  // Checkout
  checkoutTime         DateTime @map("checkout_time")
  mileageOut           Int?     @map("mileage_out")
  fuelOut              String?  @map("fuel_out") // full, 3/4, 1/2, 1/4, empty
  checkoutInspectionId String?  @map("checkout_inspection_id")

  // Return
  returnTime         DateTime? @map("return_time")
  mileageIn          Int?      @map("mileage_in")
  fuelIn             String?   @map("fuel_in")
  returnInspectionId String?   @map("return_inspection_id")
  returnedTo         String?   @map("returned_to") // Fleet team member who received

  // Verification
  licenseVerified   Boolean @default(false) @map("license_verified")
  newDamageOnReturn Boolean @default(false) @map("new_damage_on_return")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  bookingAssignment BookingAssignment @relation(fields: [bookingAssignmentId], references: [id])
  asset             Asset             @relation(fields: [assetId], references: [id])
  driver            Driver?           @relation(fields: [driverId], references: [id])
  checkedOutByUser  User              @relation("CheckedOutBy", fields: [checkedOutBy], references: [id])

  @@map("checkout_records")
}

// ═══════════════════════════════════════
// 6. MAINTENANCE & SERVICE
// ═══════════════════════════════════════

enum MaintenanceType {
  REPAIR
  DOT
  SERVICE
  BODYWORK
  SMOG
  DAMAGE_REPAIR
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model MaintenanceRecord {
  id            String            @id @default(uuid())
