node_modules/
.next/
# Alternate build output — `next build --distDir .next-verify`, used so a
# build can't wipe a teammate's running dev server's .next (that collision
# happened for real 2026-08-24, and it is unrecoverable without restarting
# their server). Ignored so the artifacts can never be staged.
#
# Expect tsconfig.json to come back DIRTY after such a build: next build
# rewrites it and injects an `include` entry for whatever distDir was used
# (node_modules/next/dist/lib/typescript/writeConfigurationDefaults.js —
# `${distDir}/types/**/*.ts`). Nobody hand-edited it; leave it unstaged
# rather than hunting for whoever "forgot" to revert it.
.next-verify/
.env
.env.local
*.tsbuildinfo
next-env.d.ts
.env*.local
*.bak.*
